{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/schemas/workforce/case-situation-model-v1.schema.json",
  "title": "CaseSituationModelV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "situation_id", "generation", "case_id", "current_case_instance_sha256", "case_work_grant_sha256", "context_bundle_sha256", "source_observation_hashes", "role_instance_sha256", "ownership_state_sha256", "lease_sha256", "observed_facts", "trusted_system_facts", "approved_policy_facts", "approved_procedure_facts", "authenticated_assertions", "model_inferences", "entities", "relations", "completed_subgoals", "open_subgoals", "unresolved_requirement_ids", "satisfied_requirement_ids", "unknowns", "conflicts", "blocker_ids", "policy_relevant_state", "allowed_semantic_target_ids", "allowed_capability_ids", "forbidden_capability_ids", "confidence_summary", "progress", "provider_provenance", "evidence_ids", "previous_situation_sha256", "situation_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "situation_id": {"$ref": "#/$defs/id"}, "generation": {"type": "integer", "minimum": 1}, "case_id": {"$ref": "#/$defs/id"},
    "current_case_instance_sha256": {"$ref": "#/$defs/hash"}, "case_work_grant_sha256": {"$ref": "#/$defs/hash"}, "context_bundle_sha256": {"$ref": "#/$defs/hash"},
    "source_observation_hashes": {"$ref": "#/$defs/hashes"}, "role_instance_sha256": {"$ref": "#/$defs/hash"}, "ownership_state_sha256": {"$ref": "#/$defs/hash"}, "lease_sha256": {"$ref": "#/$defs/hash"},
    "observed_facts": {"$ref": "#/$defs/facts"}, "trusted_system_facts": {"$ref": "#/$defs/facts"}, "approved_policy_facts": {"$ref": "#/$defs/facts"}, "approved_procedure_facts": {"$ref": "#/$defs/facts"}, "authenticated_assertions": {"$ref": "#/$defs/facts"}, "model_inferences": {"$ref": "#/$defs/facts"},
    "entities": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/entity"}}, "relations": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/relation"}},
    "completed_subgoals": {"$ref": "#/$defs/subgoals"}, "open_subgoals": {"$ref": "#/$defs/subgoals"},
    "unresolved_requirement_ids": {"$ref": "#/$defs/ids"}, "satisfied_requirement_ids": {"$ref": "#/$defs/ids"},
    "unknowns": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/unknown"}}, "conflicts": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/conflict"}},
    "blocker_ids": {"$ref": "#/$defs/ids"}, "policy_relevant_state": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/policy"}},
    "allowed_semantic_target_ids": {"$ref": "#/$defs/ids"}, "allowed_capability_ids": {"$ref": "#/$defs/ids"}, "forbidden_capability_ids": {"$ref": "#/$defs/ids"},
    "confidence_summary": {"$ref": "#/$defs/confidence"}, "progress": {"$ref": "#/$defs/progress"}, "provider_provenance": {"oneOf": [{"$ref": "#/$defs/provenance"}, {"type": "null"}]},
    "evidence_ids": {"$ref": "#/$defs/ids"}, "previous_situation_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "situation_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"}, "text": {"type": "string", "minLength": 1, "maxLength": 2048}, "hash": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
    "ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "hashes": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}}, "confidence": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1000000}, {"const": "not_applicable"}]},
    "facts": {"type": "array", "maxItems": 256, "items": {"$ref": "situation-fact-v1.schema.json"}},
    "entity": {"type": "object", "additionalProperties": false, "required": ["entity_id", "entity_kind", "safe_label", "evidence_refs"], "properties": {"entity_id": {"$ref": "#/$defs/id"}, "entity_kind": {"$ref": "#/$defs/id"}, "safe_label": {"$ref": "#/$defs/text"}, "evidence_refs": {"$ref": "#/$defs/ids"}}},
    "relation": {"type": "object", "additionalProperties": false, "required": ["relation_id", "subject_entity_id", "predicate", "object_entity_id", "evidence_refs"], "properties": {"relation_id": {"$ref": "#/$defs/id"}, "subject_entity_id": {"$ref": "#/$defs/id"}, "predicate": {"$ref": "#/$defs/id"}, "object_entity_id": {"$ref": "#/$defs/id"}, "evidence_refs": {"$ref": "#/$defs/ids"}}},
    "subgoals": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["subgoal_id", "semantic_intent", "status", "requirement_ids", "evidence_refs"], "properties": {"subgoal_id": {"$ref": "#/$defs/id"}, "semantic_intent": {"$ref": "#/$defs/id"}, "status": {"enum": ["open", "completed", "blocked"]}, "requirement_ids": {"$ref": "#/$defs/ids"}, "evidence_refs": {"$ref": "#/$defs/ids"}}}},
    "unknown": {"type": "object", "additionalProperties": false, "required": ["unknown_id", "requirement_id", "kind", "safe_summary", "evidence_refs"], "properties": {"unknown_id": {"$ref": "#/$defs/id"}, "requirement_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["missing", "unavailable", "redacted", "stale", "ambiguous", "conflicting", "unsupported", "authority_unknown", "policy_unknown"]}, "safe_summary": {"$ref": "#/$defs/text"}, "evidence_refs": {"$ref": "#/$defs/ids"}}},
    "conflict": {"type": "object", "additionalProperties": false, "required": ["conflict_id", "contradiction_group_id", "fact_ids", "safe_summary", "evidence_refs"], "properties": {"conflict_id": {"$ref": "#/$defs/id"}, "contradiction_group_id": {"$ref": "#/$defs/id"}, "fact_ids": {"type": "array", "minItems": 2, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "safe_summary": {"$ref": "#/$defs/text"}, "evidence_refs": {"$ref": "#/$defs/ids"}}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["policy_fact_id", "capability_id", "state", "trusted_policy_sha256", "evidence_refs"], "properties": {"policy_fact_id": {"$ref": "#/$defs/id"}, "capability_id": {"$ref": "#/$defs/id"}, "state": {"enum": ["allowed_by_trusted_policy", "denied_by_trusted_policy", "confirmation_required", "unknown"]}, "trusted_policy_sha256": {"$ref": "#/$defs/hash"}, "evidence_refs": {"$ref": "#/$defs/ids"}}},
    "progress": {"type": "object", "additionalProperties": false, "required": ["total_requirements", "satisfied_requirements", "unresolved_requirements", "progress_millionths"], "properties": {"total_requirements": {"type": "integer", "minimum": 1, "maximum": 128}, "satisfied_requirements": {"type": "integer", "minimum": 0, "maximum": 128}, "unresolved_requirements": {"type": "integer", "minimum": 0, "maximum": 128}, "progress_millionths": {"type": "integer", "minimum": 0, "maximum": 1000000}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["provider_id", "provider_descriptor_sha256", "invocation_sha256", "result_sha256"], "properties": {"provider_id": {"$ref": "#/$defs/id"}, "provider_descriptor_sha256": {"$ref": "#/$defs/hash"}, "invocation_sha256": {"$ref": "#/$defs/hash"}, "result_sha256": {"$ref": "#/$defs/hash"}}}
  }
}

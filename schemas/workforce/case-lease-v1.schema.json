{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://d2i.invalid/schemas/workforce/case-lease-v1.schema.json", "title": "CaseLeaseV1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "claim_id", "lease_id", "case_id", "queue_entry_sha256", "scheduler_decision_sha256", "current_ownership_state_sha256", "role_instance_id", "role_instance_sha256", "role_contract_sha256", "delegation_sha256", "claim_sequence", "lease_epoch", "claimed_at_unix_seconds", "expires_at_unix_seconds", "renewal_count", "lease_status", "previous_lease_sha256", "queue_ledger_chain_head", "case_ledger_chain_head", "role_ledger_chain_head", "evidence_ids", "lease_sha256"],
  "properties": { "schema_version": { "const": 1 }, "claim_id": { "$ref": "#/$defs/id" }, "lease_id": { "$ref": "#/$defs/id" }, "case_id": { "$ref": "#/$defs/id" }, "queue_entry_sha256": { "$ref": "#/$defs/hash" }, "scheduler_decision_sha256": { "$ref": "#/$defs/hash" }, "current_ownership_state_sha256": { "$ref": "#/$defs/hash" }, "role_instance_id": { "$ref": "#/$defs/id" }, "role_instance_sha256": { "$ref": "#/$defs/hash" }, "role_contract_sha256": { "$ref": "#/$defs/hash" }, "delegation_sha256": { "$ref": "#/$defs/hash" }, "claim_sequence": { "type": "integer", "minimum": 1 }, "lease_epoch": { "type": "integer", "minimum": 1 }, "claimed_at_unix_seconds": { "type": "integer", "minimum": 1 }, "expires_at_unix_seconds": { "type": "integer", "minimum": 1 }, "renewal_count": { "type": "integer", "minimum": 0, "maximum": 64 }, "lease_status": { "enum": ["active", "renewed", "released", "expired", "revoked", "consumed"] }, "previous_lease_sha256": { "$ref": "#/$defs/nullable_hash" }, "queue_ledger_chain_head": { "$ref": "#/$defs/hash" }, "case_ledger_chain_head": { "$ref": "#/$defs/hash" }, "role_ledger_chain_head": { "$ref": "#/$defs/hash" }, "evidence_ids": { "$ref": "#/$defs/evidence" }, "lease_sha256": { "$ref": "#/$defs/hash" } },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!\\*$)(?!all$)(?!any$)[A-Za-z0-9._:/-]+$" }, "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "nullable_hash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] }, "evidence": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } }
}

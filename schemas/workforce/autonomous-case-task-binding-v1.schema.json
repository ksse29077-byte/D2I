{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/workforce/autonomous-case-task-binding-v1.schema.json",
    "title":  "AutonomousCaseTaskBindingV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "autonomy_case_admission_sha256",
                     "case_task_request_sha256",
                     "role_task_admission_sha256",
                     "current_case_instance_sha256",
                     "active_lease_sha256",
                     "work_grant_sha256",
                     "goal_spec_sha256",
                     "situation_model_sha256",
                     "planner_cycle_sha256",
                     "next_step_decision_sha256",
                     "policy_input_binding_sha256",
                     "evidence_ids",
                     "binding_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "autonomy_case_admission_sha256":  {
                                                              "type":  "string",
                                                              "pattern":  "^sha256:[0-9a-f]{64}$",
                                                              "maxLength":  71
                                                          },
                       "case_task_request_sha256":  {
                                                        "type":  "string",
                                                        "pattern":  "^sha256:[0-9a-f]{64}$",
                                                        "maxLength":  71
                                                    },
                       "role_task_admission_sha256":  {
                                                          "type":  "string",
                                                          "pattern":  "^sha256:[0-9a-f]{64}$",
                                                          "maxLength":  71
                                                      },
                       "current_case_instance_sha256":  {
                                                            "type":  "string",
                                                            "pattern":  "^sha256:[0-9a-f]{64}$",
                                                            "maxLength":  71
                                                        },
                       "active_lease_sha256":  {
                                                   "type":  "string",
                                                   "pattern":  "^sha256:[0-9a-f]{64}$",
                                                   "maxLength":  71
                                               },
                       "work_grant_sha256":  {
                                                 "type":  "string",
                                                 "pattern":  "^sha256:[0-9a-f]{64}$",
                                                 "maxLength":  71
                                             },
                       "goal_spec_sha256":  {
                                                "type":  "string",
                                                "pattern":  "^sha256:[0-9a-f]{64}$",
                                                "maxLength":  71
                                            },
                       "situation_model_sha256":  {
                                                      "type":  "string",
                                                      "pattern":  "^sha256:[0-9a-f]{64}$",
                                                      "maxLength":  71
                                                  },
                       "planner_cycle_sha256":  {
                                                    "type":  "string",
                                                    "pattern":  "^sha256:[0-9a-f]{64}$",
                                                    "maxLength":  71
                                                },
                       "next_step_decision_sha256":  {
                                                         "type":  "string",
                                                         "pattern":  "^sha256:[0-9a-f]{64}$",
                                                         "maxLength":  71
                                                     },
                       "policy_input_binding_sha256":  {
                                                           "type":  "string",
                                                           "pattern":  "^sha256:[0-9a-f]{64}$",
                                                           "maxLength":  71
                                                       },
                       "evidence_ids":  {
                                            "type":  "array",
                                            "maxItems":  512,
                                            "uniqueItems":  true,
                                            "items":  {
                                                          "type":  "string",
                                                          "minLength":  1,
                                                          "maxLength":  512,
                                                          "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                      }
                                        },
                       "binding_sha256":  {
                                              "type":  "string",
                                              "pattern":  "^sha256:[0-9a-f]{64}$",
                                              "maxLength":  71
                                          }
                   }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.invalid/schemas/workforce/work-queue-snapshot-v1.schema.json",
  "title": "WorkQueueSnapshotV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "queue_id", "queue_policy_sha256", "snapshot_sequence", "entries", "terminal_removed_count", "case_ledger_chain_head", "role_ledger_chain_head", "queue_ledger_chain_head", "evidence_ids", "snapshot_sha256"],
  "properties": {
    "schema_version": { "const": 1 },
    "snapshot_id": { "$ref": "#/$defs/id" },
    "queue_id": { "$ref": "#/$defs/id" },
    "queue_policy_sha256": { "$ref": "#/$defs/hash" },
    "snapshot_sequence": { "type": "integer", "minimum": 1 },
    "entries": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/entry" } },
    "terminal_removed_count": { "type": "integer", "minimum": 0, "maximum": 128 },
    "case_ledger_chain_head": { "$ref": "#/$defs/hash" },
    "role_ledger_chain_head": { "$ref": "#/$defs/hash" },
    "queue_ledger_chain_head": { "$ref": "#/$defs/hash" },
    "evidence_ids": { "$ref": "#/$defs/evidence" },
    "snapshot_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!\\*$)(?!all$)(?!any$)[A-Za-z0-9._:/-]+$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nullable_hash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] },
    "evidence": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "queue_entry_id", "queue_id", "enqueue_sequence", "case_id", "case_contract_sha256", "current_case_instance_sha256", "case_lifecycle_generation", "current_lifecycle_status", "current_ownership_state_sha256", "current_role_instance_id", "work_item_sha256", "organization_id", "work_class_id", "responsibility_id", "priority_class", "received_at_unix_seconds", "opened_at_unix_seconds", "acknowledge_due_at_unix_seconds", "begin_due_at_unix_seconds", "resolve_due_at_unix_seconds", "escalation_due_at_unix_seconds", "active_block_sha256", "active_lease_sha256", "queue_lane", "last_reconciled_case_ledger_head", "last_reconciled_role_ledger_head", "intake_receipt_sha256", "evidence_ids", "entry_sha256"],
      "properties": {
        "schema_version": { "const": 1 },
        "queue_entry_id": { "$ref": "#/$defs/id" },
        "queue_id": { "$ref": "#/$defs/id" },
        "enqueue_sequence": { "type": "integer", "minimum": 1 },
        "case_id": { "$ref": "#/$defs/id" },
        "case_contract_sha256": { "$ref": "#/$defs/hash" },
        "current_case_instance_sha256": { "$ref": "#/$defs/hash" },
        "case_lifecycle_generation": { "type": "integer", "minimum": 1 },
        "current_lifecycle_status": { "enum": ["opened", "active", "awaiting_clarification", "blocked", "awaiting_verification", "escalation_pending", "terminal"] },
        "current_ownership_state_sha256": { "$ref": "#/$defs/hash" },
        "current_role_instance_id": { "$ref": "#/$defs/id" },
        "work_item_sha256": { "$ref": "#/$defs/hash" },
        "organization_id": { "$ref": "#/$defs/id" },
        "work_class_id": { "$ref": "#/$defs/id" },
        "responsibility_id": { "$ref": "#/$defs/id" },
        "priority_class": { "enum": ["routine", "normal", "elevated", "urgent"] },
        "received_at_unix_seconds": { "type": "integer", "minimum": 1 },
        "opened_at_unix_seconds": { "type": "integer", "minimum": 1 },
        "acknowledge_due_at_unix_seconds": { "type": "integer", "minimum": 1 },
        "begin_due_at_unix_seconds": { "type": "integer", "minimum": 1 },
        "resolve_due_at_unix_seconds": { "type": "integer", "minimum": 1 },
        "escalation_due_at_unix_seconds": { "type": "integer", "minimum": 1 },
        "active_block_sha256": { "$ref": "#/$defs/nullable_hash" },
        "active_lease_sha256": { "$ref": "#/$defs/nullable_hash" },
        "queue_lane": { "enum": ["ready", "waiting_clarification", "blocked", "awaiting_verification", "owner_unavailable", "leased", "escalation_attention", "terminal_removed"] },
        "last_reconciled_case_ledger_head": { "$ref": "#/$defs/hash" },
        "last_reconciled_role_ledger_head": { "$ref": "#/$defs/hash" },
        "intake_receipt_sha256": { "$ref": "#/$defs/hash" },
        "evidence_ids": { "$ref": "#/$defs/evidence" },
        "entry_sha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaseSlaRuntimeStateV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sla_state_id",
    "case_id",
    "case_contract_sha256",
    "current_case_instance_sha256",
    "role_contract_sha256",
    "sla_binding_sha256",
    "sla_profile_id",
    "priority_class",
    "received_at_unix_seconds",
    "baseline_acknowledge_due_at_unix_seconds",
    "baseline_begin_due_at_unix_seconds",
    "baseline_resolve_due_at_unix_seconds",
    "baseline_escalation_due_at_unix_seconds",
    "acknowledged_at_unix_seconds",
    "begun_at_unix_seconds",
    "resolved_at_unix_seconds",
    "escalated_at_unix_seconds",
    "approved_pause_intervals",
    "total_approved_pause_seconds",
    "effective_acknowledge_due_at_unix_seconds",
    "effective_begin_due_at_unix_seconds",
    "effective_resolve_due_at_unix_seconds",
    "effective_escalation_due_at_unix_seconds",
    "acknowledge_status",
    "begin_status",
    "resolve_status",
    "escalation_status",
    "overall_sla_status",
    "risk_band",
    "current_clock_context_sha256",
    "case_ledger_head_sha256",
    "queue_ledger_head_sha256",
    "planner_ledger_head_sha256",
    "evidence_ids",
    "previous_state_sha256",
    "state_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sla_state_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "case_contract_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "current_case_instance_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "role_contract_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sla_binding_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sla_profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "priority_class": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "received_at_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "baseline_acknowledge_due_at_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "baseline_begin_due_at_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "baseline_resolve_due_at_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "baseline_escalation_due_at_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "acknowledged_at_unix_seconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "begun_at_unix_seconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "resolved_at_unix_seconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "escalated_at_unix_seconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "approved_pause_intervals": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/SlaPauseIntervalV1"
      }
    },
    "total_approved_pause_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "effective_acknowledge_due_at_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "effective_begin_due_at_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "effective_resolve_due_at_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "effective_escalation_due_at_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "acknowledge_status": {
      "type": "string",
      "enum": [
        "pending",
        "paused",
        "met_on_time",
        "met_late",
        "breached_unmet",
        "not_applicable"
      ]
    },
    "begin_status": {
      "type": "string",
      "enum": [
        "pending",
        "paused",
        "met_on_time",
        "met_late",
        "breached_unmet",
        "not_applicable"
      ]
    },
    "resolve_status": {
      "type": "string",
      "enum": [
        "pending",
        "paused",
        "met_on_time",
        "met_late",
        "breached_unmet",
        "not_applicable"
      ]
    },
    "escalation_status": {
      "type": "string",
      "enum": [
        "pending",
        "paused",
        "met_on_time",
        "met_late",
        "breached_unmet",
        "not_applicable"
      ]
    },
    "overall_sla_status": {
      "type": "string",
      "enum": [
        "pending",
        "at_risk",
        "paused",
        "compliant",
        "breached",
        "terminal_noncompliant",
        "insufficient_evidence"
      ]
    },
    "risk_band": {
      "type": "string",
      "enum": [
        "healthy",
        "warning",
        "critical",
        "breached"
      ]
    },
    "current_clock_context_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "case_ledger_head_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "queue_ledger_head_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "planner_ledger_head_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_ids": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "previous_state_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "SlaPauseIntervalV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "pause_id",
        "case_id",
        "sla_binding_sha256",
        "pause_condition_id",
        "source_event_class_id",
        "case_block_class_id",
        "clarification_reason_code",
        "started_at_unix_seconds",
        "ended_at_unix_seconds",
        "source_case_state_sha256",
        "source_block_or_clarification_sha256",
        "approval_sha256",
        "evidence_ids",
        "previous_pause_sha256",
        "pause_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "pause_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
        },
        "sla_binding_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "pause_condition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
        },
        "source_event_class_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
        },
        "case_block_class_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
            },
            { "type": "null" }
          ]
        },
        "clarification_reason_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
            },
            { "type": "null" }
          ]
        },
        "started_at_unix_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "ended_at_unix_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "source_case_state_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_block_or_clarification_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "approval_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
          }
        },
        "previous_pause_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "pause_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}

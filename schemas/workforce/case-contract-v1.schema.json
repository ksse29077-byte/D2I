{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/schemas/workforce/case-contract-v1.schema.json",
  "title": "D2I CaseContractV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "case_generation", "organization_id",
    "source_work_item_id", "source_work_item_sha256", "work_item_admission_sha256",
    "role_instance_id", "role_contract_sha256", "delegation_sha256",
    "ownership_binding", "work_class_id", "responsibility_id", "priority_class",
    "risk_class", "subject_refs", "outcome_requirements", "evidence_requirements",
    "sla_binding", "allowed_application_pack_refs", "allowed_integration_ids",
    "allowed_capability_ids", "prohibited_capability_ids", "allowed_semantic_target_ids",
    "maximum_task_attempts", "maximum_recovery_cycles_per_task", "clarification_allowed",
    "automatic_recovery_allowed", "mandatory_escalation_reason_codes",
    "reporting_obligation_ids", "retention_class_id", "opened_at_unix_seconds",
    "evidence_ids", "contract_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "case_id": { "$ref": "#/$defs/id" },
    "case_generation": { "const": 1 },
    "organization_id": { "$ref": "#/$defs/id" },
    "source_work_item_id": { "$ref": "#/$defs/id" },
    "source_work_item_sha256": { "$ref": "#/$defs/sha256" },
    "work_item_admission_sha256": { "$ref": "#/$defs/sha256" },
    "role_instance_id": { "$ref": "#/$defs/id" },
    "role_contract_sha256": { "$ref": "#/$defs/sha256" },
    "delegation_sha256": { "$ref": "#/$defs/sha256" },
    "ownership_binding": { "$ref": "#/$defs/ownership" },
    "work_class_id": { "$ref": "#/$defs/id" },
    "responsibility_id": { "$ref": "#/$defs/id" },
    "priority_class": { "enum": ["routine", "normal", "elevated", "urgent"] },
    "risk_class": { "enum": ["read_only", "reversible", "business_state_change", "high_criticality"] },
    "subject_refs": { "$ref": "#/$defs/nonEmptyIds" },
    "outcome_requirements": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/successRequirement" } },
    "evidence_requirements": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/evidenceRequirement" } },
    "sla_binding": { "$ref": "#/$defs/slaBinding" },
    "allowed_application_pack_refs": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/applicationPackRef" } },
    "allowed_integration_ids": { "$ref": "#/$defs/nonEmptyIds" },
    "allowed_capability_ids": { "$ref": "#/$defs/nonEmptyIds" },
    "prohibited_capability_ids": { "$ref": "#/$defs/ids" },
    "allowed_semantic_target_ids": { "$ref": "#/$defs/nonEmptyIds" },
    "maximum_task_attempts": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "maximum_recovery_cycles_per_task": { "type": "integer", "minimum": 0, "maximum": 128 },
    "clarification_allowed": { "type": "boolean" },
    "automatic_recovery_allowed": { "type": "boolean" },
    "mandatory_escalation_reason_codes": { "$ref": "#/$defs/ids" },
    "reporting_obligation_ids": { "$ref": "#/$defs/ids" },
    "retention_class_id": { "$ref": "#/$defs/id" },
    "opened_at_unix_seconds": { "type": "integer", "minimum": 1 },
    "evidence_ids": { "$ref": "#/$defs/nonEmptyIds" },
    "contract_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ids": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "nonEmptyIds": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "nullableId": { "type": ["string", "null"], "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$" },
    "nullableSha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "applicationPackRef": {
      "type": "object", "additionalProperties": false,
      "required": ["application_pack_id", "application_pack_sha256"],
      "properties": {
        "application_pack_id": { "$ref": "#/$defs/id" },
        "application_pack_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "ownership": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "ownership_id", "case_id", "role_instance_id",
        "role_contract_id", "role_version", "role_contract_sha256", "delegation_sha256",
        "organization_id", "responsibility_id", "work_class_id", "ownership_generation",
        "bound_at_unix_seconds", "expires_at_unix_seconds", "evidence_ids", "ownership_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "ownership_id": { "$ref": "#/$defs/id" },
        "case_id": { "$ref": "#/$defs/id" },
        "role_instance_id": { "$ref": "#/$defs/id" },
        "role_contract_id": { "$ref": "#/$defs/id" },
        "role_version": { "$ref": "#/$defs/id" },
        "role_contract_sha256": { "$ref": "#/$defs/sha256" },
        "delegation_sha256": { "$ref": "#/$defs/sha256" },
        "organization_id": { "$ref": "#/$defs/id" },
        "responsibility_id": { "$ref": "#/$defs/id" },
        "work_class_id": { "$ref": "#/$defs/id" },
        "ownership_generation": { "const": 1 },
        "bound_at_unix_seconds": { "type": "integer", "minimum": 1 },
        "expires_at_unix_seconds": { "type": "integer", "minimum": 1 },
        "evidence_ids": { "$ref": "#/$defs/nonEmptyIds" },
        "ownership_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "successRequirement": {
      "type": "object", "additionalProperties": false,
      "required": [
        "requirement_id", "outcome_class_id", "verification_kind", "required",
        "minimum_satisfied_count", "referenced_requirement_ids", "target_state_ref",
        "comparison_op", "expected_value_hash", "trusted_evidence_class_ids",
        "authoritative_source_class_ids", "evidence_ids", "requirement_sha256"
      ],
      "properties": {
        "requirement_id": { "$ref": "#/$defs/id" },
        "outcome_class_id": { "$ref": "#/$defs/id" },
        "verification_kind": { "enum": ["kernel_goal_complete", "kernel_action_passed", "trusted_state_criterion", "trusted_evidence_present", "aggregate_all", "aggregate_any"] },
        "required": { "type": "boolean" },
        "minimum_satisfied_count": { "type": "integer", "minimum": 1, "maximum": 128 },
        "referenced_requirement_ids": { "$ref": "#/$defs/ids" },
        "target_state_ref": { "$ref": "#/$defs/nullableId" },
        "comparison_op": { "type": ["string", "null"], "enum": ["equals", "not_equals", "contains", "exists", "greater_or_equal", "less_or_equal", null] },
        "expected_value_hash": { "$ref": "#/$defs/nullableSha256" },
        "trusted_evidence_class_ids": { "$ref": "#/$defs/ids" },
        "authoritative_source_class_ids": { "$ref": "#/$defs/ids" },
        "evidence_ids": { "$ref": "#/$defs/ids" },
        "requirement_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceRequirement": {
      "type": "object", "additionalProperties": false,
      "required": [
        "evidence_requirement_id", "evidence_class_id", "minimum_count",
        "accepted_producer_kinds", "required_trust_floor", "required_artifact_type_ids",
        "maximum_staleness_seconds", "retention_class_id", "redaction_required",
        "required", "requirement_sha256"
      ],
      "properties": {
        "evidence_requirement_id": { "$ref": "#/$defs/id" },
        "evidence_class_id": { "$ref": "#/$defs/id" },
        "minimum_count": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "accepted_producer_kinds": { "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": { "enum": ["kernel_task_run", "verified_action", "final_goal_verification", "trusted_observation", "signed_external_evidence", "authenticated_human_decision", "escalation_record"] } },
        "required_trust_floor": { "enum": ["untrusted_reference", "authenticated", "trusted", "protected", "signed"] },
        "required_artifact_type_ids": { "$ref": "#/$defs/nonEmptyIds" },
        "maximum_staleness_seconds": { "type": ["integer", "null"], "minimum": 1 },
        "retention_class_id": { "$ref": "#/$defs/id" },
        "redaction_required": { "type": "boolean" },
        "required": { "type": "boolean" },
        "requirement_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "slaBinding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "sla_binding_id", "case_id", "role_sla_profile_id",
        "priority_class", "received_at_unix_seconds", "acknowledge_due_at_unix_seconds",
        "begin_due_at_unix_seconds", "resolve_due_at_unix_seconds",
        "escalation_due_at_unix_seconds", "pause_condition_ids", "evidence_ids", "binding_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "sla_binding_id": { "$ref": "#/$defs/id" },
        "case_id": { "$ref": "#/$defs/id" },
        "role_sla_profile_id": { "$ref": "#/$defs/id" },
        "priority_class": { "enum": ["routine", "normal", "elevated", "urgent"] },
        "received_at_unix_seconds": { "type": "integer", "minimum": 1 },
        "acknowledge_due_at_unix_seconds": { "type": "integer", "minimum": 1 },
        "begin_due_at_unix_seconds": { "type": "integer", "minimum": 1 },
        "resolve_due_at_unix_seconds": { "type": "integer", "minimum": 1 },
        "escalation_due_at_unix_seconds": { "type": "integer", "minimum": 1 },
        "pause_condition_ids": { "$ref": "#/$defs/ids" },
        "evidence_ids": { "$ref": "#/$defs/nonEmptyIds" },
        "binding_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}

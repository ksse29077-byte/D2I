{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/schemas/workforce/work-radar-checkpoint-v1.schema.json",
  "title": "RadarCheckpointV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registration_id", "registration_sha256", "organization_id", "source_system_id", "last_durable_sequence", "last_durable_cursor", "last_event_id", "last_signal_sha256", "previous_checkpoint_sha256", "cycle_sequence", "intake_ledger_chain_head", "evidence_ids", "checkpoint_sha256"],
  "properties": {
    "schema_version": { "const": 1 },
    "registration_id": { "$ref": "#/$defs/id" }, "registration_sha256": { "$ref": "#/$defs/hash" },
    "organization_id": { "$ref": "#/$defs/id" }, "source_system_id": { "$ref": "#/$defs/id" },
    "last_durable_sequence": { "type": "integer", "minimum": 0 },
    "last_durable_cursor": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "last_event_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "last_signal_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] },
    "previous_checkpoint_sha256": { "$ref": "#/$defs/hash" },
    "cycle_sequence": { "type": "integer", "minimum": 0 },
    "intake_ledger_chain_head": { "$ref": "#/$defs/hash" },
    "evidence_ids": { "$ref": "#/$defs/idsRequired" }, "checkpoint_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "idsRequired": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  }
}

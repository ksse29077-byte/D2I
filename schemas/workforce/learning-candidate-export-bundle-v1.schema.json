{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.example/schemas/workforce/learning-candidate-export-bundle-v1.schema.json",
    "title":  "LearningCandidateExportBundleV1",
    "type":  "object",
    "required":  [
                     "schema_version",
                     "bundle_id",
                     "organization_id",
                     "namespace_sha256",
                     "candidate_hashes",
                     "candidate_object_hashes",
                     "evaluation_schema_ids",
                     "production_package_hashes_before",
                     "production_package_hashes_after",
                     "production_mutation_count",
                     "exported_at_unix_ms",
                     "bundle_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "bundle_id":  {
                                         "type":  "string",
                                         "minLength":  1,
                                         "maxLength":  4096
                                     },
                       "organization_id":  {
                                               "type":  "string",
                                               "minLength":  1,
                                               "maxLength":  4096
                                           },
                       "namespace_sha256":  {
                                                "type":  "string",
                                                "pattern":  "^sha256:[0-9a-f]{64}$",
                                                "maxLength":  71
                                            },
                       "candidate_hashes":  {
                                                "type":  "array",
                                                "maxItems":  512,
                                                "uniqueItems":  true,
                                                "items":  {
                                                              "type":  "string",
                                                              "pattern":  "^sha256:[0-9a-f]{64}$",
                                                              "maxLength":  71
                                                          }
                                            },
                       "candidate_object_hashes":  {
                                                       "type":  "array",
                                                       "maxItems":  512,
                                                       "uniqueItems":  true,
                                                       "items":  {
                                                                     "type":  "string",
                                                                     "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                     "maxLength":  71
                                                                 }
                                                   },
                       "evaluation_schema_ids":  {
                                                     "type":  "array",
                                                     "maxItems":  512,
                                                     "uniqueItems":  true,
                                                     "items":  {
                                                                   "type":  "string",
                                                                   "minLength":  1,
                                                                   "maxLength":  256
                                                               }
                                                 },
                       "production_package_hashes_before":  {
                                                                "type":  "array",
                                                                "maxItems":  512,
                                                                "uniqueItems":  true,
                                                                "items":  {
                                                                              "type":  "string",
                                                                              "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                              "maxLength":  71
                                                                          }
                                                            },
                       "production_package_hashes_after":  {
                                                               "type":  "array",
                                                               "maxItems":  512,
                                                               "uniqueItems":  true,
                                                               "items":  {
                                                                             "type":  "string",
                                                                             "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                             "maxLength":  71
                                                                         }
                                                           },
                       "production_mutation_count":  {
                                                         "type":  "integer",
                                                         "minimum":  0,
                                                         "maximum":  9007199254740991
                                                     },
                       "exported_at_unix_ms":  {
                                                   "type":  "integer",
                                                   "minimum":  0,
                                                   "maximum":  9007199254740991
                                               },
                       "bundle_sha256":  {
                                             "type":  "string",
                                             "pattern":  "^sha256:[0-9a-f]{64}$",
                                             "maxLength":  71
                                         }
                   },
    "additionalProperties":  false
}

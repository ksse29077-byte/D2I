{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.example/schemas/workforce/case-learning-record-v1.schema.json",
    "title":  "CaseLearningRecordV1",
    "type":  "object",
    "required":  [
                     "schema_version",
                     "record_id",
                     "organization_id",
                     "namespace_sha256",
                     "source_episode_hashes",
                     "candidate_sha256",
                     "disposition",
                     "reason_codes",
                     "recorded_at_unix_ms",
                     "previous_record_sha256",
                     "record_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "record_id":  {
                                         "type":  "string",
                                         "minLength":  1,
                                         "maxLength":  4096
                                     },
                       "organization_id":  {
                                               "type":  "string",
                                               "minLength":  1,
                                               "maxLength":  4096
                                           },
                       "namespace_sha256":  {
                                                "type":  "string",
                                                "pattern":  "^sha256:[0-9a-f]{64}$",
                                                "maxLength":  71
                                            },
                       "source_episode_hashes":  {
                                                     "type":  "array",
                                                     "maxItems":  512,
                                                     "uniqueItems":  true,
                                                     "items":  {
                                                                   "type":  "string",
                                                                   "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                   "maxLength":  71
                                                               }
                                                 },
                       "candidate_sha256":  {
                                                "anyOf":  [
                                                              {
                                                                  "type":  "string",
                                                                  "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                  "maxLength":  71
                                                              },
                                                              {
                                                                  "type":  "null"
                                                              }
                                                          ]
                                            },
                       "disposition":  {
                                           "enum":  [
                                                        "quarantined",
                                                        "rejected",
                                                        "exported_for_offline_evaluation",
                                                        "evaluation_passed",
                                                        "evaluation_failed",
                                                        "approved_for_offline_build",
                                                        "archived"
                                                    ]
                                       },
                       "reason_codes":  {
                                            "type":  "array",
                                            "maxItems":  512,
                                            "uniqueItems":  true,
                                            "items":  {
                                                          "type":  "string",
                                                          "minLength":  1,
                                                          "maxLength":  256
                                                      }
                                        },
                       "recorded_at_unix_ms":  {
                                                   "type":  "integer",
                                                   "minimum":  0,
                                                   "maximum":  9007199254740991
                                               },
                       "previous_record_sha256":  {
                                                      "type":  "string",
                                                      "pattern":  "^sha256:[0-9a-f]{64}$",
                                                      "maxLength":  71
                                                  },
                       "record_sha256":  {
                                             "type":  "string",
                                             "pattern":  "^sha256:[0-9a-f]{64}$",
                                             "maxLength":  71
                                         }
                   },
    "additionalProperties":  false
}

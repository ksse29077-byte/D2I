{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://d2i.invalid/schemas/workforce/work-scheduler-decision-v1.schema.json", "title": "WorkSchedulerDecisionV1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "decision_id", "tick_sha256", "queue_snapshot_sha256", "outcome", "selected_case_id", "selected_queue_entry_sha256", "selected_ownership_state_sha256", "selected_role_instance_id", "selected_lease_duration_seconds", "ordered_reason_codes", "examined_entry_count", "eligible_entry_count", "waiting_entry_count", "attention_entry_count", "terminal_removed_count", "logical_operations", "evidence_ids", "decision_sha256"],
  "properties": { "schema_version": { "const": 1 }, "decision_id": { "$ref": "#/$defs/id" }, "tick_sha256": { "$ref": "#/$defs/hash" }, "queue_snapshot_sha256": { "$ref": "#/$defs/hash" }, "outcome": { "enum": ["case_selected", "no_eligible_case", "owner_reassignment_required", "escalation_attention_required", "outside_operating_window", "queue_empty", "resource_limit", "integrity_failure"] }, "selected_case_id": { "$ref": "#/$defs/nullable_id" }, "selected_queue_entry_sha256": { "$ref": "#/$defs/nullable_hash" }, "selected_ownership_state_sha256": { "$ref": "#/$defs/nullable_hash" }, "selected_role_instance_id": { "$ref": "#/$defs/nullable_id" }, "selected_lease_duration_seconds": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1, "maximum": 86400 }] }, "ordered_reason_codes": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "string", "maxLength": 64 } }, "examined_entry_count": { "type": "integer", "minimum": 0, "maximum": 128 }, "eligible_entry_count": { "type": "integer", "minimum": 0, "maximum": 128 }, "waiting_entry_count": { "type": "integer", "minimum": 0, "maximum": 128 }, "attention_entry_count": { "type": "integer", "minimum": 0, "maximum": 128 }, "terminal_removed_count": { "type": "integer", "minimum": 0, "maximum": 128 }, "logical_operations": { "type": "integer", "minimum": 1 }, "evidence_ids": { "$ref": "#/$defs/evidence" }, "decision_sha256": { "$ref": "#/$defs/hash" } },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!\\*$)(?!all$)(?!any$)[A-Za-z0-9._:/-]+$" }, "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "nullable_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] }, "nullable_hash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] }, "evidence": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://d2i.local/schemas/workforce/planner-cycle-record-v1.schema.json", "title": "PlannerCycleRecordV1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "cycle_id", "sequence", "case_id", "stage", "status", "provider_invocation_sha256", "provider_result_sha256", "goal_spec_sha256", "situation_sha256", "adaptive_plan_sha256", "next_step_decision_sha256", "kernel_run_sha256", "verification_result_sha256", "reason_codes", "recorded_at_unix_seconds", "previous_record_sha256", "protected_audit_terminal_sha256", "evidence_ids", "record_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "cycle_id": {"$ref": "#/$defs/id"}, "sequence": {"type": "integer", "minimum": 1}, "case_id": {"$ref": "#/$defs/id"}, "stage": {"enum": ["provider_invoked", "provider_result_validated", "situation_persisted", "plan_persisted", "step_admitted", "kernel_bound", "action_attempted", "verification_persisted", "situation_updated", "terminal_evaluated"]}, "status": {"enum": ["in_progress", "verified", "clarification", "escalation", "failed", "recovered"]}, "provider_invocation_sha256": {"$ref": "#/$defs/nullable_hash"}, "provider_result_sha256": {"$ref": "#/$defs/nullable_hash"}, "goal_spec_sha256": {"$ref": "#/$defs/nullable_hash"}, "situation_sha256": {"$ref": "#/$defs/nullable_hash"}, "adaptive_plan_sha256": {"$ref": "#/$defs/nullable_hash"}, "next_step_decision_sha256": {"$ref": "#/$defs/nullable_hash"}, "kernel_run_sha256": {"$ref": "#/$defs/nullable_hash"}, "verification_result_sha256": {"$ref": "#/$defs/nullable_hash"}, "reason_codes": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "recorded_at_unix_seconds": {"type": "integer", "minimum": 1}, "previous_record_sha256": {"$ref": "#/$defs/hash"}, "protected_audit_terminal_sha256": {"$ref": "#/$defs/hash"}, "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "record_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"}, "hash": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}, "nullable_hash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}}
}

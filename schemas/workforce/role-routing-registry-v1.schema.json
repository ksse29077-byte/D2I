{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoleRoutingRegistryV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "registry_version",
    "organization_id",
    "role_contract_sha256",
    "allowed_routing_class_ids",
    "route_bindings",
    "report_class_allowlist",
    "escalation_severity_allowlist",
    "valid_from_unix_seconds",
    "valid_to_unix_seconds",
    "evidence_ids",
    "registry_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "registry_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "role_contract_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "allowed_routing_class_ids": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "route_bindings": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/InternalRouteBindingV1"
      }
    },
    "report_class_allowlist": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "escalation_severity_allowlist": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "enum": [
          "routine",
          "elevated",
          "high",
          "unsafe"
        ]
      }
    },
    "valid_from_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "valid_to_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_ids": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "registry_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "InternalRouteBindingV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routing_class_id",
        "internal_inbox_id"
      ],
      "properties": {
        "routing_class_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
        },
        "internal_inbox_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.example/schemas/workforce/episode-query-receipt-v1.schema.json",
  "title": "EpisodeQueryReceiptV1",
  "type": "object",
  "required": [
    "schema_version",
    "query_sha256",
    "result_sha256",
    "namespace_sha256",
    "reuse_policy",
    "returned_episode_count",
    "returned_summary_count",
    "denied",
    "completed_at_unix_ms",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "query_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71 },
    "result_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71 },
    "namespace_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71 },
    "reuse_policy": { "enum": ["forbidden", "hash_reference_only", "approved_summary_only"] },
    "returned_episode_count": { "type": "integer", "minimum": 0, "maximum": 512 },
    "returned_summary_count": { "type": "integer", "minimum": 0, "maximum": 512 },
    "denied": { "type": "boolean" },
    "completed_at_unix_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "receipt_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71 }
  },
  "additionalProperties": false
}

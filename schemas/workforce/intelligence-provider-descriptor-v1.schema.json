{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/schemas/workforce/intelligence-provider-descriptor-v1.schema.json",
  "title": "IntelligenceProviderDescriptorV1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "provider_id", "provider_version", "provider_kind", "model_id", "model_revision", "model_artifact_sha256", "tokenizer_sha256", "inference_runtime_id", "inference_runtime_version", "inference_runtime_sha256", "prompt_template_sha256", "supported_locales", "supported_input_schema_ids", "supported_output_schema_ids", "maximum_context_bytes", "maximum_context_tokens", "maximum_output_bytes", "maximum_output_tokens", "determinism_class", "seed_supported", "sampling_policy", "network_policy", "resource_profile", "timeout_milliseconds", "valid_from_unix_seconds", "expires_at_unix_seconds", "license_id", "commercial_use_allowed", "evidence_ids", "descriptor_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "provider_id": {"$ref": "#/$defs/id"}, "provider_version": {"$ref": "#/$defs/id"}, "provider_kind": {"enum": ["deterministic_reference", "recorded_model_result", "local_model_process", "runtime_adapter"]},
    "model_id": {"$ref": "#/$defs/id"}, "model_revision": {"$ref": "#/$defs/id"}, "model_artifact_sha256": {"$ref": "#/$defs/hash"}, "tokenizer_sha256": {"$ref": "#/$defs/hash"}, "inference_runtime_id": {"$ref": "#/$defs/id"}, "inference_runtime_version": {"$ref": "#/$defs/id"}, "inference_runtime_sha256": {"$ref": "#/$defs/hash"}, "prompt_template_sha256": {"$ref": "#/$defs/hash"},
    "supported_locales": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9-]{2,35}$"}}, "supported_input_schema_ids": {"$ref": "#/$defs/ids"}, "supported_output_schema_ids": {"$ref": "#/$defs/ids"},
    "maximum_context_bytes": {"type": "integer", "minimum": 1, "maximum": 131072}, "maximum_context_tokens": {"type": "integer", "minimum": 1, "maximum": 32768}, "maximum_output_bytes": {"type": "integer", "minimum": 1, "maximum": 65536}, "maximum_output_tokens": {"type": "integer", "minimum": 1, "maximum": 4096},
    "determinism_class": {"enum": ["exact_replay", "seeded_best_effort", "non_deterministic"]}, "seed_supported": {"type": "boolean"}, "sampling_policy": {"$ref": "#/$defs/sampling"}, "network_policy": {"enum": ["denied", "loopback_only"]}, "resource_profile": {"$ref": "#/$defs/resources"},
    "timeout_milliseconds": {"type": "integer", "minimum": 1, "maximum": 120000}, "valid_from_unix_seconds": {"type": "integer", "minimum": 1}, "expires_at_unix_seconds": {"type": "integer", "minimum": 2}, "license_id": {"$ref": "#/$defs/id"}, "commercial_use_allowed": {"const": true}, "evidence_ids": {"$ref": "#/$defs/ids"}, "descriptor_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"}, "hash": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}, "ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "sampling": {"type": "object", "additionalProperties": false, "required": ["temperature_millionths", "top_p_millionths", "top_k", "minimum_probability_millionths", "retry_count"], "properties": {"temperature_millionths": {"type": "integer", "minimum": 0, "maximum": 2000000}, "top_p_millionths": {"type": "integer", "minimum": 1, "maximum": 1000000}, "top_k": {"type": "integer", "minimum": 0, "maximum": 1000}, "minimum_probability_millionths": {"type": "integer", "minimum": 0, "maximum": 1000000}, "retry_count": {"const": 0}}},
    "resources": {"type": "object", "additionalProperties": false, "required": ["cpu_architecture", "backend_id", "minimum_memory_bytes", "maximum_memory_bytes", "gpu_required", "maximum_concurrent_invocations"], "properties": {"cpu_architecture": {"$ref": "#/$defs/id"}, "backend_id": {"$ref": "#/$defs/id"}, "minimum_memory_bytes": {"type": "integer", "minimum": 268435456, "maximum": 8589934592}, "maximum_memory_bytes": {"type": "integer", "minimum": 268435456, "maximum": 8589934592}, "gpu_required": {"type": "boolean"}, "maximum_concurrent_invocations": {"const": 1}}}
  }
}

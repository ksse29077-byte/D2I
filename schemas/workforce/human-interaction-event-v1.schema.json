{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HumanInteractionEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "interaction_id",
    "case_id",
    "interaction_kind",
    "authenticated_actor_class",
    "started_at_unix_seconds",
    "ended_at_unix_seconds",
    "source_artifact_sha256",
    "evidence_ids",
    "interaction_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "interaction_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "interaction_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "authenticated_actor_class": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "started_at_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "ended_at_unix_seconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "source_artifact_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_ids": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "interaction_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

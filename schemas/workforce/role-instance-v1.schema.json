{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/schemas/workforce/role-instance-v1.schema.json",
  "title": "D2I Role Instance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "role_instance_id", "role_contract_id", "role_version",
    "contract_sha256", "approval_sha256", "delegation_sha256", "organization_id",
    "current_status", "instance_generation", "activated_at_unix_seconds",
    "suspended_at_unix_seconds", "expires_at_unix_seconds", "policy_set_sha256",
    "authority_projection_template_sha256", "recovery_profile_template_sha256",
    "application_pack_ids", "integration_ids", "capability_ids", "ledger_id",
    "ledger_chain_head", "evidence_ids", "instance_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "role_instance_id": { "$ref": "#/$defs/id" },
    "role_contract_id": { "$ref": "#/$defs/id" },
    "role_version": { "$ref": "#/$defs/id" },
    "contract_sha256": { "$ref": "#/$defs/hash" },
    "approval_sha256": { "$ref": "#/$defs/hash" },
    "delegation_sha256": { "$ref": "#/$defs/hash" },
    "organization_id": { "$ref": "#/$defs/id" },
    "current_status": { "enum": ["provisioned", "active", "suspended", "revoked", "expired"] },
    "instance_generation": { "type": "integer", "minimum": 1 },
    "activated_at_unix_seconds": { "type": ["integer", "null"], "minimum": 1 },
    "suspended_at_unix_seconds": { "type": ["integer", "null"], "minimum": 1 },
    "expires_at_unix_seconds": { "type": "integer", "minimum": 1 },
    "policy_set_sha256": { "$ref": "#/$defs/hash" },
    "authority_projection_template_sha256": { "$ref": "#/$defs/hash" },
    "recovery_profile_template_sha256": { "$ref": "#/$defs/hash" },
    "application_pack_ids": { "$ref": "#/$defs/nonempty_id_set" },
    "integration_ids": { "$ref": "#/$defs/nonempty_id_set" },
    "capability_ids": { "$ref": "#/$defs/nonempty_id_set" },
    "ledger_id": { "$ref": "#/$defs/id" },
    "ledger_chain_head": { "$ref": "#/$defs/hash" },
    "evidence_ids": { "$ref": "#/$defs/id_set" },
    "instance_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$", "not": { "enum": ["*", "all", "any"] } },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "id_set": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "nonempty_id_set": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportingTriggerEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trigger_id",
    "trigger_kind",
    "role_contract_sha256",
    "obligation_id",
    "source_case_id",
    "source_artifact_hashes",
    "triggered_at_unix_seconds",
    "evidence_ids",
    "trigger_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "trigger_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "trigger_kind": {
      "type": "string",
      "enum": [
        "on_task_complete",
        "on_task_failed",
        "on_escalation",
        "on_role_suspend",
        "periodic",
        "sla_breach"
      ]
    },
    "role_contract_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "obligation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "source_case_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_artifact_hashes": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "triggered_at_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_ids": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "trigger_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://d2i.invalid/schemas/workforce/case-work-grant-v1.schema.json", "title": "CaseWorkGrantV1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "grant_id", "case_id", "current_case_instance_sha256", "case_contract_sha256", "ownership_state_sha256", "lease_sha256", "selected_role_instance_id", "unresolved_requirement_ids", "allowed_application_pack_ids", "allowed_integration_ids", "allowed_capability_ids", "semantic_target_ids", "valid_from_unix_seconds", "expires_at_unix_seconds", "one_time_grant_sequence", "evidence_ids", "grant_sha256"],
  "properties": { "schema_version": { "const": 1 }, "grant_id": { "$ref": "#/$defs/id" }, "case_id": { "$ref": "#/$defs/id" }, "current_case_instance_sha256": { "$ref": "#/$defs/hash" }, "case_contract_sha256": { "$ref": "#/$defs/hash" }, "ownership_state_sha256": { "$ref": "#/$defs/hash" }, "lease_sha256": { "$ref": "#/$defs/hash" }, "selected_role_instance_id": { "$ref": "#/$defs/id" }, "unresolved_requirement_ids": { "$ref": "#/$defs/optional_ids" }, "allowed_application_pack_ids": { "$ref": "#/$defs/ids" }, "allowed_integration_ids": { "$ref": "#/$defs/ids" }, "allowed_capability_ids": { "$ref": "#/$defs/ids" }, "semantic_target_ids": { "$ref": "#/$defs/optional_ids" }, "valid_from_unix_seconds": { "type": "integer", "minimum": 1 }, "expires_at_unix_seconds": { "type": "integer", "minimum": 1 }, "one_time_grant_sequence": { "type": "integer", "minimum": 1 }, "evidence_ids": { "$ref": "#/$defs/evidence" }, "grant_sha256": { "$ref": "#/$defs/hash" } },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!\\*$)(?!all$)(?!any$)[A-Za-z0-9._:/-]+$" }, "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "ids": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "optional_ids": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "evidence": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } }
}

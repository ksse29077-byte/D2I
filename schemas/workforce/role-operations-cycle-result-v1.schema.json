{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoleOperationsCycleResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_sha256",
    "processed_cases",
    "sla_state_hashes",
    "new_breach_hashes",
    "duplicate_breaches",
    "metric_result_hashes",
    "report_trigger_hashes",
    "generated_report_hashes",
    "published_report_hashes",
    "generated_escalation_hashes",
    "routed_escalation_hashes",
    "overdue_escalations",
    "rejected_artifacts",
    "logical_operations",
    "output_hashes",
    "cycle_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "processed_cases": {
      "type": "integer",
      "minimum": 0
    },
    "sla_state_hashes": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "new_breach_hashes": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "duplicate_breaches": {
      "type": "integer",
      "minimum": 0
    },
    "metric_result_hashes": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "report_trigger_hashes": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "generated_report_hashes": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "published_report_hashes": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "generated_escalation_hashes": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "routed_escalation_hashes": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "overdue_escalations": {
      "type": "integer",
      "minimum": 0
    },
    "rejected_artifacts": {
      "type": "integer",
      "minimum": 0
    },
    "logical_operations": {
      "type": "integer",
      "minimum": 0
    },
    "output_hashes": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "cycle_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/workforce/shadow-proposal-reveal-receipt-v1.schema.json",
    "title":  "ShadowProposalRevealReceiptV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "receipt_id",
                     "commitment_sha256",
                     "human_reference_step_sha256",
                     "post_action_observation_sha256",
                     "revealed_proposal_sha256",
                     "human_step_durable_at_unix_ms",
                     "post_observation_durable_at_unix_ms",
                     "revealed_at_unix_ms",
                     "operator_visible_before_action",
                     "evidence_ids",
                     "receipt_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "receipt_id":  {
                                          "type":  "string",
                                          "minLength":  1,
                                          "maxLength":  512,
                                          "pattern":  "^[A-Za-z0-9._:/-]+$"
                                      },
                       "commitment_sha256":  {
                                                 "type":  "string",
                                                 "pattern":  "^sha256:[0-9a-f]{64}$",
                                                 "maxLength":  71
                                             },
                       "human_reference_step_sha256":  {
                                                           "type":  "string",
                                                           "pattern":  "^sha256:[0-9a-f]{64}$",
                                                           "maxLength":  71
                                                       },
                       "post_action_observation_sha256":  {
                                                              "type":  "string",
                                                              "pattern":  "^sha256:[0-9a-f]{64}$",
                                                              "maxLength":  71
                                                          },
                       "revealed_proposal_sha256":  {
                                                        "type":  "string",
                                                        "pattern":  "^sha256:[0-9a-f]{64}$",
                                                        "maxLength":  71
                                                    },
                       "human_step_durable_at_unix_ms":  {
                                                             "type":  "integer",
                                                             "minimum":  0,
                                                             "maximum":  18446744073709551615
                                                         },
                       "post_observation_durable_at_unix_ms":  {
                                                                   "type":  "integer",
                                                                   "minimum":  0,
                                                                   "maximum":  18446744073709551615
                                                               },
                       "revealed_at_unix_ms":  {
                                                   "type":  "integer",
                                                   "minimum":  0,
                                                   "maximum":  18446744073709551615
                                               },
                       "operator_visible_before_action":  {
                                                              "type":  "boolean"
                                                          },
                       "evidence_ids":  {
                                            "type":  "array",
                                            "maxItems":  512,
                                            "uniqueItems":  true,
                                            "items":  {
                                                          "type":  "string",
                                                          "minLength":  1,
                                                          "maxLength":  512,
                                                          "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                      }
                                        },
                       "receipt_sha256":  {
                                              "type":  "string",
                                              "pattern":  "^sha256:[0-9a-f]{64}$",
                                              "maxLength":  71
                                          }
                   }
}

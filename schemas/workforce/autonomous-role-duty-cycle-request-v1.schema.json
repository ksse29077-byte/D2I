{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/workforce/autonomous-role-duty-cycle-request-v1.schema.json",
    "title":  "AutonomousRoleDutyCycleRequestV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "cycle_id",
                     "organization_id",
                     "role_instance_sha256",
                     "autonomy_state_sha256",
                     "profile_sha256",
                     "deployment_approval_sha256",
                     "readiness_binding_sha256",
                     "trusted_time_context_sha256",
                     "work_radar_source_heads",
                     "intake_head_sha256",
                     "case_ledger_head_sha256",
                     "queue_head_sha256",
                     "ownership_head_sha256",
                     "planner_head_hashes",
                     "memory_head_sha256",
                     "operations_head_sha256",
                     "audit_head_sha256",
                     "maximum_cases",
                     "maximum_actions",
                     "maximum_provider_invocations",
                     "deadline_unix_ms",
                     "evidence_ids",
                     "request_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "cycle_id":  {
                                        "type":  "string",
                                        "minLength":  1,
                                        "maxLength":  512,
                                        "pattern":  "^[A-Za-z0-9._:/-]+$"
                                    },
                       "organization_id":  {
                                               "type":  "string",
                                               "minLength":  1,
                                               "maxLength":  512,
                                               "pattern":  "^[A-Za-z0-9._:/-]+$"
                                           },
                       "role_instance_sha256":  {
                                                    "type":  "string",
                                                    "pattern":  "^sha256:[0-9a-f]{64}$",
                                                    "maxLength":  71
                                                },
                       "autonomy_state_sha256":  {
                                                     "type":  "string",
                                                     "pattern":  "^sha256:[0-9a-f]{64}$",
                                                     "maxLength":  71
                                                 },
                       "profile_sha256":  {
                                              "type":  "string",
                                              "pattern":  "^sha256:[0-9a-f]{64}$",
                                              "maxLength":  71
                                          },
                       "deployment_approval_sha256":  {
                                                          "type":  "string",
                                                          "pattern":  "^sha256:[0-9a-f]{64}$",
                                                          "maxLength":  71
                                                      },
                       "readiness_binding_sha256":  {
                                                        "type":  "string",
                                                        "pattern":  "^sha256:[0-9a-f]{64}$",
                                                        "maxLength":  71
                                                    },
                       "trusted_time_context_sha256":  {
                                                           "type":  "string",
                                                           "pattern":  "^sha256:[0-9a-f]{64}$",
                                                           "maxLength":  71
                                                       },
                       "work_radar_source_heads":  {
                                                       "type":  "array",
                                                       "maxItems":  512,
                                                       "uniqueItems":  true,
                                                       "items":  {
                                                                     "type":  "string",
                                                                     "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                     "maxLength":  71
                                                                 }
                                                   },
                       "intake_head_sha256":  {
                                                  "type":  "string",
                                                  "pattern":  "^sha256:[0-9a-f]{64}$",
                                                  "maxLength":  71
                                              },
                       "case_ledger_head_sha256":  {
                                                       "type":  "string",
                                                       "pattern":  "^sha256:[0-9a-f]{64}$",
                                                       "maxLength":  71
                                                   },
                       "queue_head_sha256":  {
                                                 "type":  "string",
                                                 "pattern":  "^sha256:[0-9a-f]{64}$",
                                                 "maxLength":  71
                                             },
                       "ownership_head_sha256":  {
                                                     "type":  "string",
                                                     "pattern":  "^sha256:[0-9a-f]{64}$",
                                                     "maxLength":  71
                                                 },
                       "planner_head_hashes":  {
                                                   "type":  "array",
                                                   "maxItems":  512,
                                                   "uniqueItems":  true,
                                                   "items":  {
                                                                 "type":  "string",
                                                                 "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                 "maxLength":  71
                                                             }
                                               },
                       "memory_head_sha256":  {
                                                  "type":  "string",
                                                  "pattern":  "^sha256:[0-9a-f]{64}$",
                                                  "maxLength":  71
                                              },
                       "operations_head_sha256":  {
                                                      "type":  "string",
                                                      "pattern":  "^sha256:[0-9a-f]{64}$",
                                                      "maxLength":  71
                                                  },
                       "audit_head_sha256":  {
                                                 "type":  "string",
                                                 "pattern":  "^sha256:[0-9a-f]{64}$",
                                                 "maxLength":  71
                                             },
                       "maximum_cases":  {
                                             "type":  "integer",
                                             "minimum":  0,
                                             "maximum":  4294967295
                                         },
                       "maximum_actions":  {
                                               "type":  "integer",
                                               "minimum":  0,
                                               "maximum":  4294967295
                                           },
                       "maximum_provider_invocations":  {
                                                            "type":  "integer",
                                                            "minimum":  0,
                                                            "maximum":  4294967295
                                                        },
                       "deadline_unix_ms":  {
                                                "type":  "integer",
                                                "minimum":  0,
                                                "maximum":  18446744073709551615
                                            },
                       "evidence_ids":  {
                                            "type":  "array",
                                            "maxItems":  512,
                                            "uniqueItems":  true,
                                            "items":  {
                                                          "type":  "string",
                                                          "minLength":  1,
                                                          "maxLength":  512,
                                                          "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                      }
                                        },
                       "request_sha256":  {
                                              "type":  "string",
                                              "pattern":  "^sha256:[0-9a-f]{64}$",
                                              "maxLength":  71
                                          }
                   }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoleMeasurementWindowV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "window_id",
    "measurement_window_profile_id",
    "organization_id",
    "role_contract_sha256",
    "start_unix_seconds",
    "end_unix_seconds",
    "timezone_projection_sha256",
    "status",
    "source_tick_sha256",
    "previous_window_sha256",
    "window_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "window_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "measurement_window_profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "role_contract_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "start_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "end_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "timezone_projection_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "source_tick_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "previous_window_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "window_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

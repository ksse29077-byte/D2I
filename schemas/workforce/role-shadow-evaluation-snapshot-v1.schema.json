                                           "minLength":  1,
                                           "maxLength":  512,
                                           "pattern":  "^[A-Za-z0-9._:/-]+$"
                                       },
                       "organization_id":  {
                                               "type":  "string",
                                               "minLength":  1,
                                               "maxLength":  512,
                                               "pattern":  "^[A-Za-z0-9._:/-]+$"
                                           },
                       "role_contract_id":  {
                                                "type":  "string",
                                                "minLength":  1,
                                                "maxLength":  512,
                                                "pattern":  "^[A-Za-z0-9._:/-]+$"
                                            },
                       "role_contract_version":  {
                                                     "type":  "string",
                                                     "minLength":  1,
                                                     "maxLength":  512,
                                                     "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                 },
                       "role_contract_sha256":  {
                                                    "type":  "string",
                                                    "pattern":  "^sha256:[0-9a-f]{64}$",
                                                    "maxLength":  71

{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/workforce/role-shadow-evaluation-snapshot-v1.schema.json",
    "title":  "RoleShadowEvaluationSnapshotV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "snapshot_id",
                     "organization_id",
                     "role_contract_id",
                     "role_contract_version",
                     "role_contract_sha256",
                     "profile_sha256",
                     "cohort_sha256",
                     "readiness_policy_sha256",
                     "provider_descriptor_sha256",
                     "model_sha256",
                     "runtime_sha256",
                     "prompt_template_hashes",
                     "total_sessions",
                     "completed_sessions",
                     "invalid_sessions",
                     "interactive_sessions",
                     "instrumented_sessions",
                     "model_backed_cases",
                     "windows_sessions",
                     "exact_matches",
                     "semantic_equivalents",
                     "safe_alternatives",
                     "ai_correct_human_incorrect",
                     "human_correct_ai_incorrect",
                     "both_incorrect",
                     "ai_unnecessary_actions",
                     "ai_missed_actions",

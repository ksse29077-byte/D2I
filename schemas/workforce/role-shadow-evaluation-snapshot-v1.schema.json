                       "metric_result_hashes":  {
                                                    "type":  "array",
                                                    "maxItems":  512,
                                                    "uniqueItems":  true,
                                                    "items":  {
                                                                  "type":  "string",
                                                                  "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                  "maxLength":  71
                                                              }
                                                },
                       "coverage_sha256":  {
                                               "type":  "string",
                                               "pattern":  "^sha256:[0-9a-f]{64}$",
                                               "maxLength":  71
                                           },
                       "critical_error_count":  {
                                                    "type":  "integer",
                                                    "minimum":  0,
                                                    "maximum":  4294967295

                       "windows_sessions":  {
                                                "type":  "integer",
                                                "minimum":  0,
                                                "maximum":  4294967295
                                            },
                       "exact_matches":  {
                                             "type":  "integer",
                                             "minimum":  0,
                                             "maximum":  4294967295
                                         },
                       "semantic_equivalents":  {
                                                    "type":  "integer",
                                                    "minimum":  0,
                                                    "maximum":  4294967295
                                                },
                       "safe_alternatives":  {
                                                 "type":  "integer",
                                                 "minimum":  0,
                                                 "maximum":  4294967295
                                             },
                       "ai_correct_human_incorrect":  {
                                                          "type":  "integer",
                                                          "minimum":  0,
                                                          "maximum":  4294967295
                                                      },
                       "human_correct_ai_incorrect":  {
                                                          "type":  "integer",
                                                          "minimum":  0,
                                                          "maximum":  4294967295
                                                      },
                       "both_incorrect":  {
                                              "type":  "integer",
                                              "minimum":  0,
                                              "maximum":  4294967295
                                          },
                       "ai_unnecessary_actions":  {
                                                      "type":  "integer",
                                                      "minimum":  0,
                                                      "maximum":  4294967295
                                                  },
                       "ai_missed_actions":  {
                                                 "type":  "integer",
                                                 "minimum":  0,
                                                 "maximum":  4294967295
                                             },
                       "false_completions":  {
                                                 "type":  "integer",
                                                 "minimum":  0,
                                                 "maximum":  4294967295
                                             },
                       "mandatory_escalation_cases":  {
                                                          "type":  "integer",
                                                          "minimum":  0,
                                                          "maximum":  4294967295
                                                      },
                       "mandatory_escalation_misses":  {
                                                           "type":  "integer",
                                                           "minimum":  0,
                                                           "maximum":  4294967295
                                                       },
                       "forbidden_capability_count":  {
                                                          "type":  "integer",
                                                          "minimum":  0,
                                                          "maximum":  4294967295
                                                      },
                       "authority_expansion_count":  {
                                                         "type":  "integer",
                                                         "minimum":  0,
                                                         "maximum":  4294967295
                                                     },
                       "direct_execution_attempt_count":  {
                                                              "type":  "integer",
                                                              "minimum":  0,
                                                              "maximum":  4294967295
                                                          },
                       "secret_leakage_count":  {
                                                    "type":  "integer",
                                                    "minimum":  0,
                                                    "maximum":  4294967295
                                                },
                       "unblinded_cycle_count":  {
                                                     "type":  "integer",
                                                     "minimum":  0,
                                                     "maximum":  4294967295

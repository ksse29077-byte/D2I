                       "completed_sessions":  {
                                                  "type":  "integer",
                                                  "minimum":  0,
                                                  "maximum":  4294967295
                                              },
                       "invalid_sessions":  {
                                                "type":  "integer",
                                                "minimum":  0,
                                                "maximum":  4294967295
                                            },
                       "interactive_sessions":  {
                                                    "type":  "integer",
                                                    "minimum":  0,
                                                    "maximum":  4294967295
                                                },
                       "instrumented_sessions":  {
                                                     "type":  "integer",
                                                     "minimum":  0,
                                                     "maximum":  4294967295

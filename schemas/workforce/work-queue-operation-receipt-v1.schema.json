{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://d2i.invalid/schemas/workforce/work-queue-operation-receipt-v1.schema.json", "title": "WorkQueueOperationReceiptV1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "operation_kind", "queue_id", "case_id", "source_intake_receipt_sha256", "queue_entry_sha256", "scheduler_decision_sha256", "lease_sha256", "ownership_state_sha256", "ownership_transfer_sha256", "work_grant_sha256", "role_ledger_chain_head", "case_ledger_chain_head", "queue_ledger_chain_head", "recorded_at_unix_seconds", "evidence_ids", "receipt_sha256"],
  "properties": { "schema_version": { "const": 1 }, "receipt_id": { "$ref": "#/$defs/id" }, "operation_kind": { "enum": ["enqueued", "reconciled", "scheduler_evaluated", "lease_claimed", "lease_renewed", "lease_released", "lease_expired", "ownership_transferred", "work_grant_created", "recovery_repaired"] }, "queue_id": { "$ref": "#/$defs/id" }, "case_id": { "$ref": "#/$defs/id" }, "source_intake_receipt_sha256": { "$ref": "#/$defs/hash" }, "queue_entry_sha256": { "$ref": "#/$defs/nullable_hash" }, "scheduler_decision_sha256": { "$ref": "#/$defs/nullable_hash" }, "lease_sha256": { "$ref": "#/$defs/nullable_hash" }, "ownership_state_sha256": { "$ref": "#/$defs/nullable_hash" }, "ownership_transfer_sha256": { "$ref": "#/$defs/nullable_hash" }, "work_grant_sha256": { "$ref": "#/$defs/nullable_hash" }, "role_ledger_chain_head": { "$ref": "#/$defs/hash" }, "case_ledger_chain_head": { "$ref": "#/$defs/hash" }, "queue_ledger_chain_head": { "$ref": "#/$defs/hash" }, "recorded_at_unix_seconds": { "type": "integer", "minimum": 1 }, "evidence_ids": { "$ref": "#/$defs/evidence" }, "receipt_sha256": { "$ref": "#/$defs/hash" } },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!\\*$)(?!all$)(?!any$)[A-Za-z0-9._:/-]+$" }, "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "nullable_hash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] }, "evidence": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/schemas/workforce/work-signal-v1.schema.json",
  "title": "WorkSignalV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signal_id", "registration_id", "registration_sha256", "organization_id", "role_instance_id", "delegation_sha256", "source_system_id", "event_id", "source_sequence", "source_cursor", "event_class_id", "observed_at_unix_seconds", "received_at_unix_seconds", "source_record_sha256", "payload_reference_sha256", "attachment_reference_hashes", "subject_refs", "structured_input_kind_ids", "structured_input_refs", "trust_labels", "provenance", "semantic_payload_sha256", "evidence_ids", "signal_sha256"],
  "properties": {
    "schema_version": { "const": 1 },
    "signal_id": { "$ref": "#/$defs/id" },
    "registration_id": { "$ref": "#/$defs/id" },
    "registration_sha256": { "$ref": "#/$defs/hash" },
    "organization_id": { "$ref": "#/$defs/id" },
    "role_instance_id": { "$ref": "#/$defs/id" },
    "delegation_sha256": { "$ref": "#/$defs/hash" },
    "source_system_id": { "$ref": "#/$defs/id" },
    "event_id": { "$ref": "#/$defs/id" },
    "source_sequence": { "type": "integer", "minimum": 1 },
    "source_cursor": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "event_class_id": { "$ref": "#/$defs/id" },
    "observed_at_unix_seconds": { "type": "integer", "minimum": 1 },
    "received_at_unix_seconds": { "type": "integer", "minimum": 1 },
    "source_record_sha256": { "$ref": "#/$defs/hash" },
    "payload_reference_sha256": { "$ref": "#/$defs/hash" },
    "attachment_reference_hashes": { "$ref": "#/$defs/hashes" },
    "subject_refs": { "$ref": "#/$defs/idsRequired" },
    "structured_input_kind_ids": { "$ref": "#/$defs/ids" },
    "structured_input_refs": { "$ref": "#/$defs/ids" },
    "trust_labels": { "$ref": "#/$defs/idsRequired" },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["authenticated_actor_id", "authentication_class_id", "authentication_evidence_sha256"], "properties": { "authenticated_actor_id": { "$ref": "#/$defs/id" }, "authentication_class_id": { "$ref": "#/$defs/id" }, "authentication_evidence_sha256": { "$ref": "#/$defs/hash" } } },
    "semantic_payload_sha256": { "$ref": "#/$defs/hash" },
    "evidence_ids": { "$ref": "#/$defs/idsRequired" },
    "signal_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ids": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "idsRequired": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "hashes": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } }
  }
}

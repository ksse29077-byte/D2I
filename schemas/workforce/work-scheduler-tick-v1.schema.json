{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.invalid/schemas/workforce/work-scheduler-tick-v1.schema.json",
  "title": "WorkSchedulerTickV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tick_id", "queue_id", "queue_policy_sha256", "queue_snapshot_sha256", "trusted_now_unix_seconds", "operational_time_context", "current_role_ledger_head", "current_case_ledger_head", "current_queue_ledger_head", "maximum_entries", "logical_operation_budget", "evidence_ids", "tick_sha256"],
  "properties": {
    "schema_version": { "const": 1 },
    "tick_id": { "$ref": "#/$defs/id" },
    "queue_id": { "$ref": "#/$defs/id" },
    "queue_policy_sha256": { "$ref": "#/$defs/hash" },
    "queue_snapshot_sha256": { "$ref": "#/$defs/hash" },
    "trusted_now_unix_seconds": { "type": "integer", "minimum": 1 },
    "operational_time_context": { "$ref": "#/$defs/time_context" },
    "current_role_ledger_head": { "$ref": "#/$defs/hash" },
    "current_case_ledger_head": { "$ref": "#/$defs/hash" },
    "current_queue_ledger_head": { "$ref": "#/$defs/hash" },
    "maximum_entries": { "type": "integer", "minimum": 1, "maximum": 128 },
    "logical_operation_budget": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "evidence_ids": { "$ref": "#/$defs/evidence" },
    "tick_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!\\*$)(?!all$)(?!any$)[A-Za-z0-9._:/-]+$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nullable_hash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] },
    "evidence": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "time_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "calendar_sha256", "timezone_id", "local_date", "weekday", "local_minute_of_day", "utc_offset_minutes", "blackout_date_ids", "emergency_override_sha256", "observed_at_unix_seconds", "evidence_ids", "context_sha256"],
      "properties": {
        "schema_version": { "const": 1 },
        "calendar_sha256": { "$ref": "#/$defs/hash" },
        "timezone_id": { "$ref": "#/$defs/id" },
        "local_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "weekday": { "type": "integer", "minimum": 0, "maximum": 6 },
        "local_minute_of_day": { "type": "integer", "minimum": 0, "maximum": 1439 },
        "utc_offset_minutes": { "type": "integer", "minimum": -840, "maximum": 840 },
        "blackout_date_ids": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "emergency_override_sha256": { "$ref": "#/$defs/nullable_hash" },
        "observed_at_unix_seconds": { "type": "integer", "minimum": 1 },
        "evidence_ids": { "$ref": "#/$defs/evidence" },
        "context_sha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/schemas/workforce/situation-fact-v1.schema.json",
  "title": "SituationFactV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["fact_id", "fact_kind", "subject", "predicate", "typed_object", "confidence", "evidence_refs", "source_trust_class", "provider_id", "freshness", "contradiction_group_id", "fact_sha256"],
  "properties": {
    "fact_id": {"$ref": "#/$defs/id"},
    "fact_kind": {"enum": ["observed", "trusted_system", "approved_policy", "approved_procedure", "authenticated_assertion", "model_inference"]},
    "subject": {"$ref": "#/$defs/id"},
    "predicate": {"$ref": "#/$defs/id"},
    "typed_object": {"type": ["null", "boolean", "integer", "string", "array", "object"]},
    "confidence": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1000000}, {"const": "not_applicable"}]},
    "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "source_trust_class": {"enum": ["authenticated_instruction", "approved_policy", "approved_procedure", "trusted_system", "verified_observation", "model_inference", "untrusted_content"]},
    "provider_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "freshness": {"$ref": "#/$defs/freshness"},
    "contradiction_group_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "fact_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "hash": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"},
    "freshness": {"type": "object", "additionalProperties": false, "required": ["observed_at_unix_seconds", "valid_until_unix_seconds", "maximum_age_seconds"], "properties": {"observed_at_unix_seconds": {"type": "integer", "minimum": 1}, "valid_until_unix_seconds": {"type": "integer", "minimum": 2}, "maximum_age_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}}}
  }
}

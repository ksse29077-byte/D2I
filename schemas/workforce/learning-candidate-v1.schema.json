{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.example/schemas/workforce/learning-candidate-v1.schema.json",
    "title":  "LearningCandidateV1",
    "type":  "object",
    "required":  [
                     "schema_version",
                     "candidate_id",
                     "candidate_kind",
                     "organization_id",
                     "namespace_sha256",
                     "role_contract_sha256",
                     "work_class_id",
                     "source_episode_hashes",
                     "source_approved_summary_hashes",
                     "minimum_source_count",
                     "observed_pattern_class_ids",
                     "proposed_semantic_change_class",
                     "expected_benefit_class",
                     "risk_class",
                     "critical_error_relevance",
                     "required_offline_evaluation_ids",
                     "data_class_ids",
                     "redaction_proof_ids",
                     "status",
                     "quarantine_reason_codes",
                     "evidence_ids",
                     "candidate_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "candidate_id":  {
                                            "type":  "string",
                                            "minLength":  1,
                                            "maxLength":  4096
                                        },
                       "candidate_kind":  {
                                              "enum":  [
                                                           "evaluation_case_candidate",
                                                           "procedure_pattern_candidate",
                                                           "planner_example_candidate",
                                                           "recovery_pattern_candidate",
                                                           "application_semantics_review_candidate",
                                                           "policy_review_candidate",
                                                           "prompt_template_review_candidate",
                                                           "security_regression_candidate",
                                                           "unsupported_case_candidate"
                                                       ]
                                          },
                       "organization_id":  {
                                               "type":  "string",
                                               "minLength":  1,
                                               "maxLength":  4096
                                           },
                       "namespace_sha256":  {
                                                "type":  "string",
                                                "pattern":  "^sha256:[0-9a-f]{64}$",
                                                "maxLength":  71
                                            },
                       "role_contract_sha256":  {
                                                    "type":  "string",
                                                    "pattern":  "^sha256:[0-9a-f]{64}$",
                                                    "maxLength":  71
                                                },
                       "work_class_id":  {
                                             "type":  "string",
                                             "minLength":  1,
                                             "maxLength":  4096
                                         },
                       "source_episode_hashes":  {
                                                     "type":  "array",
                                                     "maxItems":  512,
                                                     "uniqueItems":  true,
                                                     "items":  {
                                                                   "type":  "string",
                                                                   "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                   "maxLength":  71
                                                               }
                                                 },
                       "source_approved_summary_hashes":  {
                                                              "type":  "array",
                                                              "maxItems":  512,
                                                              "uniqueItems":  true,
                                                              "items":  {
                                                                            "type":  "string",
                                                                            "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                            "maxLength":  71
                                                                        }
                                                          },
                       "minimum_source_count":  {
                                                    "type":  "integer",
                                                    "minimum":  0,
                                                    "maximum":  9007199254740991
                                                },
                       "observed_pattern_class_ids":  {
                                                          "type":  "array",
                                                          "maxItems":  512,
                                                          "uniqueItems":  true,
                                                          "items":  {
                                                                        "type":  "string",
                                                                        "minLength":  1,
                                                                        "maxLength":  256
                                                                    }
                                                      },
                       "proposed_semantic_change_class":  {
                                                              "type":  "string",
                                                              "minLength":  1,
                                                              "maxLength":  4096
                                                          },
                       "expected_benefit_class":  {
                                                      "type":  "string",
                                                      "minLength":  1,
                                                      "maxLength":  4096
                                                  },
                       "risk_class":  {
                                          "type":  "string",
                                          "minLength":  1,
                                          "maxLength":  4096
                                      },
                       "critical_error_relevance":  {
                                                        "type":  "boolean"
                                                    },
                       "required_offline_evaluation_ids":  {
                                                               "type":  "array",
                                                               "maxItems":  512,
                                                               "uniqueItems":  true,
                                                               "items":  {
                                                                             "type":  "string",
                                                                             "minLength":  1,
                                                                             "maxLength":  256
                                                                         }
                                                           },
                       "data_class_ids":  {
                                              "type":  "array",
                                              "maxItems":  512,
                                              "uniqueItems":  true,
                                              "items":  {
                                                            "type":  "string",
                                                            "minLength":  1,
                                                            "maxLength":  256
                                                        }
                                          },
                       "redaction_proof_ids":  {
                                                   "type":  "array",
                                                   "maxItems":  512,
                                                   "uniqueItems":  true,
                                                   "items":  {
                                                                 "type":  "string",
                                                                 "minLength":  1,
                                                                 "maxLength":  256
                                                             }
                                               },
                       "status":  {
                                      "enum":  [
                                                   "quarantined",
                                                   "rejected",
                                                   "exported_for_offline_evaluation",
                                                   "evaluation_passed",
                                                   "evaluation_failed",
                                                   "approved_for_offline_build",
                                                   "archived"
                                               ]
                                  },
                       "quarantine_reason_codes":  {
                                                       "type":  "array",
                                                       "maxItems":  512,
                                                       "uniqueItems":  true,
                                                       "items":  {
                                                                     "type":  "string",
                                                                     "minLength":  1,
                                                                     "maxLength":  256
                                                                 }
                                                   },
                       "evidence_ids":  {
                                            "type":  "array",
                                            "maxItems":  512,
                                            "uniqueItems":  true,
                                            "items":  {
                                                          "type":  "string",
                                                          "minLength":  1,
                                                          "maxLength":  256
                                                      }
                                        },
                       "candidate_sha256":  {
                                                "type":  "string",
                                                "pattern":  "^sha256:[0-9a-f]{64}$",
                                                "maxLength":  71
                                            }
                   },
    "additionalProperties":  false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoleOperationsProfileApprovalV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_sha256",
    "organization_id",
    "role_contract_sha256",
    "signer_id",
    "signing_key_id",
    "issued_at_unix_seconds",
    "expires_at_unix_seconds",
    "nonce",
    "evidence_ids",
    "approval_sha256",
    "signature_hex"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "role_contract_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "signing_key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "issued_at_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at_unix_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "nonce": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "evidence_ids": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "approval_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  }
}

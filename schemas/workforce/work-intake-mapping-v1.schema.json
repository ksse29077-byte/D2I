{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/schemas/workforce/work-intake-mapping-v1.schema.json",
  "title": "WorkIntakeMappingProfileV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mapping_id", "mapping_version", "registration_id", "registration_sha256", "observation_source_id", "event_class_id", "work_class_id", "work_class_contract_version", "requested_outcome_class_ids", "requested_evidence_class_ids", "priority_class", "risk_class", "application_pack_refs", "integration_ids", "capability_requirement_ids", "semantic_target_ids", "deduplication_scope_id", "required_trust_labels", "allowed_structured_input_kind_ids", "minimum_subject_refs", "minimum_structured_input_refs", "due_time_derivation", "due_time_offset_seconds", "evidence_ids", "mapping_sha256"],
  "properties": {
    "schema_version": { "const": 1 },
    "mapping_id": { "$ref": "#/$defs/id" }, "mapping_version": { "$ref": "#/$defs/id" },
    "registration_id": { "$ref": "#/$defs/id" }, "registration_sha256": { "$ref": "#/$defs/hash" },
    "observation_source_id": { "$ref": "#/$defs/id" }, "event_class_id": { "$ref": "#/$defs/id" },
    "work_class_id": { "$ref": "#/$defs/id" }, "work_class_contract_version": { "$ref": "#/$defs/id" },
    "requested_outcome_class_ids": { "$ref": "#/$defs/idsRequired" }, "requested_evidence_class_ids": { "$ref": "#/$defs/idsRequired" },
    "priority_class": { "enum": ["routine", "normal", "elevated", "urgent"] },
    "risk_class": { "enum": ["read_only", "reversible", "business_state_change", "external_communication", "credential_use", "irreversible", "high_criticality"] },
    "application_pack_refs": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/applicationPack" } },
    "integration_ids": { "$ref": "#/$defs/idsRequired" }, "capability_requirement_ids": { "$ref": "#/$defs/idsRequired" }, "semantic_target_ids": { "$ref": "#/$defs/idsRequired" },
    "deduplication_scope_id": { "$ref": "#/$defs/id" }, "required_trust_labels": { "$ref": "#/$defs/idsRequired" },
    "allowed_structured_input_kind_ids": { "$ref": "#/$defs/ids" },
    "minimum_subject_refs": { "type": "integer", "minimum": 1, "maximum": 128 },
    "minimum_structured_input_refs": { "type": "integer", "minimum": 0, "maximum": 128 },
    "due_time_derivation": { "enum": ["none", "fixed_offset_from_received", "caller_supplied"] },
    "due_time_offset_seconds": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1, "maximum": 31536000 }] },
    "evidence_ids": { "$ref": "#/$defs/idsRequired" }, "mapping_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "ids": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "idsRequired": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "applicationPack": { "type": "object", "additionalProperties": false, "required": ["application_pack_id", "application_pack_sha256"], "properties": { "application_pack_id": { "$ref": "#/$defs/id" }, "application_pack_sha256": { "$ref": "#/$defs/hash" } } }
  }
}

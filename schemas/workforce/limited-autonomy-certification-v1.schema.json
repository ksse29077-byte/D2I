{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/workforce/limited-autonomy-certification-v1.schema.json",
    "title":  "LimitedAutonomyCertificationV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "certification_id",
                     "git_head_sha256",
                     "completion_report_sha256",
                     "replay_report_sha256",
                     "audit_terminal_sha256",
                     "security_scan_sha256",
                     "predecessor_evidence_sha256",
                     "autonomy_evidence",
                     "human_by_exception_evidence",
                     "track_w_completion_evidence",
                     "issued_at_unix_ms",
                     "evidence_ids",
                     "certification_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "certification_id":  {
                                                "type":  "string",
                                                "minLength":  1,
                                                "maxLength":  512,
                                                "pattern":  "^[A-Za-z0-9._:/-]+$"
                                            },
                       "git_head_sha256":  {
                                               "type":  "string",
                                               "pattern":  "^sha256:[0-9a-f]{64}$",
                                               "maxLength":  71
                                           },
                       "completion_report_sha256":  {
                                                        "type":  "string",
                                                        "pattern":  "^sha256:[0-9a-f]{64}$",
                                                        "maxLength":  71
                                                    },
                       "replay_report_sha256":  {
                                                    "type":  "string",
                                                    "pattern":  "^sha256:[0-9a-f]{64}$",
                                                    "maxLength":  71
                                                },
                       "audit_terminal_sha256":  {
                                                     "type":  "string",
                                                     "pattern":  "^sha256:[0-9a-f]{64}$",
                                                     "maxLength":  71
                                                 },
                       "security_scan_sha256":  {
                                                    "type":  "string",
                                                    "pattern":  "^sha256:[0-9a-f]{64}$",
                                                    "maxLength":  71
                                                },
                       "predecessor_evidence_sha256":  {
                                                           "type":  "string",
                                                           "pattern":  "^sha256:[0-9a-f]{64}$",
                                                           "maxLength":  71
                                                       },
                       "autonomy_evidence":  {
                                                 "type":  "boolean"
                                             },
                       "human_by_exception_evidence":  {
                                                           "type":  "boolean"
                                                       },
                       "track_w_completion_evidence":  {
                                                           "type":  "boolean"
                                                       },
                       "issued_at_unix_ms":  {
                                                 "type":  "integer",
                                                 "minimum":  0,
                                                 "maximum":  18446744073709551615
                                             },
                       "evidence_ids":  {
                                            "type":  "array",
                                            "maxItems":  512,
                                            "uniqueItems":  true,
                                            "items":  {
                                                          "type":  "string",
                                                          "minLength":  1,
                                                          "maxLength":  512,
                                                          "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                      }
                                        },
                       "certification_sha256":  {
                                                    "type":  "string",
                                                    "pattern":  "^sha256:[0-9a-f]{64}$",
                                                    "maxLength":  71
                                                }
                   }
}

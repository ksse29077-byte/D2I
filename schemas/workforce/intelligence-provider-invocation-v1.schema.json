{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/schemas/workforce/intelligence-provider-invocation-v1.schema.json",
  "title": "IntelligenceProviderInvocationV1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "invocation_id", "operation", "provider_descriptor_sha256", "model_artifact_sha256", "inference_runtime_sha256", "case_id", "context_sha256", "situation_sha256", "input_schema_id", "requested_output_schema_id", "prompt_template_sha256", "system_policy_sha256", "trusted_caller_time_unix_seconds", "deadline_unix_milliseconds", "decoding", "timeout_milliseconds", "memory_budget_bytes", "output_budget_bytes", "replay_id", "evidence_ids", "input_sha256", "invocation_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "invocation_id": {"$ref": "#/$defs/id"}, "operation": {"enum": ["understand_goal", "interpret_situation", "propose_next_steps"]}, "provider_descriptor_sha256": {"$ref": "#/$defs/hash"}, "model_artifact_sha256": {"$ref": "#/$defs/hash"}, "inference_runtime_sha256": {"$ref": "#/$defs/hash"}, "case_id": {"$ref": "#/$defs/id"}, "context_sha256": {"$ref": "#/$defs/hash"}, "situation_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "input_schema_id": {"$ref": "#/$defs/id"}, "requested_output_schema_id": {"$ref": "#/$defs/id"}, "prompt_template_sha256": {"$ref": "#/$defs/hash"}, "system_policy_sha256": {"$ref": "#/$defs/hash"}, "trusted_caller_time_unix_seconds": {"type": "integer", "minimum": 1}, "deadline_unix_milliseconds": {"type": "integer", "minimum": 2}, "decoding": {"$ref": "#/$defs/decoding"}, "timeout_milliseconds": {"type": "integer", "minimum": 1, "maximum": 120000}, "memory_budget_bytes": {"type": "integer", "minimum": 268435456, "maximum": 8589934592}, "output_budget_bytes": {"type": "integer", "minimum": 1, "maximum": 65536}, "replay_id": {"$ref": "#/$defs/id"}, "evidence_ids": {"$ref": "#/$defs/ids"}, "input_sha256": {"$ref": "#/$defs/hash"}, "invocation_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"}, "hash": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}, "ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "decoding": {"type": "object", "additionalProperties": false, "required": ["seed", "temperature_millionths", "top_p_millionths", "top_k", "output_grammar_sha256"], "properties": {"seed": {"type": "integer", "minimum": 0}, "temperature_millionths": {"type": "integer", "minimum": 0, "maximum": 2000000}, "top_p_millionths": {"type": "integer", "minimum": 1, "maximum": 1000000}, "top_k": {"type": "integer", "minimum": 0, "maximum": 1000}, "output_grammar_sha256": {"$ref": "#/$defs/hash"}}}}
}

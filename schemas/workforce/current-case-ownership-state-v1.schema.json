{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://d2i.invalid/schemas/workforce/current-case-ownership-state-v1.schema.json", "title": "CurrentCaseOwnershipStateV1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "ownership_state_id", "case_id", "case_contract_sha256", "origin_ownership_sha256", "ownership_generation", "current_role_instance_id", "current_role_instance_sha256", "current_role_contract_id", "current_role_version", "current_role_contract_sha256", "current_delegation_sha256", "organization_id", "responsibility_id", "work_class_id", "previous_ownership_state_sha256", "ownership_pool_sha256", "queue_policy_sha256", "assignment_reason", "assigned_at_unix_seconds", "ownership_expires_at_unix_seconds", "active_lease_sha256", "transfer_sha256", "role_ledger_chain_head", "case_ledger_chain_head", "evidence_ids", "state_sha256"],
  "properties": { "schema_version": { "const": 1 }, "ownership_state_id": { "$ref": "#/$defs/id" }, "case_id": { "$ref": "#/$defs/id" }, "case_contract_sha256": { "$ref": "#/$defs/hash" }, "origin_ownership_sha256": { "$ref": "#/$defs/hash" }, "ownership_generation": { "type": "integer", "minimum": 1, "maximum": 1024 }, "current_role_instance_id": { "$ref": "#/$defs/id" }, "current_role_instance_sha256": { "$ref": "#/$defs/hash" }, "current_role_contract_id": { "$ref": "#/$defs/id" }, "current_role_version": { "$ref": "#/$defs/id" }, "current_role_contract_sha256": { "$ref": "#/$defs/hash" }, "current_delegation_sha256": { "$ref": "#/$defs/hash" }, "organization_id": { "$ref": "#/$defs/id" }, "responsibility_id": { "$ref": "#/$defs/id" }, "work_class_id": { "$ref": "#/$defs/id" }, "previous_ownership_state_sha256": { "$ref": "#/$defs/nullable_hash" }, "ownership_pool_sha256": { "$ref": "#/$defs/hash" }, "queue_policy_sha256": { "$ref": "#/$defs/hash" }, "assignment_reason": { "enum": ["origin_binding", "approved_transfer"] }, "assigned_at_unix_seconds": { "type": "integer", "minimum": 1 }, "ownership_expires_at_unix_seconds": { "type": "integer", "minimum": 1 }, "active_lease_sha256": { "$ref": "#/$defs/nullable_hash" }, "transfer_sha256": { "$ref": "#/$defs/nullable_hash" }, "role_ledger_chain_head": { "$ref": "#/$defs/hash" }, "case_ledger_chain_head": { "$ref": "#/$defs/hash" }, "evidence_ids": { "$ref": "#/$defs/evidence" }, "state_sha256": { "$ref": "#/$defs/hash" } },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!\\*$)(?!all$)(?!any$)[A-Za-z0-9._:/-]+$" }, "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "nullable_hash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] }, "evidence": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } }
}

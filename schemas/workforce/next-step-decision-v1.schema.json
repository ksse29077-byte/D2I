{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://d2i.local/schemas/workforce/next-step-decision-v1.schema.json", "title": "NextStepDecisionV1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "decision_id", "case_id", "request_sha256", "result_sha256", "plan_sha256", "situation_sha256", "case_work_grant_sha256", "lease_sha256", "ownership_state_sha256", "observation_sha256", "outcome", "selected_candidate", "rejected_candidate_hashes", "reason_codes", "valid_until_unix_seconds", "evidence_ids", "decision_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "decision_id": {"$ref": "#/$defs/id"}, "case_id": {"$ref": "#/$defs/id"}, "request_sha256": {"$ref": "#/$defs/hash"}, "result_sha256": {"$ref": "#/$defs/hash"}, "plan_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "situation_sha256": {"$ref": "#/$defs/hash"}, "case_work_grant_sha256": {"$ref": "#/$defs/hash"}, "lease_sha256": {"$ref": "#/$defs/hash"}, "ownership_state_sha256": {"$ref": "#/$defs/hash"}, "observation_sha256": {"$ref": "#/$defs/hash"}, "outcome": {"enum": ["continue", "verified_case_complete", "clarification_required", "escalation_required", "unsupported", "unsafe", "budget_exhausted", "provider_unavailable", "provider_output_invalid", "no_eligible_action", "conflicting_situation"]}, "selected_candidate": {"type": ["object", "null"]}, "rejected_candidate_hashes": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}}, "reason_codes": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "valid_until_unix_seconds": {"type": "integer", "minimum": 1}, "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "decision_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"}, "hash": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}}
}

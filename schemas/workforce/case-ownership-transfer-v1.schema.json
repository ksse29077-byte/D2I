{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://d2i.invalid/schemas/workforce/case-ownership-transfer-v1.schema.json", "title": "CaseOwnershipTransferV1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "transfer_id", "case_id", "case_contract_sha256", "current_case_instance_sha256", "current_queue_entry_sha256", "previous_ownership_state_sha256", "source_role_instance_id", "source_role_instance_sha256", "target_role_instance_id", "target_role_instance_sha256", "organization_id", "role_contract_id", "role_version", "role_contract_sha256", "responsibility_id", "work_class_id", "ownership_pool_sha256", "transfer_reason", "transfer_at_unix_seconds", "current_case_ledger_head", "current_queue_ledger_head", "current_role_ledger_head", "next_ownership_generation", "evidence_ids", "transfer_sha256"],
  "properties": { "schema_version": { "const": 1 }, "transfer_id": { "$ref": "#/$defs/id" }, "case_id": { "$ref": "#/$defs/id" }, "case_contract_sha256": { "$ref": "#/$defs/hash" }, "current_case_instance_sha256": { "$ref": "#/$defs/hash" }, "current_queue_entry_sha256": { "$ref": "#/$defs/hash" }, "previous_ownership_state_sha256": { "$ref": "#/$defs/hash" }, "source_role_instance_id": { "$ref": "#/$defs/id" }, "source_role_instance_sha256": { "$ref": "#/$defs/hash" }, "target_role_instance_id": { "$ref": "#/$defs/id" }, "target_role_instance_sha256": { "$ref": "#/$defs/hash" }, "organization_id": { "$ref": "#/$defs/id" }, "role_contract_id": { "$ref": "#/$defs/id" }, "role_version": { "$ref": "#/$defs/id" }, "role_contract_sha256": { "$ref": "#/$defs/hash" }, "responsibility_id": { "$ref": "#/$defs/id" }, "work_class_id": { "$ref": "#/$defs/id" }, "ownership_pool_sha256": { "$ref": "#/$defs/hash" }, "transfer_reason": { "enum": ["coordinator_recovery", "lease_recovery", "owner_capacity_exhausted", "owner_expired", "owner_revoked", "owner_suspended"] }, "transfer_at_unix_seconds": { "type": "integer", "minimum": 1 }, "current_case_ledger_head": { "$ref": "#/$defs/hash" }, "current_queue_ledger_head": { "$ref": "#/$defs/hash" }, "current_role_ledger_head": { "$ref": "#/$defs/hash" }, "next_ownership_generation": { "type": "integer", "minimum": 2, "maximum": 1024 }, "evidence_ids": { "$ref": "#/$defs/evidence" }, "transfer_sha256": { "$ref": "#/$defs/hash" } },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!\\*$)(?!all$)(?!any$)[A-Za-z0-9._:/-]+$" }, "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "evidence": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } }
}

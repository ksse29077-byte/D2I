{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/workforce/autonomy-role-runtime-state-v1.schema.json",
    "title":  "AutonomyRoleRuntimeStateV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "state_id",
                     "role_instance_sha256",
                     "autonomy_profile_sha256",
                     "deployment_approval_sha256",
                     "readiness_binding_sha256",
                     "status",
                     "enabled_at_unix_ms",
                     "paused_at_unix_ms",
                     "state_generation",
                     "processed_case_count",
                     "active_case_count",
                     "successful_autonomous_case_count",
                     "exception_count",
                     "failure_count",
                     "current_health_snapshot_sha256",
                     "current_control_command_sha256",
                     "previous_state_sha256",
                     "evidence_ids",
                     "state_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "state_id":  {
                                        "type":  "string",
                                        "minLength":  1,
                                        "maxLength":  512,
                                        "pattern":  "^[A-Za-z0-9._:/-]+$"
                                    },
                       "role_instance_sha256":  {
                                                    "type":  "string",
                                                    "pattern":  "^sha256:[0-9a-f]{64}$",
                                                    "maxLength":  71
                                                },
                       "autonomy_profile_sha256":  {
                                                       "type":  "string",
                                                       "pattern":  "^sha256:[0-9a-f]{64}$",
                                                       "maxLength":  71
                                                   },
                       "deployment_approval_sha256":  {
                                                          "type":  "string",
                                                          "pattern":  "^sha256:[0-9a-f]{64}$",
                                                          "maxLength":  71
                                                      },
                       "readiness_binding_sha256":  {
                                                        "type":  "string",
                                                        "pattern":  "^sha256:[0-9a-f]{64}$",
                                                        "maxLength":  71
                                                    },
                       "status":  {
                                      "type":  "string",
                                      "enum":  [
                                                   "disabled",
                                                   "eligible",
                                                   "enabled",
                                                   "paused",
                                                   "draining",
                                                   "suspended",
                                                   "revoked",
                                                   "expired",
                                                   "health_tripped"
                                               ]
                                  },
                       "enabled_at_unix_ms":  {
                                                  "type":  [
                                                               "integer",
                                                               "null"
                                                           ],
                                                  "minimum":  0,
                                                  "maximum":  18446744073709551615
                                              },
                       "paused_at_unix_ms":  {
                                                 "type":  [
                                                              "integer",
                                                              "null"
                                                          ],
                                                 "minimum":  0,
                                                 "maximum":  18446744073709551615
                                             },
                       "state_generation":  {
                                                "type":  "integer",
                                                "minimum":  0,
                                                "maximum":  18446744073709551615
                                            },
                       "processed_case_count":  {
                                                    "type":  "integer",
                                                    "minimum":  0,
                                                    "maximum":  4294967295
                                                },
                       "active_case_count":  {
                                                 "type":  "integer",
                                                 "minimum":  0,
                                                 "maximum":  4294967295
                                             },
                       "successful_autonomous_case_count":  {
                                                                "type":  "integer",
                                                                "minimum":  0,
                                                                "maximum":  4294967295
                                                            },
                       "exception_count":  {
                                               "type":  "integer",
                                               "minimum":  0,
                                               "maximum":  4294967295
                                           },
                       "failure_count":  {
                                             "type":  "integer",
                                             "minimum":  0,
                                             "maximum":  4294967295
                                         },
                       "current_health_snapshot_sha256":  {
                                                              "type":  "string",
                                                              "pattern":  "^sha256:[0-9a-f]{64}$",
                                                              "maxLength":  71
                                                          },
                       "current_control_command_sha256":  {
                                                              "type":  "string",
                                                              "pattern":  "^sha256:[0-9a-f]{64}$",
                                                              "maxLength":  71
                                                          },
                       "previous_state_sha256":  {
                                                     "type":  "string",
                                                     "pattern":  "^sha256:[0-9a-f]{64}$",
                                                     "maxLength":  71
                                                 },
                       "evidence_ids":  {
                                            "type":  "array",
                                            "maxItems":  512,
                                            "uniqueItems":  true,
                                            "items":  {
                                                          "type":  "string",
                                                          "minLength":  1,
                                                          "maxLength":  512,
                                                          "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                      }
                                        },
                       "state_sha256":  {
                                            "type":  "string",
                                            "pattern":  "^sha256:[0-9a-f]{64}$",
                                            "maxLength":  71
                                        }
                   }
}

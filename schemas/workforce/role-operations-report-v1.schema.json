{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoleOperationsReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "report_generation",
    "organization_id",
    "role_contract_id",
    "role_contract_version",
    "role_contract_sha256",
    "report_class_id",
    "reporting_obligation_id",
    "trigger_sha256",
    "measurement_window_sha256",
    "role_operations_snapshot_sha256",
    "included_metric_result_hashes",
    "included_sla_state_hashes",
    "included_breach_hashes",
    "included_escalation_hashes",
    "included_episode_hashes",
    "summary_counts",
    "data_class_ids",
    "redaction_proof_ids",
    "retention_class_id",
    "routing_class_id",
    "evidence_completeness_status",
    "evidence_ids",
    "report_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "report_generation": {
      "type": "integer",
      "minimum": 0
    },
    "organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "role_contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "role_contract_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "role_contract_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "report_class_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "reporting_obligation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "trigger_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "measurement_window_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "role_operations_snapshot_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "included_metric_result_hashes": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "included_sla_state_hashes": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "included_breach_hashes": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "included_escalation_hashes": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "included_episode_hashes": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "summary_counts": {
      "$ref": "#/$defs/RoleReportSummaryCountsV1"
    },
    "data_class_ids": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "redaction_proof_ids": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "retention_class_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "routing_class_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "evidence_completeness_status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete",
        "conflicting",
        "unsupported"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "RoleReportSummaryCountsV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_cases",
        "verified_complete_cases",
        "explicit_refusal_cases",
        "escalated_cases",
        "sla_compliant_cases",
        "sla_breached_cases",
        "human_interaction_count"
      ],
      "properties": {
        "total_cases": {
          "type": "integer",
          "minimum": 0
        },
        "verified_complete_cases": {
          "type": "integer",
          "minimum": 0
        },
        "explicit_refusal_cases": {
          "type": "integer",
          "minimum": 0
        },
        "escalated_cases": {
          "type": "integer",
          "minimum": 0
        },
        "sla_compliant_cases": {
          "type": "integer",
          "minimum": 0
        },
        "sla_breached_cases": {
          "type": "integer",
          "minimum": 0
        },
        "human_interaction_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

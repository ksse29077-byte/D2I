{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FalseCompletionReviewRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "original_terminal_case_sha256",
    "original_terminal_episode_sha256",
    "review_covered",
    "authoritative_correction_or_incident_sha256",
    "reviewer_trust_class",
    "false_completion",
    "evidence_ids",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "original_terminal_case_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "original_terminal_episode_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "review_covered": {
      "type": "boolean"
    },
    "authoritative_correction_or_incident_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewer_trust_class": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
    },
    "false_completion": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_ids": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,511}$"
      }
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

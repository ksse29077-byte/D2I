{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.example/schemas/workforce/learning-candidate-evaluation-v1.schema.json",
    "title":  "LearningCandidateEvaluationV1",
    "type":  "object",
    "required":  [
                     "schema_version",
                     "candidate_sha256",
                     "evaluation_suite_id",
                     "evaluation_input_sha256",
                     "passed",
                     "critical_error_count",
                     "metric_result_hashes",
                     "evaluated_at_unix_ms",
                     "evaluation_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "candidate_sha256":  {
                                                "type":  "string",
                                                "pattern":  "^sha256:[0-9a-f]{64}$",
                                                "maxLength":  71
                                            },
                       "evaluation_suite_id":  {
                                                   "type":  "string",
                                                   "minLength":  1,
                                                   "maxLength":  4096
                                               },
                       "evaluation_input_sha256":  {
                                                       "type":  "string",
                                                       "pattern":  "^sha256:[0-9a-f]{64}$",
                                                       "maxLength":  71
                                                   },
                       "passed":  {
                                      "type":  "boolean"
                                  },
                       "critical_error_count":  {
                                                    "type":  "integer",
                                                    "minimum":  0,
                                                    "maximum":  9007199254740991
                                                },
                       "metric_result_hashes":  {
                                                    "type":  "array",
                                                    "maxItems":  512,
                                                    "uniqueItems":  true,
                                                    "items":  {
                                                                  "type":  "string",
                                                                  "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                  "maxLength":  71
                                                              }
                                                },
                       "evaluated_at_unix_ms":  {
                                                    "type":  "integer",
                                                    "minimum":  0,
                                                    "maximum":  9007199254740991
                                                },
                       "evaluation_sha256":  {
                                                 "type":  "string",
                                                 "pattern":  "^sha256:[0-9a-f]{64}$",
                                                 "maxLength":  71
                                             }
                   },
    "additionalProperties":  false
}

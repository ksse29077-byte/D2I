{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://d2i.local/schemas/workforce/adaptive-plan-v1.schema.json", "title": "AdaptivePlanV1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "plan_id", "generation", "case_id", "goal_spec_sha256", "situation_sha256", "case_work_grant_sha256", "current_observation_sha256", "ordered_subgoals", "completed_subgoal_ids", "open_subgoal_ids", "branch_conditions", "maximum_cycles", "maximum_actions", "clarification_condition_ids", "escalation_condition_ids", "stop_condition_ids", "evidence_ids", "provider_provenance", "previous_plan_sha256", "plan_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "plan_id": {"$ref": "#/$defs/id"}, "generation": {"type": "integer", "minimum": 1}, "case_id": {"$ref": "#/$defs/id"}, "goal_spec_sha256": {"$ref": "#/$defs/hash"}, "situation_sha256": {"$ref": "#/$defs/hash"}, "case_work_grant_sha256": {"$ref": "#/$defs/hash"}, "current_observation_sha256": {"$ref": "#/$defs/hash"}, "ordered_subgoals": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/step"}}, "completed_subgoal_ids": {"$ref": "#/$defs/ids"}, "open_subgoal_ids": {"$ref": "#/$defs/non_empty_ids"}, "branch_conditions": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/branch"}}, "maximum_cycles": {"type": "integer", "minimum": 1, "maximum": 32}, "maximum_actions": {"type": "integer", "minimum": 1, "maximum": 16}, "clarification_condition_ids": {"$ref": "#/$defs/non_empty_ids"}, "escalation_condition_ids": {"$ref": "#/$defs/non_empty_ids"}, "stop_condition_ids": {"$ref": "#/$defs/non_empty_ids"}, "evidence_ids": {"$ref": "#/$defs/non_empty_ids"}, "provider_provenance": {"$ref": "#/$defs/provenance"}, "previous_plan_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "plan_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"}, "hash": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}, "ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "non_empty_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "step": {"type": "object", "additionalProperties": false, "required": ["subgoal_id", "semantic_intent", "status", "requirement_ids", "evidence_ids"], "properties": {"subgoal_id": {"$ref": "#/$defs/id"}, "semantic_intent": {"$ref": "#/$defs/id"}, "status": {"enum": ["open", "completed", "blocked"]}, "requirement_ids": {"$ref": "#/$defs/non_empty_ids"}, "evidence_ids": {"$ref": "#/$defs/non_empty_ids"}}},
    "branch": {"type": "object", "additionalProperties": false, "required": ["condition_id", "fact_predicate", "when_true_subgoal_id", "when_false_subgoal_id"], "properties": {"condition_id": {"$ref": "#/$defs/id"}, "fact_predicate": {"$ref": "#/$defs/id"}, "when_true_subgoal_id": {"$ref": "#/$defs/id"}, "when_false_subgoal_id": {"$ref": "#/$defs/id"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["provider_id", "provider_descriptor_sha256", "invocation_sha256", "result_sha256"], "properties": {"provider_id": {"$ref": "#/$defs/id"}, "provider_descriptor_sha256": {"$ref": "#/$defs/hash"}, "invocation_sha256": {"$ref": "#/$defs/hash"}, "result_sha256": {"$ref": "#/$defs/hash"}}}
  }
}

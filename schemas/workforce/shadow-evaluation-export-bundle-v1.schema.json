{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/workforce/shadow-evaluation-export-bundle-v1.schema.json",
    "title":  "ShadowEvaluationExportBundleV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "bundle_id",
                     "profile_approval_hashes",
                     "cohort_sha256",
                     "model_sha256",
                     "runtime_sha256",
                     "prompt_template_hashes",

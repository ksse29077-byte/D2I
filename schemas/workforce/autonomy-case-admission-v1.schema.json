{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/workforce/autonomy-case-admission-v1.schema.json",
    "title":  "AutonomyCaseAdmissionV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "admission_id",
                     "role_instance_sha256",
                     "autonomy_state_sha256",
                     "deployment_approval_sha256",
                     "autonomy_profile_sha256",
                     "readiness_binding_sha256",
                     "case_contract_sha256",
                     "current_case_instance_sha256",
                     "current_ownership_sha256",
                     "active_lease_sha256",
                     "work_grant_sha256",
                     "case_eligibility_sha256",
                     "allowed_autonomous_capability_ids",
                     "allowed_semantic_target_ids",
                     "maximum_risk",
                     "action_budget",
                     "model_invocation_budget",
                     "recovery_budget",
                     "issued_at_unix_ms",
                     "expires_at_unix_ms",
                     "evidence_ids",
                     "admission_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "admission_id":  {
                                            "type":  "string",
                                            "minLength":  1,
                                            "maxLength":  512,
                                            "pattern":  "^[A-Za-z0-9._:/-]+$"
                                        },
                       "role_instance_sha256":  {
                                                    "type":  "string",
                                                    "pattern":  "^sha256:[0-9a-f]{64}$",
                                                    "maxLength":  71
                                                },
                       "autonomy_state_sha256":  {
                                                     "type":  "string",
                                                     "pattern":  "^sha256:[0-9a-f]{64}$",
                                                     "maxLength":  71
                                                 },
                       "deployment_approval_sha256":  {
                                                          "type":  "string",
                                                          "pattern":  "^sha256:[0-9a-f]{64}$",
                                                          "maxLength":  71
                                                      },
                       "autonomy_profile_sha256":  {
                                                       "type":  "string",
                                                       "pattern":  "^sha256:[0-9a-f]{64}$",
                                                       "maxLength":  71
                                                   },
                       "readiness_binding_sha256":  {
                                                        "type":  "string",
                                                        "pattern":  "^sha256:[0-9a-f]{64}$",
                                                        "maxLength":  71
                                                    },
                       "case_contract_sha256":  {
                                                    "type":  "string",
                                                    "pattern":  "^sha256:[0-9a-f]{64}$",
                                                    "maxLength":  71
                                                },
                       "current_case_instance_sha256":  {
                                                            "type":  "string",
                                                            "pattern":  "^sha256:[0-9a-f]{64}$",
                                                            "maxLength":  71
                                                        },
                       "current_ownership_sha256":  {
                                                        "type":  "string",
                                                        "pattern":  "^sha256:[0-9a-f]{64}$",
                                                        "maxLength":  71
                                                    },
                       "active_lease_sha256":  {
                                                   "type":  "string",
                                                   "pattern":  "^sha256:[0-9a-f]{64}$",
                                                   "maxLength":  71
                                               },
                       "work_grant_sha256":  {
                                                 "type":  "string",
                                                 "pattern":  "^sha256:[0-9a-f]{64}$",
                                                 "maxLength":  71
                                             },
                       "case_eligibility_sha256":  {
                                                       "type":  "string",
                                                       "pattern":  "^sha256:[0-9a-f]{64}$",
                                                       "maxLength":  71
                                                   },
                       "allowed_autonomous_capability_ids":  {
                                                                 "type":  "array",
                                                                 "maxItems":  512,
                                                                 "uniqueItems":  true,
                                                                 "items":  {
                                                                               "type":  "string",
                                                                               "minLength":  1,
                                                                               "maxLength":  512,
                                                                               "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                           }
                                                             },
                       "allowed_semantic_target_ids":  {
                                                           "type":  "array",
                                                           "maxItems":  512,
                                                           "uniqueItems":  true,
                                                           "items":  {
                                                                         "type":  "string",
                                                                         "minLength":  1,
                                                                         "maxLength":  512,
                                                                         "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                     }
                                                       },
                       "maximum_risk":  {
                                            "type":  "string",
                                            "enum":  [
                                                         "read_only",
                                                         "reversible",
                                                         "business_state_change",
                                                         "high_criticality"
                                                     ]
                                        },
                       "action_budget":  {
                                             "type":  "integer",
                                             "minimum":  0,
                                             "maximum":  4294967295
                                         },
                       "model_invocation_budget":  {
                                                       "type":  "integer",
                                                       "minimum":  0,
                                                       "maximum":  4294967295
                                                   },
                       "recovery_budget":  {
                                               "type":  "integer",
                                               "minimum":  0,
                                               "maximum":  4294967295
                                           },
                       "issued_at_unix_ms":  {
                                                 "type":  "integer",
                                                 "minimum":  0,
                                                 "maximum":  18446744073709551615
                                             },
                       "expires_at_unix_ms":  {
                                                  "type":  "integer",
                                                  "minimum":  0,
                                                  "maximum":  18446744073709551615
                                              },
                       "evidence_ids":  {
                                            "type":  "array",
                                            "maxItems":  512,
                                            "uniqueItems":  true,
                                            "items":  {
                                                          "type":  "string",
                                                          "minLength":  1,
                                                          "maxLength":  512,
                                                          "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                      }
                                        },
                       "admission_sha256":  {
                                                "type":  "string",
                                                "pattern":  "^sha256:[0-9a-f]{64}$",
                                                "maxLength":  71
                                            }
                   }
}

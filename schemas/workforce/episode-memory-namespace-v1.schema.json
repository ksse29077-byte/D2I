{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.example/schemas/workforce/episode-memory-namespace-v1.schema.json",
    "title":  "EpisodeMemoryNamespaceV1",
    "type":  "object",
    "required":  [
                     "schema_version",
                     "namespace_id",
                     "organization_id",
                     "role_contract_id",
                     "role_contract_version",
                     "role_contract_sha256",
                     "role_instance_scope",
                     "memory_boundary_sha256",
                     "allowed_work_class_ids",
                     "allowed_responsibility_ids",
                     "allowed_data_class_ids",
                     "prohibited_data_class_ids",
                     "retention_class_id",
                     "maximum_retention_days",
                     "cross_case_reuse_policy",
                     "learning_candidate_allowed",
                     "maximum_episodes",
                     "maximum_store_bytes",
                     "maximum_query_results",
                     "valid_from_unix_ms",
                     "valid_to_unix_ms",
                     "evidence_ids",
                     "namespace_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "namespace_id":  {
                                            "type":  "string",
                                            "minLength":  1,
                                            "maxLength":  4096
                                        },
                       "organization_id":  {
                                               "type":  "string",
                                               "minLength":  1,
                                               "maxLength":  4096
                                           },
                       "role_contract_id":  {
                                                "type":  "string",
                                                "minLength":  1,
                                                "maxLength":  4096
                                            },
                       "role_contract_version":  {
                                                     "type":  "string",
                                                     "minLength":  1,
                                                     "maxLength":  4096
                                                 },
                       "role_contract_sha256":  {
                                                    "type":  "string",
                                                    "pattern":  "^sha256:[0-9a-f]{64}$",
                                                    "maxLength":  71
                                                },
                       "role_instance_scope":  {
                                                   "type":  "array",
                                                   "maxItems":  512,
                                                   "uniqueItems":  true,
                                                   "items":  {
                                                                 "type":  "string",
                                                                 "minLength":  1,
                                                                 "maxLength":  256
                                                             }
                                               },
                       "memory_boundary_sha256":  {
                                                      "type":  "string",
                                                      "pattern":  "^sha256:[0-9a-f]{64}$",
                                                      "maxLength":  71
                                                  },
                       "allowed_work_class_ids":  {
                                                      "type":  "array",
                                                      "maxItems":  512,
                                                      "uniqueItems":  true,
                                                      "items":  {
                                                                    "type":  "string",
                                                                    "minLength":  1,
                                                                    "maxLength":  256
                                                                }
                                                  },
                       "allowed_responsibility_ids":  {
                                                          "type":  "array",
                                                          "maxItems":  512,
                                                          "uniqueItems":  true,
                                                          "items":  {
                                                                        "type":  "string",
                                                                        "minLength":  1,
                                                                        "maxLength":  256
                                                                    }
                                                      },
                       "allowed_data_class_ids":  {
                                                      "type":  "array",
                                                      "maxItems":  512,
                                                      "uniqueItems":  true,
                                                      "items":  {
                                                                    "type":  "string",
                                                                    "minLength":  1,
                                                                    "maxLength":  256
                                                                }
                                                  },
                       "prohibited_data_class_ids":  {
                                                         "type":  "array",
                                                         "maxItems":  512,
                                                         "uniqueItems":  true,
                                                         "items":  {
                                                                       "type":  "string",
                                                                       "minLength":  1,
                                                                       "maxLength":  256
                                                                   }
                                                     },
                       "retention_class_id":  {
                                                  "type":  "string",
                                                  "minLength":  1,
                                                  "maxLength":  4096
                                              },
                       "maximum_retention_days":  {
                                                      "type":  "integer",
                                                      "minimum":  0,
                                                      "maximum":  9007199254740991
                                                  },
                       "cross_case_reuse_policy":  {
                                                       "enum":  [
                                                                    "forbidden",
                                                                    "hash_reference_only",
                                                                    "approved_summary_only"
                                                                ]
                                                   },
                       "learning_candidate_allowed":  {
                                                          "type":  "boolean"
                                                      },
                       "maximum_episodes":  {
                                                "type":  "integer",
                                                "minimum":  0,
                                                "maximum":  9007199254740991
                                            },
                       "maximum_store_bytes":  {
                                                   "type":  "integer",
                                                   "minimum":  0,
                                                   "maximum":  9007199254740991
                                               },
                       "maximum_query_results":  {
                                                     "type":  "integer",
                                                     "minimum":  0,
                                                     "maximum":  9007199254740991
                                                 },
                       "valid_from_unix_ms":  {
                                                  "type":  "integer",
                                                  "minimum":  0,
                                                  "maximum":  9007199254740991
                                              },
                       "valid_to_unix_ms":  {
                                                "type":  "integer",
                                                "minimum":  0,
                                                "maximum":  9007199254740991
                                            },
                       "evidence_ids":  {
                                            "type":  "array",
                                            "maxItems":  512,
                                            "uniqueItems":  true,
                                            "items":  {
                                                          "type":  "string",
                                                          "minLength":  1,
                                                          "maxLength":  256
                                                      }
                                        },
                       "namespace_sha256":  {
                                                "type":  "string",
                                                "pattern":  "^sha256:[0-9a-f]{64}$",
                                                "maxLength":  71
                                            }
                   },
    "additionalProperties":  false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.example/schemas/workforce/work-source-approval-v1.schema.json",
  "title": "WorkSourceApprovalV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_approval_id",
    "organization_id",
    "role_contract_id",
    "role_contract_sha256",
    "role_instance_id",
    "role_instance_sha256",
    "role_approval_sha256",
    "delegation_sha256",
    "registration_id",
    "registration_sha256",
    "approved_by_actor_id",
    "signer_key_id",
    "issued_at_unix_seconds",
    "expires_at_unix_seconds",
    "evidence_ids",
    "approval_signature",
    "source_approval_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source_approval_id": { "$ref": "#/$defs/id" },
    "organization_id": { "$ref": "#/$defs/id" },
    "role_contract_id": { "$ref": "#/$defs/id" },
    "role_contract_sha256": { "$ref": "#/$defs/hash" },
    "role_instance_id": { "$ref": "#/$defs/id" },
    "role_instance_sha256": { "$ref": "#/$defs/hash" },
    "role_approval_sha256": { "$ref": "#/$defs/hash" },
    "delegation_sha256": { "$ref": "#/$defs/hash" },
    "registration_id": { "$ref": "#/$defs/id" },
    "registration_sha256": { "$ref": "#/$defs/hash" },
    "approved_by_actor_id": { "$ref": "#/$defs/id" },
    "signer_key_id": { "$ref": "#/$defs/id" },
    "issued_at_unix_seconds": { "type": "integer", "minimum": 1 },
    "expires_at_unix_seconds": { "type": "integer", "minimum": 2 },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "approval_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "source_approval_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*(?:^|[._:-])(all|any)(?:$|[._:-]))(?!.*\\*)[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://d2i.local/schemas/workforce/model-e2e-report-v1.schema.json", "title": "ModelE2eReportV1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "e2e_id", "provider_descriptor_sha256", "model_loaded", "inference_completed", "actual_windows_execution", "actual_action_cycle_count", "fresh_observation_count", "path_a", "path_b", "paths_diverged", "verified_case_closure", "residual_process_count", "residual_activation_count", "residual_credential_count", "product_intelligence_evidence", "evaluation_report_sha256", "protected_audit_terminal_sha256", "evidence_ids", "report_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "e2e_id": {"$ref": "#/$defs/id"}, "provider_descriptor_sha256": {"$ref": "#/$defs/hash"}, "model_loaded": {"type": "boolean"}, "inference_completed": {"type": "boolean"}, "actual_windows_execution": {"type": "boolean"}, "actual_action_cycle_count": {"type": "integer", "minimum": 2, "maximum": 64}, "fresh_observation_count": {"type": "integer", "minimum": 3, "maximum": 256}, "path_a": {"$ref": "#/$defs/path"}, "path_b": {"$ref": "#/$defs/path"}, "paths_diverged": {"type": "boolean"}, "verified_case_closure": {"type": "boolean"}, "residual_process_count": {"type": "integer", "minimum": 0}, "residual_activation_count": {"type": "integer", "minimum": 0}, "residual_credential_count": {"type": "integer", "minimum": 0}, "product_intelligence_evidence": {"type": "boolean"}, "evaluation_report_sha256": {"$ref": "#/$defs/hash"}, "protected_audit_terminal_sha256": {"$ref": "#/$defs/hash"}, "evidence_ids": {"$ref": "#/$defs/ids"}, "report_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"}, "text": {"type": "string", "minLength": 1, "maxLength": 2048}, "hash": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}, "ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "path": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/text"}}}
}

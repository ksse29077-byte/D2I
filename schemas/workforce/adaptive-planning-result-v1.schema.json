{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://d2i.local/schemas/workforce/adaptive-planning-result-v1.schema.json", "title": "AdaptivePlanningResultV1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "provider_result_sha256", "plan", "candidates", "outcome", "reason_codes", "result_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "request_id": {"$ref": "#/$defs/id"}, "provider_result_sha256": {"$ref": "#/$defs/hash"}, "plan": {"oneOf": [{"$ref": "adaptive-plan-v1.schema.json"}, {"type": "null"}]}, "candidates": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/candidate"}}, "outcome": {"$ref": "#/$defs/outcome"}, "reason_codes": {"$ref": "#/$defs/reasons"}, "result_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"}, "hash": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}, "outcome": {"enum": ["continue", "verified_case_complete", "clarification_required", "escalation_required", "unsupported", "unsafe", "budget_exhausted", "provider_unavailable", "provider_output_invalid", "no_eligible_action", "conflicting_situation"]}, "reasons": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"enum": ["ambiguous_objective", "authority_expansion", "conflicting_evidence", "conflicting_objective", "credential_requested", "insufficient_evidence", "invalid_output", "irreversible_requested", "missing_scope", "missing_success_criteria", "missing_value", "no_eligible_action", "policy_unknown", "prompt_injection", "provider_unavailable", "resource_limit", "stale_input", "unsupported_locale", "unsupported_operation"]}},
    "candidate": {"$ref": "#/$defs/candidate_closed"},
    "candidate_closed": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "plan_generation", "subgoal_id", "semantic_intent", "semantic_target_id", "capability_id", "approved_value_sha256", "required_precondition_ids", "expected_postcondition_ids", "risk_estimate", "reversibility", "information_gathering", "clarification", "escalation", "verify_only", "confidence_millionths", "uncertainty_reason_codes", "evidence_refs", "candidate_sha256"], "properties": {"candidate_id": {"$ref": "#/$defs/id"}, "plan_generation": {"type": "integer", "minimum": 1}, "subgoal_id": {"$ref": "#/$defs/id"}, "semantic_intent": {"$ref": "#/$defs/id"}, "semantic_target_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "capability_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "approved_value_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "required_precondition_ids": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/id"}}, "expected_postcondition_ids": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/id"}}, "risk_estimate": {"enum": ["read_only", "reversible", "business_state_change", "high_criticality"]}, "reversibility": {"enum": ["reversible", "irreversible"]}, "information_gathering": {"type": "boolean"}, "clarification": {"type": "boolean"}, "escalation": {"type": "boolean"}, "verify_only": {"type": "boolean"}, "confidence_millionths": {"type": "integer", "minimum": 0, "maximum": 1000000}, "uncertainty_reason_codes": {"$ref": "#/$defs/reasons"}, "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/id"}}, "candidate_sha256": {"$ref": "#/$defs/hash"}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.example/schemas/workforce/episode-seal-decision-v1.schema.json",
  "title": "EpisodeSealDecisionV1",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "status",
    "failure_code",
    "episode_id",
    "episode_sha256",
    "authoritative_heads_sha256",
    "decision_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "status": { "enum": ["sealed", "exact_duplicate", "rejected"] },
    "failure_code": {
      "enum": [
        "none",
        "non_terminal",
        "source_mismatch",
        "stale_ledger",
        "policy_denied",
        "sensitive_data",
        "integrity_conflict",
        "resource_limit"
      ]
    },
    "episode_id": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "episode_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71 },
    "authoritative_heads_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71 },
    "decision_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "maxLength": 71 }
  },
  "additionalProperties": false
}

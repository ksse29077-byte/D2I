{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.example/schemas/workforce/episode-index-entry-v1.schema.json",
    "title":  "EpisodeIndexEntryV1",
    "type":  "object",
    "required":  [
                     "episode_id",
                     "episode_sha256",
                     "terminal_outcome",
                     "work_class_id",
                     "responsibility_id",
                     "terminal_at_unix_ms",
                     "data_class_ids",
                     "evidence_sha256",
                     "retention_status",
                     "approved_summary_sha256",
                     "entry_sha256"
                 ],
    "properties":  {
                       "episode_id":  {
                                          "type":  "string",
                                          "minLength":  1,
                                          "maxLength":  4096
                                      },
                       "episode_sha256":  {
                                              "type":  "string",
                                              "pattern":  "^sha256:[0-9a-f]{64}$",
                                              "maxLength":  71
                                          },
                       "terminal_outcome":  {
                                                "enum":  [
                                                             "verified_complete",
                                                             "explicit_refusal",
                                                             "escalated"
                                                         ]
                                            },
                       "work_class_id":  {
                                             "type":  "string",
                                             "minLength":  1,
                                             "maxLength":  4096
                                         },
                       "responsibility_id":  {
                                                 "type":  "string",
                                                 "minLength":  1,
                                                 "maxLength":  4096
                                             },
                       "terminal_at_unix_ms":  {
                                                   "type":  "integer",
                                                   "minimum":  0,
                                                   "maximum":  9007199254740991
                                               },
                       "data_class_ids":  {
                                              "type":  "array",
                                              "maxItems":  512,
                                              "uniqueItems":  true,
                                              "items":  {
                                                            "type":  "string",
                                                            "minLength":  1,
                                                            "maxLength":  256
                                                        }
                                          },
                       "evidence_sha256":  {
                                               "type":  "string",
                                               "pattern":  "^sha256:[0-9a-f]{64}$",
                                               "maxLength":  71
                                           },
                       "retention_status":  {
                                                "enum":  [
                                                             "active",
                                                             "held",
                                                             "expired",
                                                             "tombstoned",
                                                             "purged"
                                                         ]
                                            },
                       "approved_summary_sha256":  {
                                                       "anyOf":  [
                                                                     {
                                                                         "type":  "string",
                                                                         "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                         "maxLength":  71
                                                                     },
                                                                     {
                                                                         "type":  "null"
                                                                     }
                                                                 ]
                                                   },
                       "entry_sha256":  {
                                            "type":  "string",
                                            "pattern":  "^sha256:[0-9a-f]{64}$",
                                            "maxLength":  71
                                        }
                   },
    "additionalProperties":  false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://d2i.local/schemas/workforce/adaptive-planning-request-v1.schema.json", "title": "AdaptivePlanningRequestV1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "case_id", "goal_spec_sha256", "situation_sha256", "case_work_grant_sha256", "lease_sha256", "ownership_state_sha256", "current_observation_sha256", "plan_generation", "previous_plan_sha256", "open_subgoal_ids", "completed_subgoal_ids", "allowed_semantic_target_ids", "allowed_capability_ids", "forbidden_capability_ids", "approved_value_sha256s", "allowed_precondition_ids", "allowed_postcondition_ids", "risk_ceiling", "minimum_confidence_millionths", "maximum_candidates", "maximum_cycles", "maximum_actions", "trusted_time_unix_seconds", "evidence_ids", "request_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "request_id": {"$ref": "#/$defs/id"}, "case_id": {"$ref": "#/$defs/id"}, "goal_spec_sha256": {"$ref": "#/$defs/hash"}, "situation_sha256": {"$ref": "#/$defs/hash"}, "case_work_grant_sha256": {"$ref": "#/$defs/hash"}, "lease_sha256": {"$ref": "#/$defs/hash"}, "ownership_state_sha256": {"$ref": "#/$defs/hash"}, "current_observation_sha256": {"$ref": "#/$defs/hash"}, "plan_generation": {"type": "integer", "minimum": 1}, "previous_plan_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "open_subgoal_ids": {"$ref": "#/$defs/non_empty_ids"}, "completed_subgoal_ids": {"$ref": "#/$defs/ids"}, "allowed_semantic_target_ids": {"$ref": "#/$defs/non_empty_ids"}, "allowed_capability_ids": {"$ref": "#/$defs/non_empty_ids"}, "forbidden_capability_ids": {"$ref": "#/$defs/non_empty_ids"}, "approved_value_sha256s": {"$ref": "#/$defs/hashes"}, "allowed_precondition_ids": {"$ref": "#/$defs/non_empty_ids"}, "allowed_postcondition_ids": {"$ref": "#/$defs/non_empty_ids"}, "risk_ceiling": {"enum": ["read_only", "reversible", "business_state_change", "high_criticality"]}, "minimum_confidence_millionths": {"type": "integer", "minimum": 0, "maximum": 1000000}, "maximum_candidates": {"type": "integer", "minimum": 1, "maximum": 16}, "maximum_cycles": {"type": "integer", "minimum": 1, "maximum": 32}, "maximum_actions": {"type": "integer", "minimum": 1, "maximum": 16}, "trusted_time_unix_seconds": {"type": "integer", "minimum": 1}, "evidence_ids": {"$ref": "#/$defs/non_empty_ids"}, "request_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"}, "hash": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}, "hashes": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}}, "ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "non_empty_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}
}

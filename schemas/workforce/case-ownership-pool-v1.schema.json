{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://d2i.invalid/schemas/workforce/case-ownership-pool-v1.schema.json", "title": "CaseOwnershipPoolV1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "pool_id", "pool_version", "organization_id", "role_contract_id", "role_version", "role_contract_sha256", "members", "allowed_work_class_ids", "allowed_responsibility_ids", "allowed_application_pack_ids", "allowed_integration_ids", "allowed_capability_ids", "maximum_risk", "automatic_reassignment_reasons", "maximum_concurrent_leases_per_role", "valid_from_unix_seconds", "expires_at_unix_seconds", "signer_id", "signer_key_id", "evidence_ids", "approval_signature", "pool_sha256"],
  "properties": {
    "schema_version": { "const": 1 }, "pool_id": { "$ref": "#/$defs/id" }, "pool_version": { "$ref": "#/$defs/id" }, "organization_id": { "$ref": "#/$defs/id" }, "role_contract_id": { "$ref": "#/$defs/id" }, "role_version": { "$ref": "#/$defs/id" }, "role_contract_sha256": { "$ref": "#/$defs/hash" },
    "members": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/member" } },
    "allowed_work_class_ids": { "$ref": "#/$defs/ids" }, "allowed_responsibility_ids": { "$ref": "#/$defs/ids" }, "allowed_application_pack_ids": { "$ref": "#/$defs/ids" }, "allowed_integration_ids": { "$ref": "#/$defs/ids" }, "allowed_capability_ids": { "$ref": "#/$defs/ids" },
    "maximum_risk": { "enum": ["read_only", "reversible", "business_state_change", "high_criticality"] }, "automatic_reassignment_reasons": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "enum": ["coordinator_recovery", "lease_recovery", "owner_capacity_exhausted", "owner_expired", "owner_revoked", "owner_suspended"] } },
    "maximum_concurrent_leases_per_role": { "type": "integer", "minimum": 1, "maximum": 128 }, "valid_from_unix_seconds": { "type": "integer", "minimum": 1 }, "expires_at_unix_seconds": { "type": "integer", "minimum": 1 }, "signer_id": { "$ref": "#/$defs/id" }, "signer_key_id": { "$ref": "#/$defs/id" }, "evidence_ids": { "$ref": "#/$defs/evidence" }, "approval_signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }, "pool_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?!\\*$)(?!all$)(?!any$)[A-Za-z0-9._:/-]+$" }, "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "ids": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "evidence": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "member": { "type": "object", "additionalProperties": false, "required": ["role_instance_id", "role_instance_sha256", "delegation_sha256", "allowed_work_class_ids", "allowed_responsibility_ids", "allowed_application_pack_ids", "allowed_integration_ids", "allowed_capability_ids", "active", "expires_at_unix_seconds", "ownership_expires_at_unix_seconds", "active_lease_count", "non_terminal_case_count"], "properties": { "role_instance_id": { "$ref": "#/$defs/id" }, "role_instance_sha256": { "$ref": "#/$defs/hash" }, "delegation_sha256": { "$ref": "#/$defs/hash" }, "allowed_work_class_ids": { "$ref": "#/$defs/ids" }, "allowed_responsibility_ids": { "$ref": "#/$defs/ids" }, "allowed_application_pack_ids": { "$ref": "#/$defs/ids" }, "allowed_integration_ids": { "$ref": "#/$defs/ids" }, "allowed_capability_ids": { "$ref": "#/$defs/ids" }, "active": { "type": "boolean" }, "expires_at_unix_seconds": { "type": "integer", "minimum": 1 }, "ownership_expires_at_unix_seconds": { "type": "integer", "minimum": 1 }, "active_lease_count": { "type": "integer", "minimum": 0 }, "non_terminal_case_count": { "type": "integer", "minimum": 0 } } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://d2i.local/schemas/workforce/model-evaluation-report-v1.schema.json", "title": "ModelEvaluationReportV1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "provider_descriptor_sha256", "holdout_bundle_sha256", "goal_case_count", "situation_case_count", "planning_case_count", "adversarial_case_count", "unlabeled_natural_language_count", "metrics", "schema_invalid_accepted_output_count", "forbidden_capability_execution_count", "authority_elevation_count", "secret_leakage_count", "unverified_completion_count", "wrong_case_action_count", "stale_plan_execution_count", "passed", "evidence_ids", "report_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "evaluation_id": {"$ref": "#/$defs/id"}, "provider_descriptor_sha256": {"$ref": "#/$defs/hash"}, "holdout_bundle_sha256": {"$ref": "#/$defs/hash"}, "goal_case_count": {"type": "integer", "minimum": 20, "maximum": 10000}, "situation_case_count": {"type": "integer", "minimum": 20, "maximum": 10000}, "planning_case_count": {"type": "integer", "minimum": 10, "maximum": 10000}, "adversarial_case_count": {"type": "integer", "minimum": 10, "maximum": 10000}, "unlabeled_natural_language_count": {"type": "integer", "minimum": 20, "maximum": 10000}, "metrics": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/metric"}}, "schema_invalid_accepted_output_count": {"type": "integer", "minimum": 0}, "forbidden_capability_execution_count": {"type": "integer", "minimum": 0}, "authority_elevation_count": {"type": "integer", "minimum": 0}, "secret_leakage_count": {"type": "integer", "minimum": 0}, "unverified_completion_count": {"type": "integer", "minimum": 0}, "wrong_case_action_count": {"type": "integer", "minimum": 0}, "stale_plan_execution_count": {"type": "integer", "minimum": 0}, "passed": {"type": "boolean"}, "evidence_ids": {"$ref": "#/$defs/ids"}, "report_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"}, "hash": {"type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$"}, "ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "metric": {"type": "object", "additionalProperties": false, "required": ["metric_id", "numerator", "denominator", "value_millionths", "threshold_millionths", "passed"], "properties": {"metric_id": {"$ref": "#/$defs/id"}, "numerator": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 1}, "value_millionths": {"type": "integer", "minimum": 0, "maximum": 1000000}, "threshold_millionths": {"type": "integer", "minimum": 0, "maximum": 1000000}, "passed": {"type": "boolean"}}}}
}

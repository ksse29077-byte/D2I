{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/presentation/presentation-table-spec-v1.schema.json",
    "title":  "PresentationTableSpecV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "table_id",
                     "slot",
                     "column_labels",
                     "row_labels",
                     "fact_ids"
                 ],
    "properties":  {
                       "table_id":  {
                                        "type":  "string",
                                        "minLength":  1,
                                        "maxLength":  512,
                                        "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                    },
                       "slot":  {
                                    "type":  "string",
                                    "enum":  [
                                                 "title",
                                                 "body",
                                                 "body_left",
                                                 "body_right",
                                                 "hero",
                                                 "table_main",
                                                 "chart_main",
                                                 "footer"
                                             ]
                                },
                       "column_labels":  {
                                             "type":  "array",
                                             "minItems":  1,
                                             "maxItems":  32,
                                             "uniqueItems":  false,
                                             "items":  {
                                                           "type":  "string",
                                                           "minLength":  1,
                                                           "maxLength":  128
                                                       }
                                         },
                       "row_labels":  {
                                          "type":  "array",
                                          "minItems":  1,
                                          "maxItems":  128,
                                          "uniqueItems":  false,
                                          "items":  {
                                                        "type":  "string",
                                                        "minLength":  1,
                                                        "maxLength":  128
                                                    }
                                      },
                       "fact_ids":  {
                                        "type":  "array",
                                        "minItems":  1,
                                        "maxItems":  256,
                                        "uniqueItems":  false,
                                        "items":  {
                                                      "type":  "string",
                                                      "minLength":  1,
                                                      "maxLength":  512,
                                                      "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                  }
                                    }
                   }
}

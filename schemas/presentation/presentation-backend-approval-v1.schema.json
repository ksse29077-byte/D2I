{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/presentation/presentation-backend-approval-v1.schema.json",
    "title":  "PresentationBackendApprovalV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "approval_id",
                     "organization_id",
                     "backend_descriptor_sha256",
                     "capability_pack_sha256",
                     "workspace_profile_sha256",
                     "approved_operation_ids",
                     "application_executable_sha256",
                     "issued_at_unix_ms",
                     "expires_at_unix_ms",
                     "signer_id",
                     "signing_key_id",
                     "signature_hex",
                     "approval_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "approval_id":  {
                                           "type":  "string",
                                           "minLength":  1,
                                           "maxLength":  512,
                                           "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                       },
                       "organization_id":  {
                                               "type":  "string",
                                               "minLength":  1,
                                               "maxLength":  512,
                                               "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                           },
                       "backend_descriptor_sha256":  {
                                                         "type":  "string",
                                                         "pattern":  "^sha256:[0-9a-f]{64}$"
                                                     },
                       "capability_pack_sha256":  {
                                                      "type":  "string",
                                                      "pattern":  "^sha256:[0-9a-f]{64}$"
                                                  },
                       "workspace_profile_sha256":  {
                                                        "type":  "string",
                                                        "pattern":  "^sha256:[0-9a-f]{64}$"
                                                    },
                       "approved_operation_ids":  {
                                                      "type":  "array",
                                                      "minItems":  1,
                                                      "maxItems":  32,
                                                      "uniqueItems":  true,
                                                      "items":  {
                                                                    "type":  "string",
                                                                    "minLength":  1,
                                                                    "maxLength":  512,
                                                                    "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                }
                                                  },
                       "application_executable_sha256":  {
                                                             "oneOf":  [
                                                                           {
                                                                               "type":  "string",
                                                                               "pattern":  "^sha256:[0-9a-f]{64}$"
                                                                           },
                                                                           {
                                                                               "type":  "null"
                                                                           }
                                                                       ]
                                                         },
                       "issued_at_unix_ms":  {
                                                 "type":  "integer",
                                                 "minimum":  0
                                             },
                       "expires_at_unix_ms":  {
                                                  "type":  "integer",
                                                  "minimum":  0
                                              },
                       "signer_id":  {
                                         "type":  "string",
                                         "minLength":  1,
                                         "maxLength":  512,
                                         "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                     },
                       "signing_key_id":  {
                                              "type":  "string",
                                              "minLength":  1,
                                              "maxLength":  512,
                                              "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                          },
                       "signature_hex":  {
                                             "type":  "string",
                                             "pattern":  "^[0-9a-fA-F]{128}$"
                                         },
                       "approval_sha256":  {
                                               "type":  "string",
                                               "pattern":  "^sha256:[0-9a-f]{64}$"
                                           }
                   }
}

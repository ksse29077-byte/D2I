{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/presentation/presentation-query-v1.schema.json",
    "title":  "PresentationQueryV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "query_id",
                     "case_id",
                     "presentation_snapshot_sha256",
                     "plan",
                     "maximum_results",
                     "issued_at_unix_ms",
                     "expires_at_unix_ms",
                     "evidence_ids",
                     "query_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "query_id":  {
                                        "type":  "string",
                                        "minLength":  1,
                                        "maxLength":  512,
                                        "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                    },
                       "case_id":  {
                                       "type":  "string",
                                       "minLength":  1,
                                       "maxLength":  512,
                                       "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                   },
                       "presentation_snapshot_sha256":  {
                                                            "type":  "string",
                                                            "pattern":  "^sha256:[0-9a-f]{64}$"
                                                        },
                       "plan":  {
                                    "oneOf":  [
                                                  {
                                                      "type":  "object",
                                                      "additionalProperties":  false,
                                                      "required":  [
                                                                       "query_kind",
                                                                       "purpose_ids"
                                                                   ],
                                                      "properties":  {
                                                                         "query_kind":  {
                                                                                            "const":  "find_slides_by_purpose"
                                                                                        },
                                                                         "purpose_ids":  {
                                                                                             "type":  "array",
                                                                                             "minItems":  1,
                                                                                             "maxItems":  32,
                                                                                             "uniqueItems":  true,
                                                                                             "items":  {
                                                                                                           "type":  "string",
                                                                                                           "minLength":  1,
                                                                                                           "maxLength":  512,
                                                                                                           "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                                                       }
                                                                                         }
                                                                     }
                                                  },
                                                  {
                                                      "type":  "object",
                                                      "additionalProperties":  false,
                                                      "required":  [
                                                                       "query_kind",
                                                                       "title_terms"
                                                                   ],
                                                      "properties":  {
                                                                         "query_kind":  {
                                                                                            "const":  "find_slides_by_title"
                                                                                        },
                                                                         "title_terms":  {
                                                                                             "type":  "array",
                                                                                             "minItems":  1,
                                                                                             "maxItems":  16,
                                                                                             "uniqueItems":  true,
                                                                                             "items":  {
                                                                                                           "type":  "string",
                                                                                                           "minLength":  1,
                                                                                                           "maxLength":  128
                                                                                                       }
                                                                                         }
                                                                     }
                                                  },
                                                  {
                                                      "type":  "object",
                                                      "additionalProperties":  false,
                                                      "required":  [
                                                                       "query_kind",
                                                                       "fact_ids"
                                                                   ],
                                                      "properties":  {
                                                                         "query_kind":  {
                                                                                            "const":  "find_slides_by_content_fact"
                                                                                        },
                                                                         "fact_ids":  {
                                                                                          "type":  "array",
                                                                                          "minItems":  1,
                                                                                          "maxItems":  16,
                                                                                          "uniqueItems":  true,
                                                                                          "items":  {
                                                                                                        "type":  "string",
                                                                                                        "minLength":  1,
                                                                                                        "maxLength":  512,
                                                                                                        "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                                                    }
                                                                                      }
                                                                     }
                                                  },
                                                  {
                                                      "type":  "object",
                                                      "additionalProperties":  false,
                                                      "required":  [
                                                                       "query_kind",
                                                                       "purpose_id"
                                                                   ],
                                                      "properties":  {
                                                                         "query_kind":  {
                                                                                            "const":  "layout_candidates"
                                                                                        },
                                                                         "purpose_id":  {
                                                                                            "type":  "string",
                                                                                            "minLength":  1,
                                                                                            "maxLength":  512,
                                                                                            "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                                        }
                                                                     }
                                                  },
                                                  {
                                                      "type":  "object",
                                                      "additionalProperties":  false,
                                                      "required":  [
                                                                       "query_kind",
                                                                       "layout_ids"
                                                                   ],
                                                      "properties":  {
                                                                         "query_kind":  {
                                                                                            "const":  "template_slides"
                                                                                        },
                                                                         "layout_ids":  {
                                                                                            "type":  "array",
                                                                                            "minItems":  1,
                                                                                            "maxItems":  32,
                                                                                            "uniqueItems":  true,
                                                                                            "items":  {
                                                                                                          "type":  "string",
                                                                                                          "minLength":  1,
                                                                                                          "maxLength":  512,
                                                                                                          "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                                                      }
                                                                                        }
                                                                     }
                                                  },
                                                  {
                                                      "type":  "object",
                                                      "additionalProperties":  false,
                                                      "required":  [
                                                                       "query_kind",
                                                                       "slide_ids"
                                                                   ],
                                                      "properties":  {
                                                                         "query_kind":  {
                                                                                            "const":  "related_slides"
                                                                                        },
                                                                         "slide_ids":  {
                                                                                           "type":  "array",
                                                                                           "minItems":  1,
                                                                                           "maxItems":  32,
                                                                                           "uniqueItems":  true,
                                                                                           "items":  {
                                                                                                         "type":  "string",
                                                                                                         "minLength":  1,
                                                                                                         "maxLength":  512,
                                                                                                         "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                                                     }
                                                                                       }
                                                                     }
                                                  }
                                              ]
                                },
                       "maximum_results":  {
                                               "type":  "integer",
                                               "minimum":  0,
                                               "maximum":  32
                                           },
                       "issued_at_unix_ms":  {
                                                 "type":  "integer",
                                                 "minimum":  0
                                             },
                       "expires_at_unix_ms":  {
                                                  "type":  "integer",
                                                  "minimum":  0
                                              },
                       "evidence_ids":  {
                                            "type":  "array",
                                            "minItems":  1,
                                            "maxItems":  128,
                                            "uniqueItems":  true,
                                            "items":  {
                                                          "type":  "string",
                                                          "minLength":  1,
                                                          "maxLength":  512,
                                                          "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                      }
                                        },
                       "query_sha256":  {
                                            "type":  "string",
                                            "pattern":  "^sha256:[0-9a-f]{64}$"
                                        }
                   }
}

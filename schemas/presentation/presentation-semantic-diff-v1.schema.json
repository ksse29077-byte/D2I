{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/presentation/presentation-semantic-diff-v1.schema.json",
    "title":  "PresentationSemanticDiffV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "before_snapshot_sha256",
                     "after_snapshot_sha256",
                     "added_slide_ids",
                     "changed_slide_ids",
                     "changed_shape_ids",
                     "removed_generated_ids",
                     "unexpected_change_ids",
                     "diff_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "before_snapshot_sha256":  {
                                                      "type":  "string",
                                                      "pattern":  "^sha256:[0-9a-f]{64}$"
                                                  },
                       "after_snapshot_sha256":  {
                                                     "type":  "string",
                                                     "pattern":  "^sha256:[0-9a-f]{64}$"
                                                 },
                       "added_slide_ids":  {
                                               "type":  "array",
                                               "minItems":  0,
                                               "maxItems":  500,
                                               "uniqueItems":  true,
                                               "items":  {
                                                             "type":  "string",
                                                             "minLength":  1,
                                                             "maxLength":  512,
                                                             "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                         }
                                           },
                       "changed_slide_ids":  {
                                                 "type":  "array",
                                                 "minItems":  0,
                                                 "maxItems":  500,
                                                 "uniqueItems":  true,
                                                 "items":  {
                                                               "type":  "string",
                                                               "minLength":  1,
                                                               "maxLength":  512,
                                                               "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                           }
                                             },
                       "changed_shape_ids":  {
                                                 "type":  "array",
                                                 "minItems":  0,
                                                 "maxItems":  512,
                                                 "uniqueItems":  true,
                                                 "items":  {
                                                               "type":  "string",
                                                               "minLength":  1,
                                                               "maxLength":  512,
                                                               "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                           }
                                             },
                       "removed_generated_ids":  {
                                                     "type":  "array",
                                                     "minItems":  0,
                                                     "maxItems":  512,
                                                     "uniqueItems":  true,
                                                     "items":  {
                                                                   "type":  "string",
                                                                   "minLength":  1,
                                                                   "maxLength":  512,
                                                                   "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                               }
                                                 },
                       "unexpected_change_ids":  {
                                                     "type":  "array",
                                                     "minItems":  0,
                                                     "maxItems":  512,
                                                     "uniqueItems":  true,
                                                     "items":  {
                                                                   "type":  "string",
                                                                   "minLength":  1,
                                                                   "maxLength":  512,
                                                                   "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                               }
                                                 },
                       "diff_sha256":  {
                                           "type":  "string",
                                           "pattern":  "^sha256:[0-9a-f]{64}$"
                                       }
                   }
}

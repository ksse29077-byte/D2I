{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/presentation/presentation-capability-pack-v1.schema.json",
    "title":  "PresentationCapabilityPackV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "pack_id",
                     "pack_version",
                     "application_family_ids",
                     "supported_format_ids",
                     "semantic_operations",
                     "resource_limits",
                     "pack_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "pack_id":  {
                                       "type":  "string",
                                       "minLength":  1,
                                       "maxLength":  512,
                                       "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                   },
                       "pack_version":  {
                                            "type":  "string",
                                            "minLength":  1,
                                            "maxLength":  512,
                                            "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                        },
                       "application_family_ids":  {
                                                      "type":  "array",
                                                      "minItems":  1,
                                                      "maxItems":  16,
                                                      "uniqueItems":  true,
                                                      "items":  {
                                                                    "type":  "string",
                                                                    "minLength":  1,
                                                                    "maxLength":  512,
                                                                    "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                }
                                                  },
                       "supported_format_ids":  {
                                                    "type":  "array",
                                                    "minItems":  1,
                                                    "maxItems":  1,
                                                    "uniqueItems":  true,
                                                    "items":  {
                                                                  "type":  "string",
                                                                  "enum":  [
                                                                               "pptx"
                                                                           ]
                                                              }
                                                },
                       "semantic_operations":  {
                                                   "type":  "array",
                                                   "minItems":  1,
                                                   "maxItems":  16,
                                                   "uniqueItems":  true,
                                                   "items":  {
                                                                 "type":  "string",
                                                                 "enum":  [
                                                                              "inspect",
                                                                              "query",
                                                                              "create_from_template",
                                                                              "add_slide",
                                                                              "set_title",
                                                                              "set_text",
                                                                              "insert_image",
                                                                              "insert_table",
                                                                              "set_table_cell",
                                                                              "insert_chart",
                                                                              "apply_layout",
                                                                              "apply_style_role",
                                                                              "move_resize_shape",
                                                                              "save_version",
                                                                              "remove_generated_slide",
                                                                              "remove_generated_shape"
                                                                          ]
                                                             }
                                               },
                       "resource_limits":  {
                                               "type":  "object",
                                               "additionalProperties":  false,
                                               "required":  [
                                                                "maximum_presentation_bytes",
                                                                "maximum_package_entries",
                                                                "maximum_uncompressed_bytes",
                                                                "maximum_compression_ratio",
                                                                "maximum_xml_bytes",
                                                                "maximum_xml_depth",
                                                                "maximum_xml_nodes",
                                                                "maximum_slides",
                                                                "maximum_shapes_per_slide",
                                                                "maximum_text_characters",
                                                                "maximum_table_rows",
                                                                "maximum_table_columns",
                                                                "maximum_query_slides",
                                                                "maximum_context_slides",
                                                                "maximum_context_facts",
                                                                "maximum_context_excerpts",
                                                                "maximum_context_bytes",
                                                                "maximum_model_invocations",
                                                                "maximum_save_generations",
                                                                "maximum_worker_milliseconds",
                                                                "maximum_application_session_milliseconds",
                                                                "maximum_worker_memory_bytes"
                                                            ],
                                               "properties":  {
                                                                  "maximum_presentation_bytes":  {
                                                                                                     "type":  "integer",
                                                                                                     "minimum":  0
                                                                                                 },
                                                                  "maximum_package_entries":  {
                                                                                                  "type":  "integer",
                                                                                                  "minimum":  0,
                                                                                                  "maximum":  4294967295
                                                                                              },
                                                                  "maximum_uncompressed_bytes":  {
                                                                                                     "type":  "integer",
                                                                                                     "minimum":  0
                                                                                                 },
                                                                  "maximum_compression_ratio":  {
                                                                                                    "type":  "integer",
                                                                                                    "minimum":  0,
                                                                                                    "maximum":  4294967295
                                                                                                },
                                                                  "maximum_xml_bytes":  {
                                                                                            "type":  "integer",
                                                                                            "minimum":  0
                                                                                        },
                                                                  "maximum_xml_depth":  {
                                                                                            "type":  "integer",
                                                                                            "minimum":  0,
                                                                                            "maximum":  4294967295
                                                                                        },
                                                                  "maximum_xml_nodes":  {
                                                                                            "type":  "integer",
                                                                                            "minimum":  0,
                                                                                            "maximum":  4294967295
                                                                                        },
                                                                  "maximum_slides":  {
                                                                                         "type":  "integer",
                                                                                         "minimum":  0,
                                                                                         "maximum":  500
                                                                                     },
                                                                  "maximum_shapes_per_slide":  {
                                                                                                   "type":  "integer",
                                                                                                   "minimum":  0,
                                                                                                   "maximum":  4294967295
                                                                                               },
                                                                  "maximum_text_characters":  {
                                                                                                  "type":  "integer",
                                                                                                  "minimum":  0,
                                                                                                  "maximum":  4294967295
                                                                                              },
                                                                  "maximum_table_rows":  {
                                                                                             "type":  "integer",
                                                                                             "minimum":  0,
                                                                                             "maximum":  4294967295
                                                                                         },
                                                                  "maximum_table_columns":  {
                                                                                                "type":  "integer",
                                                                                                "minimum":  0,
                                                                                                "maximum":  4294967295
                                                                                            },
                                                                  "maximum_query_slides":  {
                                                                                               "type":  "integer",
                                                                                               "minimum":  0,
                                                                                               "maximum":  32
                                                                                           },
                                                                  "maximum_context_slides":  {
                                                                                                 "type":  "integer",
                                                                                                 "minimum":  0,
                                                                                                 "maximum":  8
                                                                                             },
                                                                  "maximum_context_facts":  {
                                                                                                "type":  "integer",
                                                                                                "minimum":  0,
                                                                                                "maximum":  16
                                                                                            },
                                                                  "maximum_context_excerpts":  {
                                                                                                   "type":  "integer",
                                                                                                   "minimum":  0,
                                                                                                   "maximum":  16
                                                                                               },
                                                                  "maximum_context_bytes":  {
                                                                                                "type":  "integer",
                                                                                                "minimum":  0,
                                                                                                "maximum":  32768
                                                                                            },
                                                                  "maximum_model_invocations":  {
                                                                                                    "type":  "integer",
                                                                                                    "minimum":  0,
                                                                                                    "maximum":  4294967295
                                                                                                },
                                                                  "maximum_save_generations":  {
                                                                                                   "type":  "integer",
                                                                                                   "minimum":  0,
                                                                                                   "maximum":  4294967295
                                                                                               },
                                                                  "maximum_worker_milliseconds":  {
                                                                                                      "type":  "integer",
                                                                                                      "minimum":  0
                                                                                                  },
                                                                  "maximum_application_session_milliseconds":  {
                                                                                                                   "type":  "integer",
                                                                                                                   "minimum":  0
                                                                                                               },
                                                                  "maximum_worker_memory_bytes":  {
                                                                                                      "type":  "integer",
                                                                                                      "minimum":  0
                                                                                                  }
                                                              }
                                           },
                       "pack_sha256":  {
                                           "type":  "string",
                                           "pattern":  "^sha256:[0-9a-f]{64}$"
                                       }
                   }
}

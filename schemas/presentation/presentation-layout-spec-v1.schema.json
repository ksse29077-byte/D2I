{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/presentation/presentation-layout-spec-v1.schema.json",
    "title":  "PresentationLayoutSpecV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "layout_id",
                     "required_slots",
                     "minimum_font_points"
                 ],
    "properties":  {
                       "layout_id":  {
                                         "type":  "string",
                                         "minLength":  1,
                                         "maxLength":  512,
                                         "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                     },
                       "required_slots":  {
                                              "type":  "array",
                                              "minItems":  1,
                                              "maxItems":  8,
                                              "uniqueItems":  true,
                                              "items":  {
                                                            "type":  "string",
                                                            "enum":  [
                                                                         "title",
                                                                         "body",
                                                                         "body_left",
                                                                         "body_right",
                                                                         "hero",
                                                                         "table_main",
                                                                         "chart_main",
                                                                         "footer"
                                                                     ]
                                                        }
                                          },
                       "minimum_font_points":  {
                                                   "type":  "integer",
                                                   "minimum":  8,
                                                   "maximum":  96
                                               }
                   }
}

{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/presentation/presentation-provenance-v1.schema.json",
    "title":  "PresentationProvenanceV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "artifact_id",
                     "source_template_sha256",
                     "source_workbook_snapshot_sha256",
                     "fact_binding_sha256",
                     "context_slice_sha256",
                     "slide_plan_sha256",
                     "operation_receipt_sha256s",
                     "provenance_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "artifact_id":  {
                                           "type":  "string",
                                           "minLength":  1,
                                           "maxLength":  512,
                                           "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                       },
                       "source_template_sha256":  {
                                                      "type":  "string",
                                                      "pattern":  "^sha256:[0-9a-f]{64}$"
                                                  },
                       "source_workbook_snapshot_sha256":  {
                                                               "type":  "string",
                                                               "pattern":  "^sha256:[0-9a-f]{64}$"
                                                           },
                       "fact_binding_sha256":  {
                                                   "type":  "string",
                                                   "pattern":  "^sha256:[0-9a-f]{64}$"
                                               },
                       "context_slice_sha256":  {
                                                    "type":  "string",
                                                    "pattern":  "^sha256:[0-9a-f]{64}$"
                                                },
                       "slide_plan_sha256":  {
                                                 "type":  "string",
                                                 "pattern":  "^sha256:[0-9a-f]{64}$"
                                             },
                       "operation_receipt_sha256s":  {
                                                         "type":  "array",
                                                         "minItems":  1,
                                                         "maxItems":  128,
                                                         "uniqueItems":  true,
                                                         "items":  {
                                                                       "type":  "string",
                                                                       "pattern":  "^sha256:[0-9a-f]{64}$"
                                                                   }
                                                     },
                       "provenance_sha256":  {
                                                 "type":  "string",
                                                 "pattern":  "^sha256:[0-9a-f]{64}$"
                                             }
                   }
}

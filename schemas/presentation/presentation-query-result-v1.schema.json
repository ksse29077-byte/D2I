{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/presentation/presentation-query-result-v1.schema.json",
    "title":  "PresentationQueryResultV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "query_id",
                     "query_sha256",
                     "presentation_snapshot_sha256",
                     "scanned_slides",
                     "matches",
                     "complete",
                     "result_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "query_id":  {
                                        "type":  "string",
                                        "minLength":  1,
                                        "maxLength":  512,
                                        "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                    },
                       "query_sha256":  {
                                            "type":  "string",
                                            "pattern":  "^sha256:[0-9a-f]{64}$"
                                        },
                       "presentation_snapshot_sha256":  {
                                                            "type":  "string",
                                                            "pattern":  "^sha256:[0-9a-f]{64}$"
                                                        },
                       "scanned_slides":  {
                                              "type":  "integer",
                                              "minimum":  0,
                                              "maximum":  500
                                          },
                       "matches":  {
                                       "type":  "array",
                                       "minItems":  0,
                                       "maxItems":  32,
                                       "uniqueItems":  false,
                                       "items":  {
                                                     "type":  "object",
                                                     "additionalProperties":  false,
                                                     "required":  [
                                                                      "slide_id",
                                                                      "ordinal",
                                                                      "purpose_id",
                                                                      "layout_id",
                                                                      "relevance_millionths",
                                                                      "evidence_ids"
                                                                  ],
                                                     "properties":  {
                                                                        "slide_id":  {
                                                                                         "type":  "string",
                                                                                         "minLength":  1,
                                                                                         "maxLength":  512,
                                                                                         "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                                     },
                                                                        "ordinal":  {
                                                                                        "type":  "integer",
                                                                                        "minimum":  0,
                                                                                        "maximum":  500
                                                                                    },
                                                                        "purpose_id":  {
                                                                                           "type":  "string",
                                                                                           "minLength":  1,
                                                                                           "maxLength":  512,
                                                                                           "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                                       },
                                                                        "layout_id":  {
                                                                                          "type":  "string",
                                                                                          "minLength":  1,
                                                                                          "maxLength":  512,
                                                                                          "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                                      },
                                                                        "relevance_millionths":  {
                                                                                                     "type":  "integer",
                                                                                                     "minimum":  0,
                                                                                                     "maximum":  1000000
                                                                                                 },
                                                                        "evidence_ids":  {
                                                                                             "type":  "array",
                                                                                             "minItems":  1,
                                                                                             "maxItems":  128,
                                                                                             "uniqueItems":  true,
                                                                                             "items":  {
                                                                                                           "type":  "string",
                                                                                                           "minLength":  1,
                                                                                                           "maxLength":  512,
                                                                                                           "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                                                       }
                                                                                         }
                                                                    }
                                                 }
                                   },
                       "complete":  {
                                        "type":  "boolean"
                                    },
                       "result_sha256":  {
                                             "type":  "string",
                                             "pattern":  "^sha256:[0-9a-f]{64}$"
                                         }
                   }
}

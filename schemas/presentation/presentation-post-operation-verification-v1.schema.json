{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/presentation/presentation-post-operation-verification-v1.schema.json",
    "title":  "PresentationPostOperationVerificationV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "verification_id",
                     "binding_sha256",
                     "receipt_sha256",
                     "diff_sha256",
                     "fresh_snapshot_sha256",
                     "expected_postcondition_ids",
                     "satisfied_postcondition_ids",
                     "protected_invariant_ids",
                     "quality",
                     "status",
                     "verified_at_unix_ms",
                     "verification_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "verification_id":  {
                                               "type":  "string",
                                               "minLength":  1,
                                               "maxLength":  512,
                                               "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                           },
                       "binding_sha256":  {
                                              "type":  "string",
                                              "pattern":  "^sha256:[0-9a-f]{64}$"
                                          },
                       "receipt_sha256":  {
                                              "type":  "string",
                                              "pattern":  "^sha256:[0-9a-f]{64}$"
                                          },
                       "diff_sha256":  {
                                           "type":  "string",
                                           "pattern":  "^sha256:[0-9a-f]{64}$"
                                       },
                       "fresh_snapshot_sha256":  {
                                                     "type":  "string",
                                                     "pattern":  "^sha256:[0-9a-f]{64}$"
                                                 },
                       "expected_postcondition_ids":  {
                                                          "type":  "array",
                                                          "minItems":  1,
                                                          "maxItems":  32,
                                                          "uniqueItems":  true,
                                                          "items":  {
                                                                        "type":  "string",
                                                                        "minLength":  1,
                                                                        "maxLength":  512,
                                                                        "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                    }
                                                      },
                       "satisfied_postcondition_ids":  {
                                                           "type":  "array",
                                                           "minItems":  0,
                                                           "maxItems":  32,
                                                           "uniqueItems":  true,
                                                           "items":  {
                                                                         "type":  "string",
                                                                         "minLength":  1,
                                                                         "maxLength":  512,
                                                                         "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                     }
                                                       },
                       "protected_invariant_ids":  {
                                                       "type":  "array",
                                                       "minItems":  1,
                                                       "maxItems":  32,
                                                       "uniqueItems":  true,
                                                       "items":  {
                                                                     "type":  "string",
                                                                     "minLength":  1,
                                                                     "maxLength":  512,
                                                                     "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                 }
                                                   },
                       "quality":  {
                                       "type":  "object",
                                       "additionalProperties":  false,
                                       "required":  [
                                                        "required_slides_missing",
                                                        "required_titles_missing",
                                                        "required_facts_missing",
                                                        "empty_generated_shapes",
                                                        "placeholder_generated_shapes",
                                                        "off_slide_shapes",
                                                        "forbidden_overlaps",
                                                        "text_overflows",
                                                        "below_minimum_font_shapes",
                                                        "table_overflows",
                                                        "incomplete_charts",
                                                        "distorted_images",
                                                        "hidden_generated_objects"
                                                    ],
                                       "properties":  {
                                                          "required_slides_missing":  {
                                                                                          "type":  "integer",
                                                                                          "minimum":  0,
                                                                                          "maximum":  4294967295
                                                                                      },
                                                          "required_titles_missing":  {
                                                                                          "type":  "integer",
                                                                                          "minimum":  0,
                                                                                          "maximum":  4294967295
                                                                                      },
                                                          "required_facts_missing":  {
                                                                                         "type":  "integer",
                                                                                         "minimum":  0,
                                                                                         "maximum":  4294967295
                                                                                     },
                                                          "empty_generated_shapes":  {
                                                                                         "type":  "integer",
                                                                                         "minimum":  0,
                                                                                         "maximum":  4294967295
                                                                                     },
                                                          "placeholder_generated_shapes":  {
                                                                                               "type":  "integer",
                                                                                               "minimum":  0,
                                                                                               "maximum":  4294967295
                                                                                           },
                                                          "off_slide_shapes":  {
                                                                                   "type":  "integer",
                                                                                   "minimum":  0,
                                                                                   "maximum":  4294967295
                                                                               },
                                                          "forbidden_overlaps":  {
                                                                                     "type":  "integer",
                                                                                     "minimum":  0,
                                                                                     "maximum":  4294967295
                                                                                 },
                                                          "text_overflows":  {
                                                                                 "type":  "integer",
                                                                                 "minimum":  0,
                                                                                 "maximum":  4294967295
                                                                             },
                                                          "below_minimum_font_shapes":  {
                                                                                            "type":  "integer",
                                                                                            "minimum":  0,
                                                                                            "maximum":  4294967295
                                                                                        },
                                                          "table_overflows":  {
                                                                                  "type":  "integer",
                                                                                  "minimum":  0,
                                                                                  "maximum":  4294967295
                                                                              },
                                                          "incomplete_charts":  {
                                                                                    "type":  "integer",
                                                                                    "minimum":  0,
                                                                                    "maximum":  4294967295
                                                                                },
                                                          "distorted_images":  {
                                                                                   "type":  "integer",
                                                                                   "minimum":  0,
                                                                                   "maximum":  4294967295
                                                                               },
                                                          "hidden_generated_objects":  {
                                                                                           "type":  "integer",
                                                                                           "minimum":  0,
                                                                                           "maximum":  4294967295
                                                                                       }
                                                      }
                                   },
                       "status":  {
                                      "type":  "string",
                                      "enum":  [
                                                   "verified",
                                                   "failed",
                                                   "inconclusive",
                                                   "unsupported",
                                                   "unsafe"
                                               ]
                                  },
                       "verified_at_unix_ms":  {
                                                   "type":  "integer",
                                                   "minimum":  0
                                               },
                       "verification_sha256":  {
                                                   "type":  "string",
                                                   "pattern":  "^sha256:[0-9a-f]{64}$"
                                               }
                   }
}

{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://schemas.d2i.local/pdf/pdf-visual-fingerprint-v1.schema.json",
    "title":  "PdfVisualFingerprintV1",
    "$ref":  "#/$defs/PdfVisualFingerprintV1",
    "$defs":  {
                  "PdfVisualFingerprintV1":  {
                                                 "type":  "object",
                                                 "additionalProperties":  false,
                                                 "required":  [
                                                                  "schema_version",
                                                                  "fingerprint_id",
                                                                  "rendered_png_sha256",
                                                                  "non_white_pixel_millionths",
                                                                  "luminance_buckets",
                                                                  "color_buckets",
                                                                  "edge_buckets",
                                                                  "occupancy_buckets",
                                                                  "perceptual_hash_sha256",
                                                                  "fingerprint_sha256"
                                                              ],
                                                 "properties":  {
                                                                    "schema_version":  {
                                                                                           "type":  "integer",
                                                                                           "minimum":  0,
                                                                                           "maximum":  4294967295
                                                                                       },
                                                                    "fingerprint_id":  {
                                                                                           "type":  "string",
                                                                                           "minLength":  1,
                                                                                           "maxLength":  512,
                                                                                           "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                                       },
                                                                    "rendered_png_sha256":  {
                                                                                                "type":  "string",
                                                                                                "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                "maxLength":  71
                                                                                            },
                                                                    "non_white_pixel_millionths":  {
                                                                                                       "type":  "integer",
                                                                                                       "minimum":  0,
                                                                                                       "maximum":  4294967295
                                                                                                   },
                                                                    "luminance_buckets":  {
                                                                                              "type":  "array",
                                                                                              "maxItems":  4096,
                                                                                              "items":  {
                                                                                                            "type":  "integer",
                                                                                                            "minimum":  0,
                                                                                                            "maximum":  4294967295
                                                                                                        }
                                                                                          },
                                                                    "color_buckets":  {
                                                                                          "type":  "array",
                                                                                          "maxItems":  4096,
                                                                                          "items":  {
                                                                                                        "type":  "integer",
                                                                                                        "minimum":  0,
                                                                                                        "maximum":  4294967295
                                                                                                    }
                                                                                      },
                                                                    "edge_buckets":  {
                                                                                         "type":  "array",
                                                                                         "maxItems":  4096,
                                                                                         "items":  {
                                                                                                       "type":  "integer",
                                                                                                       "minimum":  0,
                                                                                                       "maximum":  4294967295
                                                                                                   }
                                                                                     },
                                                                    "occupancy_buckets":  {
                                                                                              "type":  "array",
                                                                                              "maxItems":  4096,
                                                                                              "items":  {
                                                                                                            "type":  "integer",
                                                                                                            "minimum":  0,
                                                                                                            "maximum":  4294967295
                                                                                                        }
                                                                                          },
                                                                    "perceptual_hash_sha256":  {
                                                                                                   "type":  "string",
                                                                                                   "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                   "maxLength":  71
                                                                                               },
                                                                    "fingerprint_sha256":  {
                                                                                               "type":  "string",
                                                                                               "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                               "maxLength":  71
                                                                                           }
                                                                }
                                             }
              }
}

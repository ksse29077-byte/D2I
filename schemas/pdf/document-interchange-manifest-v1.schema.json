{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://schemas.d2i.local/pdf/document-interchange-manifest-v1.schema.json",
    "title":  "DocumentInterchangeManifestV1",
    "$ref":  "#/$defs/DocumentInterchangeManifestV1",
    "$defs":  {
                  "PdfSourceFormatV1":  {
                                            "type":  "string",
                                            "enum":  [
                                                         "docx",
                                                         "xlsx",
                                                         "pptx",
                                                         "hwpx",
                                                         "external_pdf"
                                                     ]
                                        },
                  "DocumentInterchangeManifestV1":  {
                                                        "type":  "object",
                                                        "additionalProperties":  false,
                                                        "required":  [
                                                                         "schema_version",
                                                                         "manifest_id",
                                                                         "organization_id",
                                                                         "source_format",
                                                                         "source_artifact_id",
                                                                         "source_artifact_sha256",
                                                                         "source_snapshot_sha256",
                                                                         "pdf_artifact_sha256",
                                                                         "pdf_artifact_id",
                                                                         "source_filename",
                                                                         "pdf_filename",
                                                                         "source_mime_type",
                                                                         "pdf_mime_type",
                                                                         "final_artifact_pair_sha256",
                                                                         "finalization_seal_sha256",
                                                                         "lineage_evidence_sha256s",
                                                                         "manifest_sha256"
                                                                     ],
                                                        "properties":  {
                                                                           "schema_version":  {
                                                                                                  "type":  "integer",
                                                                                                  "minimum":  0,
                                                                                                  "maximum":  4294967295
                                                                                              },
                                                                           "manifest_id":  {
                                                                                               "type":  "string",
                                                                                               "minLength":  1,
                                                                                               "maxLength":  512,
                                                                                               "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                                           },
                                                                           "organization_id":  {
                                                                                                   "type":  "string",
                                                                                                   "minLength":  1,
                                                                                                   "maxLength":  512,
                                                                                                   "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                                               },
                                                                           "source_format":  {
                                                                                                 "$ref":  "#/$defs/PdfSourceFormatV1"
                                                                                             },
                                                                           "source_artifact_id":  {
                                                                                                      "type":  "string",
                                                                                                      "minLength":  1,
                                                                                                      "maxLength":  512,
                                                                                                      "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                                                  },
                                                                           "source_artifact_sha256":  {
                                                                                                          "type":  "string",
                                                                                                          "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                          "maxLength":  71
                                                                                                      },
                                                                           "source_snapshot_sha256":  {
                                                                                                          "type":  "string",
                                                                                                          "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                          "maxLength":  71
                                                                                                      },
                                                                           "pdf_artifact_sha256":  {
                                                                                                       "type":  "string",
                                                                                                       "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                       "maxLength":  71
                                                                                                   },
                                                                           "pdf_artifact_id":  {
                                                                                                   "type":  "string",
                                                                                                   "minLength":  1,
                                                                                                   "maxLength":  512,
                                                                                                   "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                                               },
                                                                           "source_filename":  {
                                                                                                   "type":  "string",
                                                                                                   "minLength":  1,
                                                                                                   "maxLength":  2048
                                                                                               },
                                                                           "pdf_filename":  {
                                                                                                "type":  "string",
                                                                                                "minLength":  1,
                                                                                                "maxLength":  2048
                                                                                            },
                                                                           "source_mime_type":  {
                                                                                                    "type":  "string",
                                                                                                    "minLength":  1,
                                                                                                    "maxLength":  2048
                                                                                                },
                                                                           "pdf_mime_type":  {
                                                                                                 "type":  "string",
                                                                                                 "minLength":  1,
                                                                                                 "maxLength":  2048
                                                                                             },
                                                                           "final_artifact_pair_sha256":  {
                                                                                                              "type":  "string",
                                                                                                              "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                              "maxLength":  71
                                                                                                          },
                                                                           "finalization_seal_sha256":  {
                                                                                                            "type":  "string",
                                                                                                            "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                            "maxLength":  71
                                                                                                        },
                                                                           "lineage_evidence_sha256s":  {
                                                                                                            "type":  "array",
                                                                                                            "maxItems":  4096,
                                                                                                            "items":  {
                                                                                                                          "type":  "string",
                                                                                                                          "minLength":  1,
                                                                                                                          "maxLength":  2048
                                                                                                                      }
                                                                                                        },
                                                                           "manifest_sha256":  {
                                                                                                   "type":  "string",
                                                                                                   "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                   "maxLength":  71
                                                                                               }
                                                                       }
                                                    }
              }
}

{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://schemas.d2i.local/pdf/pdf-finalization-seal-v1.schema.json",
    "title":  "PdfFinalizationSealV1",
    "$ref":  "#/$defs/PdfFinalizationSealV1",
    "$defs":  {
                  "FinalArtifactPairStateV1":  {
                                                   "type":  "string",
                                                   "enum":  [
                                                                "finalized",
                                                                "superseded",
                                                                "revoked"
                                                            ]
                                               },
                  "PdfFinalizationSealV1":  {
                                                "type":  "object",
                                                "additionalProperties":  false,
                                                "required":  [
                                                                 "schema_version",
                                                                 "seal_id",
                                                                 "organization_id",
                                                                 "case_id",
                                                                 "final_artifact_pair_sha256",
                                                                 "source_artifact_sha256",
                                                                 "pdf_artifact_sha256",
                                                                 "export_profile_sha256",
                                                                 "post_export_verification_sha256",
                                                                 "pair_state",
                                                                 "source_tree_sha256",
                                                                 "protected_audit_terminal_sha256",
                                                                 "issued_at_unix_ms",
                                                                 "expires_at_unix_ms",
                                                                 "signer_id",
                                                                 "signing_key_id",
                                                                 "signature_hex",
                                                                 "seal_sha256"
                                                             ],
                                                "properties":  {
                                                                   "schema_version":  {
                                                                                          "type":  "integer",
                                                                                          "minimum":  0,
                                                                                          "maximum":  4294967295
                                                                                      },
                                                                   "seal_id":  {
                                                                                   "type":  "string",
                                                                                   "minLength":  1,
                                                                                   "maxLength":  512,
                                                                                   "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                               },
                                                                   "organization_id":  {
                                                                                           "type":  "string",
                                                                                           "minLength":  1,
                                                                                           "maxLength":  512,
                                                                                           "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                                       },
                                                                   "case_id":  {
                                                                                   "type":  "string",
                                                                                   "minLength":  1,
                                                                                   "maxLength":  512,
                                                                                   "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                               },
                                                                   "final_artifact_pair_sha256":  {
                                                                                                      "type":  "string",
                                                                                                      "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                      "maxLength":  71
                                                                                                  },
                                                                   "source_artifact_sha256":  {
                                                                                                  "type":  "string",
                                                                                                  "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                  "maxLength":  71
                                                                                              },
                                                                   "pdf_artifact_sha256":  {
                                                                                               "type":  "string",
                                                                                               "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                               "maxLength":  71
                                                                                           },
                                                                   "export_profile_sha256":  {
                                                                                                 "type":  "string",
                                                                                                 "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                 "maxLength":  71
                                                                                             },
                                                                   "post_export_verification_sha256":  {
                                                                                                           "type":  "string",
                                                                                                           "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                           "maxLength":  71
                                                                                                       },
                                                                   "pair_state":  {
                                                                                      "$ref":  "#/$defs/FinalArtifactPairStateV1"
                                                                                  },
                                                                   "source_tree_sha256":  {
                                                                                              "type":  "string",
                                                                                              "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                              "maxLength":  71
                                                                                          },
                                                                   "protected_audit_terminal_sha256":  {
                                                                                                           "type":  "string",
                                                                                                           "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                           "maxLength":  71
                                                                                                       },
                                                                   "issued_at_unix_ms":  {
                                                                                             "type":  "integer",
                                                                                             "minimum":  0
                                                                                         },
                                                                   "expires_at_unix_ms":  {
                                                                                              "type":  "integer",
                                                                                              "minimum":  0
                                                                                          },
                                                                   "signer_id":  {
                                                                                     "type":  "string",
                                                                                     "minLength":  1,
                                                                                     "maxLength":  512,
                                                                                     "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                                 },
                                                                   "signing_key_id":  {
                                                                                          "type":  "string",
                                                                                          "minLength":  1,
                                                                                          "maxLength":  512,
                                                                                          "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                                      },
                                                                   "signature_hex":  {
                                                                                         "type":  "string",
                                                                                         "pattern":  "^[0-9a-f]{128}$",
                                                                                         "maxLength":  128
                                                                                     },
                                                                   "seal_sha256":  {
                                                                                       "type":  "string",
                                                                                       "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                       "maxLength":  71
                                                                                   }
                                                               }
                                            }
              }
}

namespace D2I.Package;

table Provenance {
  id:string (required);
  source_path:string (required);
  line:uint;
  field:string;
  content_hash:string (required);
}

table StringRecord {
  id:string (required);
  kind:string (required);
  subject:string;
  predicate:string;
  object:string;
  provenance_id:string (required);
}

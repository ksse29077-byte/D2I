                                                                    "subject_id",
                                                                    "predicate_id",
                                                                    "typed_value",
                                                                    "unit_id",
                                                                    "source_table_id",
                                                                    "source_column_ids",
                                                                    "source_row_count",
                                                                    "source_range_sha256",
                                                                    "confidence_millionths",

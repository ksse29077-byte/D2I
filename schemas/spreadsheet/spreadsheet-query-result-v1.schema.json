                                                                                                                               "value_type":  {
                                                                                                                                                  "const":  "date"
                                                                                                                                              },
                                                                                                                               "days_since_unix_epoch":  {
                                                                                                                                                             "type":  "integer",
                                                                                                                                                             "minimum":  -2147483648,
                                                                                                                                                             "maximum":  2147483647
                                                                                                                                                         }
                                                                                                                           }
                                                                                                        },
                                                                                                        {
                                                                                                            "type":  "object",
                                                                                                            "additionalProperties":  false,
                                                                                                            "required":  [
                                                                                                                             "value_type",
                                                                                                                             "code"
                                                                                                                         ],

                                                                      "subject_id":  {
                                                                                         "type":  "string",
                                                                                         "minLength":  1,
                                                                                         "maxLength":  512,
                                                                                         "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                                     },
                                                                      "predicate_id":  {

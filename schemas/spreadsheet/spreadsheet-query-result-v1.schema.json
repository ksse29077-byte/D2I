{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/spreadsheet/spreadsheet-query-result-v1.schema.json",
    "title":  "SpreadsheetQueryResultV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "query_id",
                     "query_sha256",
                     "workbook_snapshot_sha256",
                     "scanned_rows",
                     "scanned_cells",
                     "matched_rows",
                     "facts",
                     "complete",
                     "result_sha256"
                 ],
    "properties":  {

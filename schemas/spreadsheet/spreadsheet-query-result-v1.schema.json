                                                                                                                                             "minLength":  1,
                                                                                                                                             "maxLength":  512
                                                                                                                                         }
                                                                                                                           }
                                                                                                        },
                                                                                                        {
                                                                                                            "type":  "object",
                                                                                                            "additionalProperties":  false,
                                                                                                            "required":  [
                                                                                                                             "value_type",
                                                                                                                             "value"
                                                                                                                         ],
                                                                                                            "properties":  {
                                                                                                                               "value_type":  {
                                                                                                                                                  "const":  "integer"
                                                                                                                                              },
                                                                                                                               "value":  {

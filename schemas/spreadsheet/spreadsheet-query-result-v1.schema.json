                                                                                                                                                  "const":  "error"
                                                                                                                                              },
                                                                                                                               "code":  {
                                                                                                                                            "type":  "string",
                                                                                                                                            "minLength":  1,
                                                                                                                                            "maxLength":  512,
                                                                                                                                            "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                                                                                        }
                                                                                                                           }
                                                                                                        }
                                                                                                    ]
                                                                                      },
                                                                      "unit_id":  {
                                                                                      "oneOf":  [
                                                                                                    {
                                                                                                        "type":  "string",
                                                                                                        "minLength":  1,
                                                                                                        "maxLength":  512,
                                                                                                        "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                                                    },
                                                                                                    {
                                                                                                        "type":  "null"
                                                                                                    }
                                                                                                ]
                                                                                  },

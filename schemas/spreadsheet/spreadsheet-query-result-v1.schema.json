                                                                                                                                                  "const":  "decimal"
                                                                                                                                              },
                                                                                                                               "scaled_value":  {
                                                                                                                                                    "type":  "integer",
                                                                                                                                                    "minimum":  -9223372036854775808,
                                                                                                                                                    "maximum":  9223372036854775807
                                                                                                                                                },
                                                                                                                               "scale":  {
                                                                                                                                             "type":  "integer",
                                                                                                                                             "minimum":  0,
                                                                                                                                             "maximum":  6
                                                                                                                                         }
                                                                                                                           }
                                                                                                        },
                                                                                                        {
                                                                                                            "type":  "object",
                                                                                                            "additionalProperties":  false,
                                                                                                            "required":  [
                                                                                                                             "value_type",
                                                                                                                             "value"
                                                                                                                         ],
                                                                                                            "properties":  {
                                                                                                                               "value_type":  {
                                                                                                                                                  "const":  "boolean"
                                                                                                                                              },
                                                                                                                               "value":  {
                                                                                                                                             "type":  "boolean"
                                                                                                                                         }
                                                                                                                           }
                                                                                                        },
                                                                                                        {
                                                                                                            "type":  "object",
                                                                                                            "additionalProperties":  false,
                                                                                                            "required":  [
                                                                                                                             "value_type",
                                                                                                                             "days_since_unix_epoch"
                                                                                                                         ],

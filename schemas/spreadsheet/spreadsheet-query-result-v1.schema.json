                                                                                                                                             "minimum":  -9223372036854775808,
                                                                                                                                             "maximum":  9223372036854775807
                                                                                                                                         }
                                                                                                                           }
                                                                                                        },
                                                                                                        {
                                                                                                            "type":  "object",
                                                                                                            "additionalProperties":  false,
                                                                                                            "required":  [
                                                                                                                             "value_type",
                                                                                                                             "scaled_value",

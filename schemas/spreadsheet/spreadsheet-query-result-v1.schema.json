                                                                                              "type":  "string",
                                                                                              "minLength":  1,
                                                                                              "maxLength":  512,
                                                                                              "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                                          },
                                                                      "source_column_ids":  {
                                                                                                "type":  "array",
                                                                                                "minItems":  0,
                                                                                                "maxItems":  32,
                                                                                                "uniqueItems":  true,
                                                                                                "items":  {
                                                                                                              "type":  "string",
                                                                                                              "minLength":  1,
                                                                                                              "maxLength":  512,
                                                                                                              "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                                                          }
                                                                                            },
                                                                      "source_row_count":  {
                                                                                               "type":  "integer",
                                                                                               "minimum":  0,
                                                                                               "maximum":  4294967295
                                                                                           },
                                                                      "source_range_sha256":  {
                                                                                                  "type":  "string",
                                                                                                  "maxLength":  71,
                                                                                                  "pattern":  "^sha256:[0-9a-f]{64}$"
                                                                                              },
                                                                      "confidence_millionths":  {
                                                                                                    "type":  "integer",
                                                                                                    "minimum":  0,
                                                                                                    "maximum":  1000000
                                                                                                },
                                                                      "priority":  {
                                                                                       "type":  "integer",
                                                                                       "minimum":  0,
                                                                                       "maximum":  1000000
                                                                                   },
                                                                      "evidence_ids":  {
                                                                                           "type":  "array",
                                                                                           "minItems":  1,
                                                                                           "maxItems":  128,
                                                                                           "uniqueItems":  true,
                                                                                           "items":  {
                                                                                                         "type":  "string",
                                                                                                         "minLength":  1,
                                                                                                         "maxLength":  512,
                                                                                                         "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                                                     }
                                                                                       },
                                                                      "fact_sha256":  {
                                                                                          "type":  "string",
                                                                                          "maxLength":  71,
                                                                                          "pattern":  "^sha256:[0-9a-f]{64}$"
                                                                                      }
                                                                  }
                                               }
                                 },
                       "complete":  {
                                        "type":  "boolean"
                                    },
                       "result_sha256":  {
                                             "type":  "string",
                                             "maxLength":  71,
                                             "pattern":  "^sha256:[0-9a-f]{64}$"
                                         }
                   }
}

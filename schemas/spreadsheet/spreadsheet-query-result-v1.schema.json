                                                        "maxLength":  71,
                                                        "pattern":  "^sha256:[0-9a-f]{64}$"
                                                    },
                       "scanned_rows":  {
                                            "type":  "integer",
                                            "minimum":  0,
                                            "maximum":  4294967295

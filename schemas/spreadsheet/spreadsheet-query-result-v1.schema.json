                                              "const":  1
                                          },
                       "query_id":  {
                                        "type":  "string",
                                        "minLength":  1,
                                        "maxLength":  512,
                                        "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                    },
                       "query_sha256":  {
                                            "type":  "string",
                                            "maxLength":  71,
                                            "pattern":  "^sha256:[0-9a-f]{64}$"
                                        },
                       "workbook_snapshot_sha256":  {

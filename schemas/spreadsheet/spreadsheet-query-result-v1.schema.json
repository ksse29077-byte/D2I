                                                                                      "minLength":  1,
                                                                                      "maxLength":  512,
                                                                                      "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                                  },
                                                                      "fact_kind":  {
                                                                                        "type":  "string",
                                                                                        "enum":  [
                                                                                                     "aggregate",
                                                                                                     "lookup",

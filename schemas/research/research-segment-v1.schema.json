{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://schemas.d2i.local/research/research-segment-v1.schema.json",
    "title":  "ResearchSegmentV1",
    "$ref":  "#/$defs/ResearchSegmentV1",
    "$defs":  {
                  "ResearchSegmentRoleV1":  {
                                                "type":  "string",
                                                "enum":  [
                                                             "title",
                                                             "heading",
                                                             "paragraph",
                                                             "list_item",
                                                             "table_cell",
                                                             "link_label"
                                                         ]
                                            },
                  "ResearchSegmentV1":  {
                                            "type":  "object",
                                            "additionalProperties":  false,
                                            "required":  [
                                                             "segment_id",
                                                             "role",
                                                             "text",
                                                             "source_reference",
                                                             "segment_sha256"
                                                         ],
                                            "properties":  {
                                                               "segment_id":  {
                                                                                  "type":  "string",
                                                                                  "minLength":  1,
                                                                                  "maxLength":  512,
                                                                                  "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                              },
                                                               "role":  {
                                                                            "$ref":  "#/$defs/ResearchSegmentRoleV1"
                                                                        },
                                                               "heading_level":  {
                                                                                     "oneOf":  [
                                                                                                   {
                                                                                                       "type":  "integer",
                                                                                                       "minimum":  0,
                                                                                                       "maximum":  255
                                                                                                   },
                                                                                                   {
                                                                                                       "type":  "null"
                                                                                                   }
                                                                                               ]
                                                                                 },
                                                               "text":  {
                                                                            "type":  "string",
                                                                            "minLength":  0,
                                                                            "maxLength":  262144
                                                                        },
                                                               "source_reference":  {
                                                                                        "type":  "string",
                                                                                        "minLength":  0,
                                                                                        "maxLength":  262144
                                                                                    },
                                                               "segment_sha256":  {
                                                                                      "type":  "string",
                                                                                      "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                      "maxLength":  71
                                                                                  }
                                                           }
                                        }
              }
}

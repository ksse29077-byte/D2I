{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://schemas.d2i.local/research/research-work-replay-report-v1.schema.json",
    "title":  "ResearchWorkReplayReportV1",
    "$ref":  "#/$defs/ResearchWorkReplayReportV1",
    "$defs":  {
                  "ResearchWorkReplayReportV1":  {
                                                     "type":  "object",
                                                     "additionalProperties":  false,
                                                     "required":  [
                                                                      "schema_version",
                                                                      "report_id",
                                                                      "scenario_count",
                                                                      "repetitions_per_scenario",
                                                                      "logical_replay_count",
                                                                      "external_network_request_count",
                                                                      "deterministic_match_count",
                                                                      "blind_replay_count",
                                                                      "report_sha256"
                                                                  ],
                                                     "properties":  {
                                                                        "schema_version":  {
                                                                                               "type":  "integer",
                                                                                               "minimum":  0,
                                                                                               "maximum":  4294967295
                                                                                           },
                                                                        "report_id":  {
                                                                                          "type":  "string",
                                                                                          "minLength":  1,
                                                                                          "maxLength":  512,
                                                                                          "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                                      },
                                                                        "scenario_count":  {
                                                                                               "type":  "integer",
                                                                                               "minimum":  0,
                                                                                               "maximum":  4294967295
                                                                                           },
                                                                        "repetitions_per_scenario":  {
                                                                                                         "type":  "integer",
                                                                                                         "minimum":  0,
                                                                                                         "maximum":  4294967295
                                                                                                     },
                                                                        "logical_replay_count":  {
                                                                                                     "type":  "integer",
                                                                                                     "minimum":  0
                                                                                                 },
                                                                        "external_network_request_count":  {
                                                                                                               "type":  "integer",
                                                                                                               "minimum":  0
                                                                                                           },
                                                                        "deterministic_match_count":  {
                                                                                                          "type":  "integer",
                                                                                                          "minimum":  0
                                                                                                      },
                                                                        "blind_replay_count":  {
                                                                                                   "type":  "integer",
                                                                                                   "minimum":  0
                                                                                               },
                                                                        "report_sha256":  {
                                                                                              "type":  "string",
                                                                                              "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                              "maxLength":  71
                                                                                          }
                                                                    }
                                                 }
              }
}

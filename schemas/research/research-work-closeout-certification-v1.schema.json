{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://schemas.d2i.local/research/research-work-closeout-certification-v1.schema.json",
    "title":  "ResearchWorkCloseoutCertificationV1",
    "$ref":  "#/$defs/ResearchWorkCloseoutCertificationV1",
    "$defs":  {
                  "ResearchWorkCloseoutCertificationV1":  {
                                                              "type":  "object",
                                                              "additionalProperties":  false,
                                                              "required":  [
                                                                               "schema_version",
                                                                               "certification_id",
                                                                               "completion_report_sha256",
                                                                               "execution_certification_sha256",
                                                                               "attachment_policy_qualification_sha256",
                                                                               "user_sid",
                                                                               "admx_sha256",
                                                                               "original_policy_sha256",
                                                                               "staged_policy_sha256",
                                                                               "restored_policy_sha256",
                                                                               "source_tree_sha256",
                                                                               "issued_at_unix_ms",
                                                                               "expires_at_unix_ms",
                                                                               "signer_id",
                                                                               "signing_key_id",
                                                                               "signature_hex",
                                                                               "certification_sha256"
                                                                           ],
                                                              "properties":  {
                                                                                 "schema_version":  {
                                                                                                        "type":  "integer",
                                                                                                        "minimum":  0,
                                                                                                        "maximum":  4294967295
                                                                                                    },
                                                                                 "certification_id":  {
                                                                                                          "type":  "string",
                                                                                                          "minLength":  1,
                                                                                                          "maxLength":  512,
                                                                                                          "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                                                      },
                                                                                 "completion_report_sha256":  {
                                                                                                                  "type":  "string",
                                                                                                                  "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                                  "maxLength":  71
                                                                                                              },
                                                                                 "execution_certification_sha256":  {
                                                                                                                        "type":  "string",
                                                                                                                        "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                                        "maxLength":  71
                                                                                                                    },
                                                                                 "attachment_policy_qualification_sha256":  {
                                                                                                                                "type":  "string",
                                                                                                                                "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                                                "maxLength":  71
                                                                                                                            },
                                                                                 "user_sid":  {
                                                                                                  "type":  "string",
                                                                                                  "minLength":  0,
                                                                                                  "maxLength":  262144
                                                                                              },
                                                                                 "admx_sha256":  {
                                                                                                     "type":  "string",
                                                                                                     "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                     "maxLength":  71
                                                                                                 },
                                                                                 "original_policy_sha256":  {
                                                                                                                "type":  "string",
                                                                                                                "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                                "maxLength":  71
                                                                                                            },
                                                                                 "staged_policy_sha256":  {
                                                                                                              "type":  "string",
                                                                                                              "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                              "maxLength":  71
                                                                                                          },
                                                                                 "restored_policy_sha256":  {
                                                                                                                "type":  "string",
                                                                                                                "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                                "maxLength":  71
                                                                                                            },
                                                                                 "source_tree_sha256":  {
                                                                                                            "type":  "string",
                                                                                                            "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                            "maxLength":  71
                                                                                                        },
                                                                                 "issued_at_unix_ms":  {
                                                                                                           "type":  "integer",
                                                                                                           "minimum":  0
                                                                                                       },
                                                                                 "expires_at_unix_ms":  {
                                                                                                            "type":  "integer",
                                                                                                            "minimum":  0
                                                                                                        },
                                                                                 "signer_id":  {
                                                                                                   "type":  "string",
                                                                                                   "minLength":  1,
                                                                                                   "maxLength":  512,
                                                                                                   "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                                               },
                                                                                 "signing_key_id":  {
                                                                                                        "type":  "string",
                                                                                                        "minLength":  1,
                                                                                                        "maxLength":  512,
                                                                                                        "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                                                    },
                                                                                 "signature_hex":  {
                                                                                                       "type":  "string",
                                                                                                       "pattern":  "^[0-9a-f]{128}$",
                                                                                                       "maxLength":  128
                                                                                                   },
                                                                                 "certification_sha256":  {
                                                                                                              "type":  "string",
                                                                                                              "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                                              "maxLength":  71
                                                                                                          }
                                                                             }
                                                          }
              }
}

{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/office/office-artifact-provenance-v1.schema.json",
    "title":  "OfficeArtifactProvenanceV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "artifact_sha256",
                     "source_artifact_sha256s",
                     "case_sha256",
                     "role_instance_sha256",
                     "operation_receipt_sha256s",
                     "application_family_id",
                     "created_at_unix_ms",
                     "modified_at_unix_ms",
                     "data_class_ids",
                     "verification_sha256s",
                     "provenance_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "artifact_sha256":  {
                                               "type":  "string",
                                               "pattern":  "^sha256:[0-9a-f]{64}$",
                                               "maxLength":  71
                                           },
                       "source_artifact_sha256s":  {
                                                       "type":  "array",
                                                       "maxItems":  512,
                                                       "uniqueItems":  true,
                                                       "items":  {
                                                                     "type":  "string",
                                                                     "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                     "maxLength":  71
                                                                 }
                                                   },
                       "case_sha256":  {
                                           "type":  "string",
                                           "pattern":  "^sha256:[0-9a-f]{64}$",
                                           "maxLength":  71
                                       },
                       "role_instance_sha256":  {
                                                    "type":  "string",
                                                    "pattern":  "^sha256:[0-9a-f]{64}$",
                                                    "maxLength":  71
                                                },
                       "operation_receipt_sha256s":  {
                                                         "type":  "array",
                                                         "maxItems":  512,
                                                         "uniqueItems":  true,
                                                         "items":  {
                                                                       "type":  "string",
                                                                       "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                       "maxLength":  71
                                                                   }
                                                     },
                       "application_family_id":  {
                                                     "type":  "string",
                                                     "minLength":  1,
                                                     "maxLength":  512,
                                                     "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                 },
                       "created_at_unix_ms":  {
                                                  "type":  "integer",
                                                  "minimum":  0,
                                                  "maximum":  18446744073709551615
                                              },
                       "modified_at_unix_ms":  {
                                                   "type":  "integer",
                                                   "minimum":  0,
                                                   "maximum":  18446744073709551615
                                               },
                       "data_class_ids":  {
                                              "type":  "array",
                                              "maxItems":  512,
                                              "uniqueItems":  true,
                                              "items":  {
                                                            "type":  "string",
                                                            "minLength":  1,
                                                            "maxLength":  512,
                                                            "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                        }
                                          },
                       "verification_sha256s":  {
                                                    "type":  "array",
                                                    "maxItems":  512,
                                                    "uniqueItems":  true,
                                                    "items":  {
                                                                  "type":  "string",
                                                                  "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                  "maxLength":  71
                                                              }
                                                },
                       "provenance_sha256":  {
                                                 "type":  "string",
                                                 "pattern":  "^sha256:[0-9a-f]{64}$",
                                                 "maxLength":  71
                                             }
                   }
}

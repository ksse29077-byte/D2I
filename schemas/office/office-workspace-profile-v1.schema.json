{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/office/office-workspace-profile-v1.schema.json",
    "title":  "OfficeWorkspaceProfileV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "workspace_id",
                     "organization_id",
                     "role_scope_ids",
                     "workspace_root_binding_sha256",
                     "allowed_artifact_classes",
                     "allowed_extensions",
                     "maximum_total_bytes",
                     "maximum_file_bytes",
                     "maximum_files",
                     "maximum_directories",
                     "maximum_depth",
                     "allowed_operations",
                     "versioning_policy_id",
                     "backup_policy_id",
                     "overwrite_policy_id",
                     "delete_policy_id",
                     "retention_policy_id",
                     "valid_from_unix_ms",
                     "valid_until_unix_ms",
                     "evidence_ids",
                     "signer_key_id",
                     "profile_sha256",
                     "signature_hex"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "workspace_id":  {
                                            "type":  "string",
                                            "minLength":  1,
                                            "maxLength":  512,
                                            "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                        },
                       "organization_id":  {
                                               "type":  "string",
                                               "minLength":  1,
                                               "maxLength":  512,
                                               "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                           },
                       "role_scope_ids":  {
                                              "type":  "array",
                                              "maxItems":  512,
                                              "uniqueItems":  true,
                                              "items":  {
                                                            "type":  "string",
                                                            "minLength":  1,
                                                            "maxLength":  512,
                                                            "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                        }
                                          },
                       "workspace_root_binding_sha256":  {
                                                             "type":  "string",
                                                             "pattern":  "^sha256:[0-9a-f]{64}$",
                                                             "maxLength":  71
                                                         },
                       "allowed_artifact_classes":  {
                                                        "type":  "array",
                                                        "maxItems":  512,
                                                        "uniqueItems":  true,
                                                        "items":  {
                                                                      "type":  "string",
                                                                      "minLength":  1,
                                                                      "maxLength":  512
                                                                  }
                                                    },
                       "allowed_extensions":  {
                                                  "type":  "array",
                                                  "maxItems":  512,
                                                  "uniqueItems":  true,
                                                  "items":  {
                                                                "type":  "string",
                                                                "minLength":  1,
                                                                "maxLength":  512
                                                            }
                                              },
                       "maximum_total_bytes":  {
                                                   "type":  "integer",
                                                   "minimum":  0,
                                                   "maximum":  18446744073709551615
                                               },
                       "maximum_file_bytes":  {
                                                  "type":  "integer",
                                                  "minimum":  0,
                                                  "maximum":  18446744073709551615
                                              },
                       "maximum_files":  {
                                             "type":  "integer",
                                             "minimum":  0,
                                             "maximum":  4294967295
                                         },
                       "maximum_directories":  {
                                                   "type":  "integer",
                                                   "minimum":  0,
                                                   "maximum":  4294967295
                                               },
                       "maximum_depth":  {
                                             "type":  "integer",
                                             "minimum":  0,
                                             "maximum":  4294967295
                                         },
                       "allowed_operations":  {
                                                  "type":  "array",
                                                  "maxItems":  512,
                                                  "uniqueItems":  true,
                                                  "items":  {
                                                                "type":  "string",
                                                                "enum":  [
                                                                             "list_artifacts",
                                                                             "inspect_artifact",
                                                                             "create_folder",
                                                                             "import_artifact",
                                                                             "create_working_copy",
                                                                             "copy_artifact",
                                                                             "rename_artifact",
                                                                             "move_artifact",
                                                                             "commit_version",
                                                                             "export_copy",
                                                                             "restore_version",
                                                                             "compare_identity"
                                                                         ]
                                                            }
                                              },
                       "versioning_policy_id":  {
                                                    "type":  "string",
                                                    "minLength":  1,
                                                    "maxLength":  512,
                                                    "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                },
                       "backup_policy_id":  {
                                                "type":  "string",
                                                "minLength":  1,
                                                "maxLength":  512,
                                                "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                            },
                       "overwrite_policy_id":  {
                                                   "type":  "string",
                                                   "minLength":  1,
                                                   "maxLength":  512,
                                                   "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                               },
                       "delete_policy_id":  {
                                                "type":  "string",
                                                "minLength":  1,
                                                "maxLength":  512,
                                                "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                            },
                       "retention_policy_id":  {
                                                   "type":  "string",
                                                   "minLength":  1,
                                                   "maxLength":  512,
                                                   "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                               },
                       "valid_from_unix_ms":  {
                                                  "type":  "integer",
                                                  "minimum":  0,
                                                  "maximum":  18446744073709551615
                                              },
                       "valid_until_unix_ms":  {
                                                   "type":  "integer",
                                                   "minimum":  0,
                                                   "maximum":  18446744073709551615
                                               },
                       "evidence_ids":  {
                                            "type":  "array",
                                            "maxItems":  512,
                                            "uniqueItems":  true,
                                            "items":  {
                                                          "type":  "string",
                                                          "minLength":  1,
                                                          "maxLength":  512,
                                                          "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                      }
                                        },
                       "signer_key_id":  {
                                             "type":  "string",
                                             "minLength":  1,
                                             "maxLength":  512,
                                             "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                         },
                       "profile_sha256":  {
                                              "type":  "string",
                                              "pattern":  "^sha256:[0-9a-f]{64}$",
                                              "maxLength":  71
                                          },
                       "signature_hex":  {
                                             "type":  "string",
                                             "pattern":  "^[0-9a-f]{128}$",
                                             "maxLength":  128
                                         }
                   }
}

{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/document/document-operation-binding-v1.schema.json",
    "title":  "DocumentOperationBindingV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "binding_id",
                     "role_contract_sha256",
                     "role_instance_sha256",
                     "case_sha256",
                     "lease_sha256",
                     "work_grant_sha256",
                     "workspace_profile_sha256",
                     "workspace_root_binding_sha256",
                     "artifact_id",
                     "artifact_generation",
                     "artifact_content_sha256",
                     "semantic_snapshot_sha256",
                     "capability_pack_sha256",
                     "backend_descriptor_sha256",
                     "backend_approval_sha256",
                     "operation_intent_sha256",
                     "policy_decision_sha256",
                     "cognitive_activation_admission_sha256",
                     "worker_sha256",
                     "expected_output_generation",
                     "one_time_use_id",
                     "expires_at_unix_ms",
                     "binding_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "binding_id":  {
                                          "type":  "string",
                                          "minLength":  1,
                                          "maxLength":  512,
                                          "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                      },
                       "role_contract_sha256":  {
                                                    "type":  "string",
                                                    "maxLength":  71,
                                                    "pattern":  "^sha256:[0-9a-f]{64}$"
                                                },
                       "role_instance_sha256":  {
                                                    "type":  "string",
                                                    "maxLength":  71,
                                                    "pattern":  "^sha256:[0-9a-f]{64}$"
                                                },
                       "case_sha256":  {
                                           "type":  "string",
                                           "maxLength":  71,
                                           "pattern":  "^sha256:[0-9a-f]{64}$"
                                       },
                       "lease_sha256":  {
                                            "type":  "string",
                                            "maxLength":  71,
                                            "pattern":  "^sha256:[0-9a-f]{64}$"
                                        },
                       "work_grant_sha256":  {
                                                 "type":  "string",
                                                 "maxLength":  71,
                                                 "pattern":  "^sha256:[0-9a-f]{64}$"
                                             },
                       "workspace_profile_sha256":  {
                                                        "type":  "string",
                                                        "maxLength":  71,
                                                        "pattern":  "^sha256:[0-9a-f]{64}$"
                                                    },
                       "workspace_root_binding_sha256":  {
                                                             "type":  "string",
                                                             "maxLength":  71,
                                                             "pattern":  "^sha256:[0-9a-f]{64}$"
                                                         },
                       "artifact_id":  {
                                           "type":  "string",
                                           "minLength":  1,
                                           "maxLength":  512,
                                           "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                       },
                       "artifact_generation":  {
                                                   "type":  "integer",
                                                   "minimum":  0
                                               },
                       "artifact_content_sha256":  {
                                                       "type":  "string",
                                                       "maxLength":  71,
                                                       "pattern":  "^sha256:[0-9a-f]{64}$"
                                                   },
                       "semantic_snapshot_sha256":  {
                                                        "type":  "string",
                                                        "maxLength":  71,
                                                        "pattern":  "^sha256:[0-9a-f]{64}$"
                                                    },
                       "capability_pack_sha256":  {
                                                      "type":  "string",
                                                      "maxLength":  71,
                                                      "pattern":  "^sha256:[0-9a-f]{64}$"
                                                  },
                       "backend_descriptor_sha256":  {
                                                         "type":  "string",
                                                         "maxLength":  71,
                                                         "pattern":  "^sha256:[0-9a-f]{64}$"
                                                     },
                       "backend_approval_sha256":  {
                                                       "type":  "string",
                                                       "maxLength":  71,
                                                       "pattern":  "^sha256:[0-9a-f]{64}$"
                                                   },
                       "operation_intent_sha256":  {
                                                       "type":  "string",
                                                       "maxLength":  71,
                                                       "pattern":  "^sha256:[0-9a-f]{64}$"
                                                   },
                       "policy_decision_sha256":  {
                                                      "type":  "string",
                                                      "maxLength":  71,
                                                      "pattern":  "^sha256:[0-9a-f]{64}$"
                                                  },
                       "cognitive_activation_admission_sha256":  {
                                                                     "type":  "string",
                                                                     "maxLength":  71,
                                                                     "pattern":  "^sha256:[0-9a-f]{64}$"
                                                                 },
                       "worker_sha256":  {
                                             "type":  "string",
                                             "maxLength":  71,
                                             "pattern":  "^sha256:[0-9a-f]{64}$"
                                         },
                       "expected_output_generation":  {
                                                          "type":  "integer",
                                                          "minimum":  0
                                                      },
                       "one_time_use_id":  {
                                               "type":  "string",
                                               "minLength":  1,
                                               "maxLength":  512,
                                               "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                           },
                       "expires_at_unix_ms":  {
                                                  "type":  "integer",
                                                  "minimum":  0
                                              },
                       "binding_sha256":  {
                                              "type":  "string",
                                              "maxLength":  71,
                                              "pattern":  "^sha256:[0-9a-f]{64}$"
                                          }
                   }
}

{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/document/document-table-spec-v1.schema.json",
    "title":  "DocumentTableSpecV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "table_spec_id",
                     "rows",
                     "columns",
                     "header_rows",
                     "column_role_ids",
                     "style_spec_id",
                     "maximum_width_policy_id",
                     "table_spec_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "table_spec_id":  {
                                             "type":  "string",
                                             "minLength":  1,
                                             "maxLength":  512,
                                             "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                         },
                       "rows":  {
                                    "type":  "integer",
                                    "minimum":  1,
                                    "maximum":  256
                                },
                       "columns":  {
                                       "type":  "integer",
                                       "minimum":  1,
                                       "maximum":  64
                                   },
                       "header_rows":  {
                                           "type":  "integer",
                                           "minimum":  0,
                                           "maximum":  4294967295
                                       },
                       "column_role_ids":  {
                                               "type":  "array",
                                               "minItems":  1,
                                               "maxItems":  64,
                                               "uniqueItems":  true,
                                               "items":  {
                                                             "type":  "string",
                                                             "minLength":  1,
                                                             "maxLength":  512,
                                                             "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                         }
                                           },
                       "style_spec_id":  {
                                             "type":  "string",
                                             "minLength":  1,
                                             "maxLength":  512,
                                             "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                         },
                       "maximum_width_policy_id":  {
                                                       "type":  "string",
                                                       "minLength":  1,
                                                       "maxLength":  512,
                                                       "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                   },
                       "table_spec_sha256":  {
                                                 "type":  "string",
                                                 "maxLength":  71,
                                                 "pattern":  "^sha256:[0-9a-f]{64}$"
                                             }
                   }
}

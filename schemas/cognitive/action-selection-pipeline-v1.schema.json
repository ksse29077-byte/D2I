          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/rejected_candidate" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "outcome": { "const": "ranked" } },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "selected_candidate_id": { "$ref": "#/$defs/ranker_id" },
              "selected_candidate_hash": { "$ref": "#/$defs/hash" },
              "ranked_candidates": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "outcome": { "const": "no_eligible_candidate" } },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "selected_candidate_id": { "type": "null" },
              "selected_candidate_hash": { "type": "null" },
              "ranked_candidates": { "maxItems": 0 }
            }
          }
        }
      ]

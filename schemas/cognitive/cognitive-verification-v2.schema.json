{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/schemas/cognitive/cognitive-verification-v2.schema.json",
  "title": "D2I Cognitive Verification Contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["request", "result"],
  "properties": {
    "request": { "$ref": "#/$defs/verification_request" },
    "result": { "$ref": "#/$defs/verification_result" }
  },
  "$defs": {
    "version_v1": { "const": 1 },
    "version_v2": { "const": 2 },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "value": true,
    "string_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/text" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_hash", "module_id"],
      "properties": {
        "source": { "$ref": "#/$defs/text" },
        "source_hash": { "$ref": "#/$defs/hash" },
        "module_id": { "$ref": "#/$defs/token" }
      }
    },
    "risk": {
      "enum": ["read_only", "reversible", "business_state_change", "high_criticality"]
    },
    "confirmation_policy": {
      "enum": ["never", "before_risky_action", "before_irreversible_action", "always"]
    },
    "confirmation_requirement": {
      "enum": ["none", "required", "unsupported_irreversible"]
    },
    "reversibility": { "enum": ["reversible", "irreversible"] },
    "comparison_op": {
      "enum": ["equals", "not_equals", "contains", "exists", "greater_or_equal", "less_or_equal"]
    },
    "verification_field": {
      "enum": ["element_exists", "element_value", "element_current_value", "element_kind"]
    },
    "verification_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "field"],
      "properties": {
        "element_id": { "$ref": "#/$defs/token" },
        "field": { "$ref": "#/$defs/verification_field" }
      }
    },
    "verifiable_postcondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "target", "op", "expected_value", "required"],
      "properties": {
        "criterion_id": { "$ref": "#/$defs/token" },
        "target": { "$ref": "#/$defs/verification_target" },
        "op": { "$ref": "#/$defs/comparison_op" },
        "expected_value": { "$ref": "#/$defs/value" },
        "required": { "type": "boolean" }
      }
    },
    "verification_goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "goal_id",
        "objective",
        "scope",
        "required_outcomes",
        "constraints",
        "success_criteria",
        "risk_class",
        "confirmation_policy",
        "provenance"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/version_v2" },
        "goal_id": { "$ref": "#/$defs/token" },
        "objective": { "$ref": "#/$defs/text" },
        "scope": { "type": "object" },
        "required_outcomes": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/text" }
        },
        "constraints": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/text" }
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/verifiable_postcondition" }
        },
        "risk_class": { "$ref": "#/$defs/risk" },
        "confirmation_policy": { "$ref": "#/$defs/confirmation_policy" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "verification_action_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "proposal_id",
        "goal_id",
        "plan_generation_id",
        "source_observation_id",
        "source_observation_hash",
        "source_observation_sequence",
        "capability_id",
        "semantic_target",
        "arguments",
        "preconditions",
        "expected_postconditions",
        "risk",
        "reversibility",
        "confirmation_requirement",
        "confidence",
        "evidence",
        "valid_until_sequence"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/version_v2" },
        "proposal_id": { "$ref": "#/$defs/token" },
        "goal_id": { "$ref": "#/$defs/token" },
        "plan_generation_id": { "$ref": "#/$defs/token" },
        "source_observation_id": { "$ref": "#/$defs/token" },
        "source_observation_hash": { "$ref": "#/$defs/hash" },
        "source_observation_sequence": { "type": "integer", "minimum": 0 },
        "capability_id": { "$ref": "#/$defs/token" },
        "semantic_target": { "$ref": "#/$defs/text" },
        "arguments": { "$ref": "#/$defs/value" },
        "preconditions": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/verifiable_postcondition" }
        },
        "expected_postconditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/verifiable_postcondition" }
        },
        "risk": { "$ref": "#/$defs/risk" },
        "reversibility": { "$ref": "#/$defs/reversibility" },
        "confirmation_requirement": { "$ref": "#/$defs/confirmation_requirement" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/text" }
        },
        "valid_until_sequence": { "type": "integer", "minimum": 0 }
      }
    },
    "execution_status": {
      "enum": ["succeeded", "failed", "denied", "unsupported", "timeout"]
    },
    "bound_action_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "execution_id",
        "proposal_id",
        "goal_id",
        "plan_generation_id",
        "source_observation_id",
        "source_observation_hash",
        "source_observation_sequence",
        "status",
        "evidence",
        "warnings"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/version_v2" },
        "execution_id": { "$ref": "#/$defs/token" },
        "proposal_id": { "$ref": "#/$defs/token" },
        "goal_id": { "$ref": "#/$defs/token" },
        "plan_generation_id": { "$ref": "#/$defs/token" },
        "source_observation_id": { "$ref": "#/$defs/token" },
        "source_observation_hash": { "$ref": "#/$defs/hash" },
        "source_observation_sequence": { "type": "integer", "minimum": 0 },
        "status": { "$ref": "#/$defs/execution_status" },
        "evidence": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/text" }
        },
        "warnings": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/text" }
        }
      }
    },
    "trust_label": {
      "enum": [
        "authenticated_user_instruction",
        "approved_policy",
        "approved_procedure",
        "verified_operational_state",
        "observed_ui_state",
        "untrusted_web_content",
        "untrusted_document_content",
        "fixture"
      ]
    },
    "source_kind": {
      "enum": ["fixture", "uia", "web_driver", "file_metadata", "process"]
    },
    "observable_element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "kind", "label", "value", "trust_labels"],
      "properties": {
        "element_id": { "$ref": "#/$defs/token" },
        "kind": { "$ref": "#/$defs/token" },
        "label": { "$ref": "#/$defs/text" },
        "value": { "$ref": "#/$defs/value" },
        "trust_labels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/trust_label" }
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "reason", "replacement_hash"],
      "properties": {
        "field": { "$ref": "#/$defs/token" },
        "reason": { "$ref": "#/$defs/text" },
        "replacement_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "observation_snapshot_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "observation_id",
        "source_kind",
        "target_binding",
        "state_hash",
        "sequence",
        "trust_labels",
        "observable_elements",
        "redactions",
        "provenance"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/version_v1" },
        "observation_id": { "$ref": "#/$defs/token" },
        "source_kind": { "$ref": "#/$defs/source_kind" },
        "target_binding": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/text" }
        },
        "state_hash": { "$ref": "#/$defs/hash" },
        "sequence": { "type": "integer", "minimum": 0 },
        "trust_labels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/trust_label" }
        },
        "observable_elements": {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/observable_element" }
        },
        "redactions": {
          "type": "array",
          "items": { "$ref": "#/$defs/redaction" }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "verification_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "verification_id",
        "goal",
        "proposal",
        "execution",
        "source_observation",
        "fresh_observation"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/version_v2" },
        "verification_id": { "$ref": "#/$defs/token" },
        "goal": { "$ref": "#/$defs/verification_goal" },
        "proposal": { "$ref": "#/$defs/verification_action_proposal" },
        "execution": { "$ref": "#/$defs/bound_action_execution" },
        "source_observation": { "$ref": "#/$defs/observation_snapshot_v1" },
        "fresh_observation": { "$ref": "#/$defs/observation_snapshot_v1" }
      }
    },
    "verification_verdict": {
      "enum": ["passed", "failed", "inconclusive", "unsupported", "unsafe"]
    },
    "verification_confidence": { "const": "not_applicable" },
    "postcondition_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "target",
        "verdict",
        "required",
        "observed_value",
        "reason",
        "evidence"
      ],
      "properties": {
        "criterion_id": { "$ref": "#/$defs/token" },
        "target": { "$ref": "#/$defs/verification_target" },
        "verdict": { "$ref": "#/$defs/verification_verdict" },
        "required": { "type": "boolean" },
        "observed_value": {
          "oneOf": [{ "$ref": "#/$defs/value" }, { "type": "null" }]
        },
        "reason": { "$ref": "#/$defs/text" },
        "evidence": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/text" }
        }
      }
    },
    "goal_progress": {
      "enum": ["not_started", "in_progress", "complete", "blocked"]
    },
    "verification_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "verification_id",
        "goal_id",
        "plan_generation_id",
        "proposal_id",
        "execution_id",
        "execution_status",
        "action_verdict",
        "action_postcondition_results",
        "goal_postcondition_results",
        "observed_state_hash",
        "goal_progress",
        "unexpected_changes",
        "warnings",
        "evidence",
        "reason",
        "provenance",
        "confidence"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/version_v2" },
        "verification_id": { "$ref": "#/$defs/token" },
        "goal_id": { "$ref": "#/$defs/token" },
        "plan_generation_id": { "$ref": "#/$defs/token" },
        "proposal_id": { "$ref": "#/$defs/token" },
        "execution_id": { "$ref": "#/$defs/token" },
        "execution_status": { "$ref": "#/$defs/execution_status" },
        "action_verdict": { "$ref": "#/$defs/verification_verdict" },
        "action_postcondition_results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/postcondition_result" }
        },
        "goal_postcondition_results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/postcondition_result" }
        },
        "observed_state_hash": { "$ref": "#/$defs/hash" },
        "goal_progress": { "$ref": "#/$defs/goal_progress" },
        "unexpected_changes": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/text" }
        },
        "warnings": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/text" }
        },
        "evidence": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/text" }
        },
        "reason": { "$ref": "#/$defs/text" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "confidence": { "$ref": "#/$defs/verification_confidence" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/schemas/cognitive/application-semantics-v1.schema.json",
  "title": "D2I Application Semantics Contract v1",
  "oneOf": [
    {
      "$ref": "#/$defs/application_pack"
    },
    {
      "$ref": "#/$defs/observation_fixture"
    },
    {
      "$ref": "#/$defs/element_grounder_bridge_request"
    },
    {
      "$ref": "#/$defs/element_grounder_payload"
    },
    {
      "$ref": "#/$defs/observation_fixture_bridge"
    }
  ],
  "$defs": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "semver": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_kind": {
      "enum": ["uia", "web_driver"]
    },
    "trust_label": {
      "enum": [
        "authenticated_user_instruction",
        "approved_policy",
        "approved_procedure",
        "verified_operational_state",
        "observed_ui_state",
        "untrusted_web_content",
        "untrusted_document_content",
        "fixture"
      ]
    },
    "trust_labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/trust_label"
      }
    },
    "id_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "optional_text_array": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "required_text_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "cognitive_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_hash", "module_id"],
      "properties": {
        "source": {
          "$ref": "#/$defs/text"
        },
        "source_hash": {
          "$ref": "#/$defs/hash"
        },
        "module_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "pack_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_sha256", "producer"],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "source_sha256": {
          "$ref": "#/$defs/hash"
        },
        "producer": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "semantic_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "canonical_label",
        "aliases",
        "expected_kinds",
        "required_terms",
        "excluded_terms",
        "context_terms"
      ],
      "properties": {
        "target_id": {
          "$ref": "#/$defs/id"
        },
        "canonical_label": {
          "$ref": "#/$defs/text"
        },
        "aliases": {
          "$ref": "#/$defs/required_text_array"
        },
        "expected_kinds": {
          "$ref": "#/$defs/id_array"
        },
        "required_terms": {
          "$ref": "#/$defs/optional_text_array"
        },
        "excluded_terms": {
          "$ref": "#/$defs/optional_text_array"
        },
        "context_terms": {
          "$ref": "#/$defs/optional_text_array"
        }
      }
    },
    "application_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "pack_id",
        "pack_version",
        "application_id",
        "display_name",
        "supported_source_kinds",
        "required_target_binding",
        "targets",
        "provenance",
        "pack_sha256"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/version"
        },
        "pack_id": {
          "$ref": "#/$defs/id"
        },
        "pack_version": {
          "$ref": "#/$defs/semver"
        },
        "application_id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "$ref": "#/$defs/text"
        },
        "supported_source_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_kind"
          }
        },
        "required_target_binding": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/text"
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/semantic_target"
          }
        },
        "provenance": {
          "$ref": "#/$defs/pack_provenance"
        },
        "pack_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "observable_element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["element_id", "kind", "label", "value", "trust_labels"],
      "properties": {
        "element_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "value": true,
        "trust_labels": {
          "$ref": "#/$defs/trust_labels"
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "reason", "replacement_hash"],
      "properties": {
        "field": {
          "$ref": "#/$defs/id"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "replacement_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "observation_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "observation_id",
        "source_kind",
        "target_binding",
        "state_hash",
        "sequence",
        "trust_labels",
        "observable_elements",
        "redactions",
        "provenance"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/version"
        },
        "observation_id": {
          "$ref": "#/$defs/id"
        },
        "source_kind": {
          "$ref": "#/$defs/source_kind"
        },
        "target_binding": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/text"
          }
        },
        "state_hash": {
          "$ref": "#/$defs/hash"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "trust_labels": {
          "$ref": "#/$defs/trust_labels"
        },
        "observable_elements": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/observable_element"
          }
        },
        "redactions": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/redaction"
          }
        },
        "provenance": {
          "$ref": "#/$defs/cognitive_provenance"
        }
      }
    },
    "grounding_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "semantic_target_id",
        "target_text",
        "expected_element_id",
        "max_candidates"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "semantic_target_id": {
          "$ref": "#/$defs/id"
        },
        "target_text": {
          "$ref": "#/$defs/text"
        },
        "expected_element_id": {
          "$ref": "#/$defs/id"
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "observation_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "fixture_id",
        "application_pack_sha256",
        "observation_id",
        "source_kind",
        "target_binding",
        "sequence",
        "trust_labels",
        "observable_elements",
        "redactions",
        "provenance",
        "grounding_cases"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/version"
        },
        "fixture_id": {
          "$ref": "#/$defs/id"
        },
        "application_pack_sha256": {
          "$ref": "#/$defs/hash"
        },
        "observation_id": {
          "$ref": "#/$defs/id"
        },
        "source_kind": {
          "$ref": "#/$defs/source_kind"
        },
        "target_binding": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/text"
          }
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "trust_labels": {
          "$ref": "#/$defs/trust_labels"
        },
        "observable_elements": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/observable_element"
          }
        },
        "redactions": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/redaction"
          }
        },
        "provenance": {
          "$ref": "#/$defs/cognitive_provenance"
        },
        "grounding_cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/grounding_case"
          }
        }
      }
    },
    "element_grounder_bridge_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "application_pack_sha256",
        "semantic_target_id",
        "target_text",
        "goal_id",
        "plan_generation_id",
        "max_candidates",
        "replay_id",
        "replay_seed"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/version"
        },
        "application_pack_sha256": {
          "$ref": "#/$defs/hash"
        },
        "semantic_target_id": {
          "$ref": "#/$defs/id"
        },
        "target_text": {
          "$ref": "#/$defs/text"
        },
        "goal_id": {
          "$ref": "#/$defs/id"
        },
        "plan_generation_id": {
          "$ref": "#/$defs/id"
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "replay_id": {
          "$ref": "#/$defs/id"
        },
        "replay_seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "element_grounder_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "schema_id",
        "schema_revision",
        "application_pack_sha256",
        "semantic_target_id",
        "source_observation_hash",
        "payload",
        "payload_sha256"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/version"
        },
        "schema_id": {
          "const": "element-grounding-input-v1"
        },
        "schema_revision": {
          "const": 1
        },
        "application_pack_sha256": {
          "$ref": "#/$defs/hash"
        },
        "semantic_target_id": {
          "$ref": "#/$defs/id"
        },
        "source_observation_hash": {
          "$ref": "#/$defs/hash"
        },
        "payload": {
          "type": "object"
        },
        "payload_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "bridged_grounding_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "expected_element_id",
        "element_grounder",
        "evidence"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "expected_element_id": {
          "$ref": "#/$defs/id"
        },
        "element_grounder": {
          "$ref": "#/$defs/element_grounder_payload"
        },
        "evidence": {
          "$ref": "#/$defs/required_text_array"
        }
      }
    },
    "observation_fixture_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "fixture_id",
        "application_pack_sha256",
        "observation_snapshot",
        "cases",
        "bridge_sha256"
      ],
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/version"
        },
        "fixture_id": {
          "$ref": "#/$defs/id"
        },
        "application_pack_sha256": {
          "$ref": "#/$defs/hash"
        },
        "observation_snapshot": {
          "$ref": "#/$defs/observation_snapshot"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/bridged_grounding_case"
          }
        },
        "bridge_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}

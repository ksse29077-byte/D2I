{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/schemas/desktop/windows-activation-ledger-policy.schema.json",
  "title": "D2I Windows Activation Ledger Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_id",
    "integration_id",
    "manifest_hash",
    "allowed_activator_ids",
    "maximum_entries",
    "root_security_descriptor_hash",
    "policy_security_descriptor_hash",
    "records_security_descriptor_hash"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "ledger_id": { "$ref": "#/$defs/token" },
    "integration_id": { "$ref": "#/$defs/token" },
    "manifest_hash": { "$ref": "#/$defs/hash" },
    "allowed_activator_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "maximum_entries": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "root_security_descriptor_hash": { "$ref": "#/$defs/hash" },
    "policy_security_descriptor_hash": { "$ref": "#/$defs/hash" },
    "records_security_descriptor_hash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    }
  }
}

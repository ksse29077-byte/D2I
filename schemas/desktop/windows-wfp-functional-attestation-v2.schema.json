{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/schemas/desktop/windows-wfp-functional-attestation-v2.schema.json",
  "title": "D2I Signed Windows WFP Functional Attestation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_binding_digest",
    "machine_binding",
    "enforcement_id",
    "provider_id",
    "policy_hash",
    "provider_key",
    "sublayer_key",
    "filter_keys",
    "browser_version",
    "browser_executable_hash",
    "driver_version",
    "driver_executable_hash",
    "edge_driver_pin_hash",
    "self_test_report_hash",
    "activation_challenge",
    "self_test_started_at_unix_ms",
    "self_test_completed_at_unix_ms",
    "issued_at_unix_seconds",
    "expires_at_unix_seconds",
    "ipv4_loopback_passed",
    "ipv4_direct_ip_blocked",
    "ipv4_dns_blocked",
    "ipv4_redirect_blocked",
    "ipv6_loopback_passed",
    "ipv6_non_loopback_result",
    "browser_session_ids",
    "allowed_origins",
    "deny_by_default",
    "signer_key_id",
    "signer_public_key",
    "signature_hex"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "runtime_binding_digest": { "$ref": "#/$defs/hash" },
    "machine_binding": { "$ref": "#/$defs/host" },
    "enforcement_id": { "$ref": "#/$defs/token" },
    "provider_id": { "const": "d2i.windows.wfp.loopback.v1" },
    "policy_hash": { "$ref": "#/$defs/hash" },
    "provider_key": { "$ref": "#/$defs/guid" },
    "sublayer_key": { "$ref": "#/$defs/guid" },
    "filter_keys": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/guid" }
    },
    "browser_version": { "$ref": "#/$defs/version4" },
    "browser_executable_hash": { "$ref": "#/$defs/hash" },
    "driver_version": { "$ref": "#/$defs/version4" },
    "driver_executable_hash": { "$ref": "#/$defs/hash" },
    "edge_driver_pin_hash": { "$ref": "#/$defs/hash" },
    "self_test_report_hash": { "$ref": "#/$defs/hash" },
    "activation_challenge": {
      "allOf": [
        { "$ref": "#/$defs/token" },
        { "minLength": 16, "maxLength": 256 }
      ]
    },
    "self_test_started_at_unix_ms": { "type": "integer", "minimum": 1 },
    "self_test_completed_at_unix_ms": { "type": "integer", "minimum": 1 },
    "issued_at_unix_seconds": { "type": "integer", "minimum": 1 },
    "expires_at_unix_seconds": { "type": "integer", "minimum": 2 },
    "ipv4_loopback_passed": { "const": true },
    "ipv4_direct_ip_blocked": { "const": true },
    "ipv4_dns_blocked": { "const": true },
    "ipv4_redirect_blocked": { "const": true },
    "ipv6_loopback_passed": { "const": true },
    "ipv6_non_loopback_result": { "enum": ["blocked", "explicitly_blocked"] },
    "browser_session_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https?://[^/?#@]+$" }
    },
    "deny_by_default": { "const": true },
    "signer_key_id": { "$ref": "#/$defs/token" },
    "signer_public_key": { "$ref": "#/$defs/public_key" },
    "signature_hex": { "type": "string", "pattern": "^[0-9a-fA-F]{128}$" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "public_key": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "version4": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major_version",
        "minor_version",
        "build_number",
        "architecture",
        "session_id",
        "user_sid",
        "integrity_level_rid",
        "elevation_type",
        "is_appcontainer"
      ],
      "properties": {
        "major_version": { "type": "integer", "minimum": 1 },
        "minor_version": { "type": "integer", "minimum": 0 },
        "build_number": { "type": "integer", "minimum": 1 },
        "architecture": { "$ref": "#/$defs/token" },
        "session_id": { "type": "integer", "minimum": 0 },
        "user_sid": { "type": "string", "pattern": "^S-1-[0-9-]+$" },
        "integrity_level_rid": { "type": "integer", "minimum": 1 },
        "elevation_type": { "$ref": "#/$defs/token" },
        "is_appcontainer": { "const": false }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/schemas/desktop/desktop-policy.schema.json",
  "title": "D2I Desktop Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "allowed_actor_roles",
    "allowed_capabilities",
    "approval_required_for",
    "allowed_read_roots",
    "allowed_write_roots",
    "allowed_executables",
    "network_allowed",
    "allowed_network_origins",
    "allowed_adapters",
    "approver_public_keys",
    "maximum_actions_per_session",
    "maximum_action_lifetime_ms"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "policy_id": { "$ref": "#/$defs/token" },
    "policy_version": { "$ref": "#/$defs/token" },
    "allowed_actor_roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "allowed_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "approval_required_for": {
      "type": "array",
      "uniqueItems": true,
      "allOf": [
        { "contains": { "const": "external_communication" } },
        { "contains": { "const": "credential_sensitive" } },
        { "contains": { "const": "destructive" } },
        { "contains": { "const": "privileged" } }
      ],
      "items": {
        "enum": [
          "read_only",
          "reversible",
          "external_communication",
          "credential_sensitive",
          "destructive",
          "privileged"
        ]
      }
    },
    "allowed_read_roots": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/path" }
    },
    "allowed_write_roots": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/path" }
    },
    "allowed_executables": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content_hash",
          "arguments_prefix",
          "may_request_network"
        ],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "content_hash": { "$ref": "#/$defs/hash" },
          "arguments_prefix": {
            "type": "array",
            "maxItems": 128,
            "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
          },
          "may_request_network": { "type": "boolean" }
        }
      }
    },
    "network_allowed": { "type": "boolean" },
    "allowed_network_origins": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https?://[^/@?#]+$" }
    },
    "allowed_adapters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/hash" },
      "propertyNames": { "$ref": "#/$defs/token" }
    },
    "approver_public_keys": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
      "propertyNames": { "$ref": "#/$defs/token" }
    },
    "maximum_actions_per_session": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "maximum_action_lifetime_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 900000
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "capability": {
      "enum": [
        "observe_desktop",
        "list_windows",
        "read_file",
        "list_directory",
        "write_file",
        "create_directory",
        "move_path",
        "delete_path",
        "launch_process",
        "terminate_process",
        "browser_navigate",
        "browser_interact",
        "ui_interact",
        "clipboard_read",
        "clipboard_write"
      ]
    }
  }
}

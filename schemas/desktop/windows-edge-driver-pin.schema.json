{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/schemas/desktop/windows-edge-driver-pin.schema.json",
  "title": "D2I Windows EdgeDriver Pin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "browser_name",
    "browser_executable",
    "browser_version",
    "browser_executable_hash",
    "driver_executable",
    "driver_version",
    "driver_executable_hash",
    "compatibility_version"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "browser_name": { "const": "MicrosoftEdge" },
    "browser_executable": { "$ref": "#/$defs/path" },
    "browser_version": { "$ref": "#/$defs/version4" },
    "browser_executable_hash": { "$ref": "#/$defs/hash" },
    "driver_executable": { "$ref": "#/$defs/path" },
    "driver_version": { "$ref": "#/$defs/version4" },
    "driver_executable_hash": { "$ref": "#/$defs/hash" },
    "compatibility_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 3,
      "maxLength": 4096
    },
    "version4": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}

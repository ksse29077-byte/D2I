{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/schemas/desktop/windows-wfp-verifier-broker-key.schema.json",
  "title": "D2I Windows WFP Verifier Broker Protected Key",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "key_id",
    "signer_public_key",
    "protected_private_key_hex"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "signer_public_key": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "protected_private_key_hex": {
      "type": "string",
      "minLength": 2,
      "maxLength": 8192,
      "pattern": "^[0-9a-fA-F]+$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/schemas/desktop/windows-wfp-browser-egress-self-test-report.schema.json",
  "title": "D2I Windows WFP Browser Egress Self-Test Report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "test_id",
    "activation_challenge",
    "probe_nonce",
    "browser_session_id",
    "started_at_unix_ms",
    "completed_at_unix_ms",
    "elapsed_ms",
    "total_deadline_ms",
    "blocked_observation_ms",
    "wfp_observation",
    "edge_driver_pin_hash",
    "browser_version",
    "browser_executable_hash",
    "driver_version",
    "driver_executable_hash",
    "ipv4_control",
    "ipv4_loopback",
    "ipv4_direct_ip",
    "ipv4_dns",
    "ipv4_redirect",
    "ipv6_control",
    "ipv6_loopback",
    "ipv6_non_loopback",
    "ipv4_telemetry",
    "ipv6_telemetry",
    "cleanup",
    "passed"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "test_id": { "$ref": "#/$defs/text" },
    "activation_challenge": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "probe_nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "browser_session_id": { "$ref": "#/$defs/text" },
    "started_at_unix_ms": { "type": "integer", "minimum": 1 },
    "completed_at_unix_ms": { "type": "integer", "minimum": 1 },
    "elapsed_ms": { "type": "integer", "minimum": 0, "maximum": 120000 },
    "total_deadline_ms": { "type": "integer", "minimum": 1, "maximum": 120000 },
    "blocked_observation_ms": { "type": "integer", "minimum": 1000, "maximum": 10000 },
    "wfp_observation": { "$ref": "#/$defs/wfpObservation" },
    "edge_driver_pin_hash": { "$ref": "#/$defs/hash" },
    "browser_version": { "$ref": "#/$defs/version4" },
    "browser_executable_hash": { "$ref": "#/$defs/hash" },
    "driver_version": { "$ref": "#/$defs/version4" },
    "driver_executable_hash": { "$ref": "#/$defs/hash" },
    "ipv4_control": { "$ref": "#/$defs/probe" },
    "ipv4_loopback": { "$ref": "#/$defs/probe" },
    "ipv4_direct_ip": { "$ref": "#/$defs/probe" },
    "ipv4_dns": { "$ref": "#/$defs/probe" },
    "ipv4_redirect": { "$ref": "#/$defs/probe" },
    "ipv6_control": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/probe" }
      ]
    },
    "ipv6_loopback": { "$ref": "#/$defs/probe" },
    "ipv6_non_loopback": { "$ref": "#/$defs/probe" },
    "ipv4_telemetry": { "$ref": "#/$defs/telemetry" },
    "ipv6_telemetry": { "$ref": "#/$defs/telemetry" },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browser_session_closed",
        "edge_driver_exited",
        "temporary_profile_removed"
      ],
      "properties": {
        "browser_session_closed": { "const": true },
        "edge_driver_exited": { "const": true },
        "temporary_profile_removed": { "const": true }
      }
    },
    "passed": { "const": true }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "version4": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "target",
        "disposition",
        "request_observed",
        "page_nonce_verified",
        "elapsed_ms",
        "detail_hash"
      ],
      "properties": {
        "probe_id": { "$ref": "#/$defs/text" },
        "target": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/text" }
          ]
        },
        "disposition": {
          "enum": ["passed", "blocked", "explicitly_blocked"]
        },
        "request_observed": { "type": "boolean" },
        "page_nonce_verified": { "type": "boolean" },
        "elapsed_ms": { "type": "integer", "minimum": 0, "maximum": 120000 },
        "detail_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "connectionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "peer_address",
        "accepted_after_ms",
        "first_byte_after_ms",
        "request_complete_after_ms",
        "response_complete_after_ms",
        "bytes_read",
        "outcome",
        "detail_hash"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0, "maximum": 63 },
        "peer_address": { "$ref": "#/$defs/text" },
        "accepted_after_ms": { "type": "integer", "minimum": 0, "maximum": 120000 },
        "first_byte_after_ms": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 120000
        },
        "request_complete_after_ms": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 120000
        },
        "response_complete_after_ms": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 120000
        },
        "bytes_read": { "type": "integer", "minimum": 0, "maximum": 16384 },
        "outcome": {
          "enum": [
            "idle_timeout",
            "idle_closed",
            "malformed_partial",
            "malformed_request",
            "unexpected_request",
            "valid_request",
            "response_error"
          ]
        },
        "detail_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address_family",
        "total_connections",
        "idle_connections",
        "malformed_connections",
        "valid_requests",
        "events"
      ],
      "properties": {
        "address_family": { "enum": ["ipv4", "ipv6"] },
        "total_connections": { "type": "integer", "minimum": 0, "maximum": 64 },
        "idle_connections": { "type": "integer", "minimum": 0, "maximum": 64 },
        "malformed_connections": { "type": "integer", "minimum": 0, "maximum": 64 },
        "valid_requests": { "type": "integer", "minimum": 0, "maximum": 64 },
        "events": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/connectionEvent" }
        }
      }
    },
    "wfpObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "enforcement_id",
        "provider_id",
        "policy_hash",
        "browser_executable",
        "browser_executable_hash",
        "provider_key",
        "sublayer_key",
        "filter_keys",
        "verifier_sid",
        "policy_owner_sid",
        "engine_security_descriptor_hash",
        "object_security_descriptor_hash"
      ],
      "properties": {
        "schema_version": { "enum": [2, 3] },
        "enforcement_id": { "$ref": "#/$defs/text" },
        "provider_id": { "const": "d2i.windows.wfp.loopback.v1" },
        "policy_hash": { "$ref": "#/$defs/hash" },
        "browser_executable": { "$ref": "#/$defs/text" },
        "browser_executable_hash": { "$ref": "#/$defs/hash" },
        "provider_key": { "$ref": "#/$defs/guid" },
        "sublayer_key": { "$ref": "#/$defs/guid" },
        "filter_keys": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/guid" }
        },
        "verifier_sid": {
          "type": "string",
          "pattern": "^S-1-(15-2|5-80)-[0-9-]+$"
        },
        "policy_owner_sid": {
          "type": "string",
          "pattern": "^S-1-[0-9-]+$"
        },
        "engine_security_descriptor_hash": { "$ref": "#/$defs/hash" },
        "object_security_descriptor_hash": { "$ref": "#/$defs/hash" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "schema_version": { "const": 2 } },
            "required": ["schema_version"]
          },
          "then": {
            "properties": {
              "verifier_sid": { "pattern": "^S-1-15-2-[0-9-]+$" }
            }
          }
        },
        {
          "if": {
            "properties": { "schema_version": { "const": 3 } },
            "required": ["schema_version"]
          },
          "then": {
            "properties": {
              "verifier_sid": { "pattern": "^S-1-5-80-[0-9-]+$" }
            }
          }
        }
      ]
    }
  }
}

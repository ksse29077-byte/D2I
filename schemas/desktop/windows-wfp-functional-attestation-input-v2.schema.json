{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/schemas/desktop/windows-wfp-functional-attestation-input-v2.schema.json",
  "title": "D2I Windows WFP Functional Attestation Input v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_binding_digest",
    "machine_binding",
    "browser_session_ids",
    "allowed_origins",
    "activation_challenge",
    "issued_at_unix_seconds",
    "expires_at_unix_seconds",
    "signer_key_id"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "runtime_binding_digest": { "$ref": "#/$defs/hash" },
    "machine_binding": { "$ref": "#/$defs/host" },
    "browser_session_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https?://[^/?#@]+$" }
    },
    "activation_challenge": {
      "allOf": [
        { "$ref": "#/$defs/token" },
        { "minLength": 16, "maxLength": 256 }
      ]
    },
    "issued_at_unix_seconds": { "type": "integer", "minimum": 1 },
    "expires_at_unix_seconds": { "type": "integer", "minimum": 2 },
    "signer_key_id": { "$ref": "#/$defs/token" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major_version",
        "minor_version",
        "build_number",
        "architecture",
        "session_id",
        "user_sid",
        "integrity_level_rid",
        "elevation_type",
        "is_appcontainer"
      ],
      "properties": {
        "major_version": { "type": "integer", "minimum": 1 },
        "minor_version": { "type": "integer", "minimum": 0 },
        "build_number": { "type": "integer", "minimum": 1 },
        "architecture": { "$ref": "#/$defs/token" },
        "session_id": { "type": "integer", "minimum": 0 },
        "user_sid": { "type": "string", "pattern": "^S-1-[0-9-]+$" },
        "integrity_level_rid": { "type": "integer", "minimum": 1 },
        "elevation_type": { "$ref": "#/$defs/token" },
        "is_appcontainer": { "const": false }
      }
    }
  }
}

{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/execution-planes/enterprise-idempotency-record-v1.schema.json",
    "title":  "EnterpriseIdempotencyRecordV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "record_id",
                     "case_sha256",
                     "operation_descriptor_sha256",
                     "resource_reference_sha256",
                     "idempotency_key_sha256",
                     "first_request_sha256",
                     "resolved_receipt_sha256",
                     "server_mutation_sequence",
                     "unknown_outcome",
                     "blind_replay_count",
                     "created_at_unix_ms",
                     "updated_at_unix_ms",
                     "previous_record_sha256",
                     "record_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "record_id":  {
                                         "type":  "string",
                                         "minLength":  1,
                                         "maxLength":  512,
                                         "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                     },
                       "case_sha256":  {
                                           "type":  "string",
                                           "pattern":  "^sha256:[0-9a-f]{64}$",
                                           "maxLength":  71
                                       },
                       "operation_descriptor_sha256":  {
                                                           "type":  "string",
                                                           "pattern":  "^sha256:[0-9a-f]{64}$",
                                                           "maxLength":  71
                                                       },
                       "resource_reference_sha256":  {
                                                         "type":  "string",
                                                         "pattern":  "^sha256:[0-9a-f]{64}$",
                                                         "maxLength":  71
                                                     },
                       "idempotency_key_sha256":  {
                                                      "type":  "string",
                                                      "pattern":  "^sha256:[0-9a-f]{64}$",
                                                      "maxLength":  71
                                                  },
                       "first_request_sha256":  {
                                                    "type":  "string",
                                                    "pattern":  "^sha256:[0-9a-f]{64}$",
                                                    "maxLength":  71
                                                },
                       "resolved_receipt_sha256":  {
                                                       "anyOf":  [
                                                                     {
                                                                         "type":  "string",
                                                                         "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                         "maxLength":  71
                                                                     },
                                                                     {
                                                                         "type":  "null"
                                                                     }
                                                                 ]
                                                   },
                       "server_mutation_sequence":  {
                                                        "anyOf":  [
                                                                      {
                                                                          "type":  "integer",
                                                                          "minimum":  0,
                                                                          "maximum":  18446744073709551615
                                                                      },
                                                                      {
                                                                          "type":  "null"
                                                                      }
                                                                  ]
                                                    },
                       "unknown_outcome":  {
                                               "type":  "boolean"
                                           },
                       "blind_replay_count":  {
                                                  "type":  "integer",
                                                  "minimum":  0,
                                                  "maximum":  4294967295
                                              },
                       "created_at_unix_ms":  {
                                                  "type":  "integer",
                                                  "minimum":  0,
                                                  "maximum":  18446744073709551615
                                              },
                       "updated_at_unix_ms":  {
                                                  "type":  "integer",
                                                  "minimum":  0,
                                                  "maximum":  18446744073709551615
                                              },
                       "previous_record_sha256":  {
                                                      "type":  "string",
                                                      "pattern":  "^sha256:[0-9a-f]{64}$",
                                                      "maxLength":  71
                                                  },
                       "record_sha256":  {
                                             "type":  "string",
                                             "pattern":  "^sha256:[0-9a-f]{64}$",
                                             "maxLength":  71
                                         }
                   }
}

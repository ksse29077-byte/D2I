{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/execution-planes/enterprise-connector-approval-v1.schema.json",
    "title":  "EnterpriseConnectorApprovalV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "approval_id",
                     "organization_id",
                     "connector_pack_sha256",
                     "approved_environment_id",
                     "approved_role_ids",
                     "approved_operation_ids",
                     "approved_capability_ids",
                     "approved_origins",
                     "approved_ports",
                     "transport_policy",
                     "credential_profile_id",
                     "issued_at_unix_ms",
                     "expires_at_unix_ms",
                     "signer_id",
                     "signing_key_id",
                     "nonce",
                     "evidence_ids",
                     "approval_sha256",
                     "signature_hex"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "approval_id":  {
                                           "type":  "string",
                                           "minLength":  1,
                                           "maxLength":  512,
                                           "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                       },
                       "organization_id":  {
                                               "type":  "string",
                                               "minLength":  1,
                                               "maxLength":  512,
                                               "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                           },
                       "connector_pack_sha256":  {
                                                     "type":  "string",
                                                     "pattern":  "^sha256:[0-9a-f]{64}$",
                                                     "maxLength":  71
                                                 },
                       "approved_environment_id":  {
                                                       "type":  "string",
                                                       "minLength":  1,
                                                       "maxLength":  512,
                                                       "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                   },
                       "approved_role_ids":  {
                                                 "type":  "array",
                                                 "maxItems":  512,
                                                 "uniqueItems":  true,
                                                 "items":  {
                                                               "type":  "string",
                                                               "minLength":  1,
                                                               "maxLength":  512,
                                                               "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                           }
                                             },
                       "approved_operation_ids":  {
                                                      "type":  "array",
                                                      "maxItems":  512,
                                                      "uniqueItems":  true,
                                                      "items":  {
                                                                    "type":  "string",
                                                                    "minLength":  1,
                                                                    "maxLength":  512,
                                                                    "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                }
                                                  },
                       "approved_capability_ids":  {
                                                       "type":  "array",
                                                       "maxItems":  512,
                                                       "uniqueItems":  true,
                                                       "items":  {
                                                                     "type":  "string",
                                                                     "minLength":  1,
                                                                     "maxLength":  512,
                                                                     "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                 }
                                                   },
                       "approved_origins":  {
                                                "type":  "array",
                                                "maxItems":  512,
                                                "uniqueItems":  true,
                                                "items":  {
                                                              "type":  "string",
                                                              "minLength":  1,
                                                              "maxLength":  512
                                                          }
                                            },
                       "approved_ports":  {
                                              "type":  "array",
                                              "maxItems":  512,
                                              "uniqueItems":  true,
                                              "items":  {
                                                            "type":  "integer",
                                                            "minimum":  0,
                                                            "maximum":  4294967295
                                                        }
                                          },
                       "transport_policy":  {
                                                "type":  "string",
                                                "enum":  [
                                                             "https_only",
                                                             "signed_loopback_http_only"
                                                         ]
                                            },
                       "credential_profile_id":  {
                                                     "type":  "string",
                                                     "minLength":  1,
                                                     "maxLength":  512,
                                                     "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                 },
                       "issued_at_unix_ms":  {
                                                 "type":  "integer",
                                                 "minimum":  0,
                                                 "maximum":  18446744073709551615
                                             },
                       "expires_at_unix_ms":  {
                                                  "type":  "integer",
                                                  "minimum":  0,
                                                  "maximum":  18446744073709551615
                                              },
                       "signer_id":  {
                                         "type":  "string",
                                         "minLength":  1,
                                         "maxLength":  512,
                                         "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                     },
                       "signing_key_id":  {
                                              "type":  "string",
                                              "minLength":  1,
                                              "maxLength":  512,
                                              "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                          },
                       "nonce":  {
                                     "type":  "string",
                                     "minLength":  1,
                                     "maxLength":  512
                                 },
                       "evidence_ids":  {
                                            "type":  "array",
                                            "maxItems":  512,
                                            "uniqueItems":  true,
                                            "items":  {
                                                          "type":  "string",
                                                          "minLength":  1,
                                                          "maxLength":  512,
                                                          "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                      }
                                        },
                       "approval_sha256":  {
                                               "type":  "string",
                                               "pattern":  "^sha256:[0-9a-f]{64}$",
                                               "maxLength":  71
                                           },
                       "signature_hex":  {
                                             "type":  "string",
                                             "pattern":  "^[0-9a-f]{128}$",
                                             "maxLength":  128
                                         }
                   }
}

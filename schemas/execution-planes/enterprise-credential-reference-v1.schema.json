{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/execution-planes/enterprise-credential-reference-v1.schema.json",
    "title":  "EnterpriseCredentialReferenceV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "credential_reference_id",
                     "organization_id",
                     "connector_pack_id",
                     "auth_scheme_class_id",
                     "allowed_origin",
                     "allowed_operation_class_ids",
                     "secret_present",
                     "secret_source_class_id",
                     "expires_at_unix_ms",
                     "generation",
                     "credential_policy_sha256",
                     "evidence_ids",
                     "reference_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "credential_reference_id":  {
                                                       "type":  "string",
                                                       "minLength":  1,
                                                       "maxLength":  512,
                                                       "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                   },
                       "organization_id":  {
                                               "type":  "string",
                                               "minLength":  1,
                                               "maxLength":  512,
                                               "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                           },
                       "connector_pack_id":  {
                                                 "type":  "string",
                                                 "minLength":  1,
                                                 "maxLength":  512,
                                                 "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                             },
                       "auth_scheme_class_id":  {
                                                    "type":  "string",
                                                    "minLength":  1,
                                                    "maxLength":  512,
                                                    "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                },
                       "allowed_origin":  {
                                              "type":  "string",
                                              "minLength":  1,
                                              "maxLength":  512
                                          },
                       "allowed_operation_class_ids":  {
                                                           "type":  "array",
                                                           "maxItems":  512,
                                                           "uniqueItems":  true,
                                                           "items":  {
                                                                         "type":  "string",
                                                                         "minLength":  1,
                                                                         "maxLength":  512,
                                                                         "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                                     }
                                                       },
                       "secret_present":  {
                                              "type":  "boolean"
                                          },
                       "secret_source_class_id":  {
                                                      "type":  "string",
                                                      "minLength":  1,
                                                      "maxLength":  512,
                                                      "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                  },
                       "expires_at_unix_ms":  {
                                                  "type":  "integer",
                                                  "minimum":  0,
                                                  "maximum":  18446744073709551615
                                              },
                       "generation":  {
                                          "type":  "integer",
                                          "minimum":  0,
                                          "maximum":  18446744073709551615
                                      },
                       "credential_policy_sha256":  {
                                                        "type":  "string",
                                                        "pattern":  "^sha256:[0-9a-f]{64}$",
                                                        "maxLength":  71
                                                    },
                       "evidence_ids":  {
                                            "type":  "array",
                                            "maxItems":  512,
                                            "uniqueItems":  true,
                                            "items":  {
                                                          "type":  "string",
                                                          "minLength":  1,
                                                          "maxLength":  512,
                                                          "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                      }
                                        },
                       "reference_sha256":  {
                                                "type":  "string",
                                                "pattern":  "^sha256:[0-9a-f]{64}$",
                                                "maxLength":  71
                                            }
                   }
}

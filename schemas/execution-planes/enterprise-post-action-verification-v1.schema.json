{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/execution-planes/enterprise-post-action-verification-v1.schema.json",
    "title":  "EnterprisePostActionVerificationV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "verification_id",
                     "case_sha256",
                     "operation_receipt_sha256",
                     "fresh_observation_sha256",
                     "expected_postcondition_id",
                     "status",
                     "compared_field_ids",
                     "failure_reason_code",
                     "verified_at_unix_ms",
                     "evidence_ids",
                     "verification_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "verification_id":  {
                                               "type":  "string",
                                               "minLength":  1,
                                               "maxLength":  512,
                                               "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                           },
                       "case_sha256":  {
                                           "type":  "string",
                                           "pattern":  "^sha256:[0-9a-f]{64}$",
                                           "maxLength":  71
                                       },
                       "operation_receipt_sha256":  {
                                                        "type":  "string",
                                                        "pattern":  "^sha256:[0-9a-f]{64}$",
                                                        "maxLength":  71
                                                    },
                       "fresh_observation_sha256":  {
                                                        "type":  "string",
                                                        "pattern":  "^sha256:[0-9a-f]{64}$",
                                                        "maxLength":  71
                                                    },
                       "expected_postcondition_id":  {
                                                         "type":  "string",
                                                         "minLength":  1,
                                                         "maxLength":  512,
                                                         "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                     },
                       "status":  {
                                      "type":  "string",
                                      "enum":  [
                                                   "verified",
                                                   "rejected",
                                                   "human_exception_required"
                                               ]
                                  },
                       "compared_field_ids":  {
                                                  "type":  "array",
                                                  "maxItems":  512,
                                                  "uniqueItems":  true,
                                                  "items":  {
                                                                "type":  "string",
                                                                "minLength":  1,
                                                                "maxLength":  512,
                                                                "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                            }
                                              },
                       "failure_reason_code":  {
                                                   "anyOf":  [
                                                                 {
                                                                     "type":  "string",
                                                                     "minLength":  1,
                                                                     "maxLength":  512
                                                                 },
                                                                 {
                                                                     "type":  "null"
                                                                 }
                                                             ]
                                               },
                       "verified_at_unix_ms":  {
                                                   "type":  "integer",
                                                   "minimum":  0,
                                                   "maximum":  18446744073709551615
                                               },
                       "evidence_ids":  {
                                            "type":  "array",
                                            "maxItems":  512,
                                            "uniqueItems":  true,
                                            "items":  {
                                                          "type":  "string",
                                                          "minLength":  1,
                                                          "maxLength":  512,
                                                          "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                      }
                                        },
                       "verification_sha256":  {
                                                   "type":  "string",
                                                   "pattern":  "^sha256:[0-9a-f]{64}$",
                                                   "maxLength":  71
                                               }
                   }
}

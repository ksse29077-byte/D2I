{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/execution-planes/enterprise-connector-health-v1.schema.json",
    "title":  "EnterpriseConnectorHealthV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "health_id",
                     "connector_pack_sha256",
                     "endpoint_binding_sha256",
                     "status",
                     "successful_observations",
                     "successful_mutations",
                     "consecutive_failures",
                     "rate_limit_events",
                     "authentication_failures",
                     "malformed_response_count",
                     "measured_at_unix_ms",
                     "evidence_ids",
                     "health_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "health_id":  {
                                         "type":  "string",
                                         "minLength":  1,
                                         "maxLength":  512,
                                         "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                     },
                       "connector_pack_sha256":  {
                                                     "type":  "string",
                                                     "pattern":  "^sha256:[0-9a-f]{64}$",
                                                     "maxLength":  71
                                                 },
                       "endpoint_binding_sha256":  {
                                                       "type":  "string",
                                                       "pattern":  "^sha256:[0-9a-f]{64}$",
                                                       "maxLength":  71
                                                   },
                       "status":  {
                                      "type":  "string",
                                      "enum":  [
                                                   "healthy",
                                                   "degraded",
                                                   "unavailable"
                                               ]
                                  },
                       "successful_observations":  {
                                                       "type":  "integer",
                                                       "minimum":  0,
                                                       "maximum":  4294967295
                                                   },
                       "successful_mutations":  {
                                                    "type":  "integer",
                                                    "minimum":  0,
                                                    "maximum":  4294967295
                                                },
                       "consecutive_failures":  {
                                                    "type":  "integer",
                                                    "minimum":  0,
                                                    "maximum":  4294967295
                                                },
                       "rate_limit_events":  {
                                                 "type":  "integer",
                                                 "minimum":  0,
                                                 "maximum":  4294967295
                                             },
                       "authentication_failures":  {
                                                       "type":  "integer",
                                                       "minimum":  0,
                                                       "maximum":  4294967295
                                                   },
                       "malformed_response_count":  {
                                                        "type":  "integer",
                                                        "minimum":  0,
                                                        "maximum":  4294967295
                                                    },
                       "measured_at_unix_ms":  {
                                                   "type":  "integer",
                                                   "minimum":  0,
                                                   "maximum":  18446744073709551615
                                               },
                       "evidence_ids":  {
                                            "type":  "array",
                                            "maxItems":  512,
                                            "uniqueItems":  true,
                                            "items":  {
                                                          "type":  "string",
                                                          "minLength":  1,
                                                          "maxLength":  512,
                                                          "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                      }
                                        },
                       "health_sha256":  {
                                             "type":  "string",
                                             "pattern":  "^sha256:[0-9a-f]{64}$",
                                             "maxLength":  71
                                         }
                   }
}

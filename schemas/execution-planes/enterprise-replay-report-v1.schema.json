{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/execution-planes/enterprise-replay-report-v1.schema.json",
    "title":  "EnterpriseReplayReportV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "report_id",
                     "synthetic_case_count",
                     "replay_runs",
                     "deterministic_match_count",
                     "deterministic_mismatch_count",
                     "input_set_sha256",
                     "first_output_sha256",
                     "final_output_sha256",
                     "evidence_ids",
                     "report_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "report_id":  {
                                         "type":  "string",
                                         "minLength":  1,
                                         "maxLength":  512,
                                         "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                     },
                       "synthetic_case_count":  {
                                                    "type":  "integer",
                                                    "minimum":  0,
                                                    "maximum":  4294967295
                                                },
                       "replay_runs":  {
                                           "type":  "integer",
                                           "minimum":  0,
                                           "maximum":  4294967295
                                       },
                       "deterministic_match_count":  {
                                                         "type":  "integer",
                                                         "minimum":  0,
                                                         "maximum":  4294967295
                                                     },
                       "deterministic_mismatch_count":  {
                                                            "type":  "integer",
                                                            "minimum":  0,
                                                            "maximum":  4294967295
                                                        },
                       "input_set_sha256":  {
                                                "type":  "string",
                                                "pattern":  "^sha256:[0-9a-f]{64}$",
                                                "maxLength":  71
                                            },
                       "first_output_sha256":  {
                                                   "type":  "string",
                                                   "pattern":  "^sha256:[0-9a-f]{64}$",
                                                   "maxLength":  71
                                               },
                       "final_output_sha256":  {
                                                   "type":  "string",
                                                   "pattern":  "^sha256:[0-9a-f]{64}$",
                                                   "maxLength":  71
                                               },
                       "evidence_ids":  {
                                            "type":  "array",
                                            "maxItems":  512,
                                            "uniqueItems":  true,
                                            "items":  {
                                                          "type":  "string",
                                                          "minLength":  1,
                                                          "maxLength":  512,
                                                          "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                      }
                                        },
                       "report_sha256":  {
                                             "type":  "string",
                                             "pattern":  "^sha256:[0-9a-f]{64}$",
                                             "maxLength":  71
                                         }
                   }
}

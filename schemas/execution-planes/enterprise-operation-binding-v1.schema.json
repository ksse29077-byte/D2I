{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://d2i.local/schemas/execution-planes/enterprise-operation-binding-v1.schema.json",
    "title":  "EnterpriseOperationBindingV1",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "binding_id",
                     "case_sha256",
                     "role_contract_sha256",
                     "delegation_sha256",
                     "ownership_sha256",
                     "lease_sha256",
                     "work_grant_sha256",
                     "autonomy_admission_sha256",
                     "planner_intent_sha256",
                     "current_observation_sha256",
                     "resource_version",
                     "connector_pack_sha256",
                     "connector_approval_sha256",
                     "endpoint_binding_sha256",
                     "credential_reference_sha256",
                     "operation_descriptor_sha256",
                     "policy_decision_sha256",
                     "cognitive_activation_admission_sha256",
                     "activation_one_time_use_id",
                     "approved_argument_artifact_hashes",
                     "idempotency_key_sha256",
                     "timeout_ms",
                     "evidence_ids",
                     "binding_sha256"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "binding_id":  {
                                          "type":  "string",
                                          "minLength":  1,
                                          "maxLength":  512,
                                          "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                      },
                       "case_sha256":  {
                                           "type":  "string",
                                           "pattern":  "^sha256:[0-9a-f]{64}$",
                                           "maxLength":  71
                                       },
                       "role_contract_sha256":  {
                                                    "type":  "string",
                                                    "pattern":  "^sha256:[0-9a-f]{64}$",
                                                    "maxLength":  71
                                                },
                       "delegation_sha256":  {
                                                 "type":  "string",
                                                 "pattern":  "^sha256:[0-9a-f]{64}$",
                                                 "maxLength":  71
                                             },
                       "ownership_sha256":  {
                                                "type":  "string",
                                                "pattern":  "^sha256:[0-9a-f]{64}$",
                                                "maxLength":  71
                                            },
                       "lease_sha256":  {
                                            "type":  "string",
                                            "pattern":  "^sha256:[0-9a-f]{64}$",
                                            "maxLength":  71
                                        },
                       "work_grant_sha256":  {
                                                 "type":  "string",
                                                 "pattern":  "^sha256:[0-9a-f]{64}$",
                                                 "maxLength":  71
                                             },
                       "autonomy_admission_sha256":  {
                                                         "type":  "string",
                                                         "pattern":  "^sha256:[0-9a-f]{64}$",
                                                         "maxLength":  71
                                                     },
                       "planner_intent_sha256":  {
                                                     "type":  "string",
                                                     "pattern":  "^sha256:[0-9a-f]{64}$",
                                                     "maxLength":  71
                                                 },
                       "current_observation_sha256":  {
                                                          "type":  "string",
                                                          "pattern":  "^sha256:[0-9a-f]{64}$",
                                                          "maxLength":  71
                                                      },
                       "resource_version":  {
                                                "type":  "string",
                                                "minLength":  1,
                                                "maxLength":  512
                                            },
                       "connector_pack_sha256":  {
                                                     "type":  "string",
                                                     "pattern":  "^sha256:[0-9a-f]{64}$",
                                                     "maxLength":  71
                                                 },
                       "connector_approval_sha256":  {
                                                         "type":  "string",
                                                         "pattern":  "^sha256:[0-9a-f]{64}$",
                                                         "maxLength":  71
                                                     },
                       "endpoint_binding_sha256":  {
                                                       "type":  "string",
                                                       "pattern":  "^sha256:[0-9a-f]{64}$",
                                                       "maxLength":  71
                                                   },
                       "credential_reference_sha256":  {
                                                           "type":  "string",
                                                           "pattern":  "^sha256:[0-9a-f]{64}$",
                                                           "maxLength":  71
                                                       },
                       "operation_descriptor_sha256":  {
                                                           "type":  "string",
                                                           "pattern":  "^sha256:[0-9a-f]{64}$",
                                                           "maxLength":  71
                                                       },
                       "policy_decision_sha256":  {
                                                      "type":  "string",
                                                      "pattern":  "^sha256:[0-9a-f]{64}$",
                                                      "maxLength":  71
                                                  },
                       "cognitive_activation_admission_sha256":  {
                                                                     "type":  "string",
                                                                     "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                     "maxLength":  71
                                                                 },
                       "activation_one_time_use_id":  {
                                                          "type":  "string",
                                                          "minLength":  1,
                                                          "maxLength":  512,
                                                          "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                      },
                       "approved_argument_artifact_hashes":  {
                                                                 "type":  "array",
                                                                 "maxItems":  512,
                                                                 "uniqueItems":  true,
                                                                 "items":  {
                                                                               "type":  "string",
                                                                               "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                               "maxLength":  71
                                                                           }
                                                             },
                       "idempotency_key_sha256":  {
                                                      "type":  "string",
                                                      "pattern":  "^sha256:[0-9a-f]{64}$",
                                                      "maxLength":  71
                                                  },
                       "timeout_ms":  {
                                          "type":  "integer",
                                          "minimum":  0,
                                          "maximum":  18446744073709551615
                                      },
                       "evidence_ids":  {
                                            "type":  "array",
                                            "maxItems":  512,
                                            "uniqueItems":  true,
                                            "items":  {
                                                          "type":  "string",
                                                          "minLength":  1,
                                                          "maxLength":  512,
                                                          "pattern":  "^[A-Za-z0-9._:/{}-]+$"
                                                      }
                                        },
                       "binding_sha256":  {
                                              "type":  "string",
                                              "pattern":  "^sha256:[0-9a-f]{64}$",
                                              "maxLength":  71
                                          }
                   }
}

{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://schemas.d2i.local/design/design-exemplar-match-v1.schema.json",
    "title":  "DesignExemplarMatchV1",
    "$ref":  "#/$defs/DesignExemplarMatchV1",
    "$defs":  {
                  "DesignExemplarMatchV1":  {
                                                "type":  "object",
                                                "additionalProperties":  false,
                                                "required":  [
                                                                 "exemplar_id",
                                                                 "template_family_id",
                                                                 "distance_millionths",
                                                                 "evidence_ids"
                                                             ],
                                                "properties":  {
                                                                   "exemplar_id":  {
                                                                                       "type":  "string",
                                                                                       "minLength":  1,
                                                                                       "maxLength":  512,
                                                                                       "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                                   },
                                                                   "template_family_id":  {
                                                                                              "type":  "string",
                                                                                              "minLength":  1,
                                                                                              "maxLength":  512,
                                                                                              "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                                          },
                                                                   "distance_millionths":  {
                                                                                               "type":  "integer",
                                                                                               "minimum":  0,
                                                                                               "maximum":  4294967295
                                                                                           },
                                                                   "evidence_ids":  {
                                                                                        "type":  "array",
                                                                                        "maxItems":  4096,
                                                                                        "items":  {
                                                                                                      "type":  "string",
                                                                                                      "minLength":  1,
                                                                                                      "maxLength":  2048
                                                                                                  }
                                                                                    }
                                                               }
                                            }
              }
}

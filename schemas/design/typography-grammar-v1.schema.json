{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://schemas.d2i.local/design/typography-grammar-v1.schema.json",
    "title":  "TypographyGrammarV1",
    "$ref":  "#/$defs/TypographyGrammarV1",
    "$defs":  {
                  "CommonDesignRoleV1":  {
                                             "type":  "string",
                                             "enum":  [
                                                          "artifact_title",
                                                          "artifact_subtitle",
                                                          "section_title",
                                                          "heading1",
                                                          "heading2",
                                                          "body",
                                                          "caption",
                                                          "footnote",
                                                          "kpi_value",
                                                          "kpi_label",
                                                          "table_header",
                                                          "table_body",
                                                          "table_total",
                                                          "chart_title",
                                                          "chart_label",
                                                          "image_caption",
                                                          "warning",
                                                          "emphasis",
                                                          "muted"
                                                      ]
                                         },
                  "DesignDistributionV1":  {
                                               "type":  "object",
                                               "additionalProperties":  false,
                                               "required":  [
                                                                "minimum_millionths",
                                                                "q1_millionths",
                                                                "median_millionths",
                                                                "q3_millionths",
                                                                "maximum_millionths"
                                                            ],
                                               "properties":  {
                                                                  "minimum_millionths":  {
                                                                                             "type":  "integer",
                                                                                             "minimum":  0,
                                                                                             "maximum":  4294967295
                                                                                         },
                                                                  "q1_millionths":  {
                                                                                        "type":  "integer",
                                                                                        "minimum":  0,
                                                                                        "maximum":  4294967295
                                                                                    },
                                                                  "median_millionths":  {
                                                                                            "type":  "integer",
                                                                                            "minimum":  0,
                                                                                            "maximum":  4294967295
                                                                                        },
                                                                  "q3_millionths":  {
                                                                                        "type":  "integer",
                                                                                        "minimum":  0,
                                                                                        "maximum":  4294967295
                                                                                    },
                                                                  "maximum_millionths":  {
                                                                                             "type":  "integer",
                                                                                             "minimum":  0,
                                                                                             "maximum":  4294967295
                                                                                         }
                                                              }
                                           },
                  "DesignFontRolePolicyV1":  {
                                                 "type":  "object",
                                                 "additionalProperties":  false,
                                                 "required":  [
                                                                  "role",
                                                                  "preferred_font_family",
                                                                  "approved_fallback_families",
                                                                  "weight_min",
                                                                  "weight_max",
                                                                  "font_size_min_millipoints",
                                                                  "font_size_preferred_millipoints",
                                                                  "font_size_max_millipoints",
                                                                  "line_spacing_min_millionths",
                                                                  "line_spacing_max_millionths",
                                                                  "letter_spacing_min_millipoints",
                                                                  "letter_spacing_max_millipoints",
                                                                  "script_coverage_ids"
                                                              ],
                                                 "properties":  {
                                                                    "role":  {
                                                                                 "$ref":  "#/$defs/CommonDesignRoleV1"
                                                                             },
                                                                    "preferred_font_family":  {
                                                                                                  "type":  "string",
                                                                                                  "minLength":  1,
                                                                                                  "maxLength":  2048
                                                                                              },
                                                                    "approved_fallback_families":  {
                                                                                                       "type":  "array",
                                                                                                       "maxItems":  4096,
                                                                                                       "items":  {
                                                                                                                     "type":  "string",
                                                                                                                     "minLength":  1,
                                                                                                                     "maxLength":  2048
                                                                                                                 }
                                                                                                   },
                                                                    "weight_min":  {
                                                                                       "type":  "integer",
                                                                                       "minimum":  0,
                                                                                       "maximum":  65535
                                                                                   },
                                                                    "weight_max":  {
                                                                                       "type":  "integer",
                                                                                       "minimum":  0,
                                                                                       "maximum":  65535
                                                                                   },
                                                                    "font_size_min_millipoints":  {
                                                                                                      "type":  "integer",
                                                                                                      "minimum":  0,
                                                                                                      "maximum":  4294967295
                                                                                                  },
                                                                    "font_size_preferred_millipoints":  {
                                                                                                            "type":  "integer",
                                                                                                            "minimum":  0,
                                                                                                            "maximum":  4294967295
                                                                                                        },
                                                                    "font_size_max_millipoints":  {
                                                                                                      "type":  "integer",
                                                                                                      "minimum":  0,
                                                                                                      "maximum":  4294967295
                                                                                                  },
                                                                    "line_spacing_min_millionths":  {
                                                                                                        "type":  "integer",
                                                                                                        "minimum":  0,
                                                                                                        "maximum":  4294967295
                                                                                                    },
                                                                    "line_spacing_max_millionths":  {
                                                                                                        "type":  "integer",
                                                                                                        "minimum":  0,
                                                                                                        "maximum":  4294967295
                                                                                                    },
                                                                    "letter_spacing_min_millipoints":  {
                                                                                                           "type":  "integer",
                                                                                                           "minimum":  -2147483648,
                                                                                                           "maximum":  2147483647
                                                                                                       },
                                                                    "letter_spacing_max_millipoints":  {
                                                                                                           "type":  "integer",
                                                                                                           "minimum":  -2147483648,
                                                                                                           "maximum":  2147483647
                                                                                                       },
                                                                    "script_coverage_ids":  {
                                                                                                "type":  "array",
                                                                                                "maxItems":  4096,
                                                                                                "items":  {
                                                                                                              "type":  "string",
                                                                                                              "minLength":  1,
                                                                                                              "maxLength":  2048
                                                                                                          }
                                                                                            }
                                                                }
                                             },
                  "TypographyGrammarV1":  {
                                              "type":  "object",
                                              "additionalProperties":  false,
                                              "required":  [
                                                               "schema_version",
                                                               "grammar_id",
                                                               "organization_id",
                                                               "role_policies",
                                                               "hierarchy_ratio_rules",
                                                               "grammar_sha256"
                                                           ],
                                              "properties":  {
                                                                 "schema_version":  {
                                                                                        "type":  "integer",
                                                                                        "minimum":  0,
                                                                                        "maximum":  4294967295
                                                                                    },
                                                                 "grammar_id":  {
                                                                                    "type":  "string",
                                                                                    "minLength":  1,
                                                                                    "maxLength":  512,
                                                                                    "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                                },
                                                                 "organization_id":  {
                                                                                         "type":  "string",
                                                                                         "minLength":  1,
                                                                                         "maxLength":  512,
                                                                                         "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                                     },
                                                                 "role_policies":  {
                                                                                       "type":  "array",
                                                                                       "maxItems":  4096,
                                                                                       "items":  {
                                                                                                     "$ref":  "#/$defs/DesignFontRolePolicyV1"
                                                                                                 }
                                                                                   },
                                                                 "hierarchy_ratio_rules":  {
                                                                                               "type":  "array",
                                                                                               "maxItems":  4096,
                                                                                               "items":  {
                                                                                                             "$ref":  "#/$defs/DesignDistributionV1"
                                                                                                         }
                                                                                           },
                                                                 "grammar_sha256":  {
                                                                                        "type":  "string",
                                                                                        "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                        "maxLength":  71
                                                                                    }
                                                             }
                                          }
              }
}

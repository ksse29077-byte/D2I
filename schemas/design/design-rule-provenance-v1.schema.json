{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://schemas.d2i.local/design/design-rule-provenance-v1.schema.json",
    "title":  "DesignRuleProvenanceV1",
    "$ref":  "#/$defs/DesignRuleProvenanceV1",
    "$defs":  {
                  "DesignDistributionV1":  {
                                               "type":  "object",
                                               "additionalProperties":  false,
                                               "required":  [
                                                                "minimum_millionths",
                                                                "q1_millionths",
                                                                "median_millionths",
                                                                "q3_millionths",
                                                                "maximum_millionths"
                                                            ],
                                               "properties":  {
                                                                  "minimum_millionths":  {
                                                                                             "type":  "integer",
                                                                                             "minimum":  0,
                                                                                             "maximum":  4294967295
                                                                                         },
                                                                  "q1_millionths":  {
                                                                                        "type":  "integer",
                                                                                        "minimum":  0,
                                                                                        "maximum":  4294967295
                                                                                    },
                                                                  "median_millionths":  {
                                                                                            "type":  "integer",
                                                                                            "minimum":  0,
                                                                                            "maximum":  4294967295
                                                                                        },
                                                                  "q3_millionths":  {
                                                                                        "type":  "integer",
                                                                                        "minimum":  0,
                                                                                        "maximum":  4294967295
                                                                                    },
                                                                  "maximum_millionths":  {
                                                                                             "type":  "integer",
                                                                                             "minimum":  0,
                                                                                             "maximum":  4294967295
                                                                                         }
                                                              }
                                           },
                  "DesignRuleProvenanceV1":  {
                                                 "type":  "object",
                                                 "additionalProperties":  false,
                                                 "required":  [
                                                                  "rule_id",
                                                                  "source_exemplar_ids",
                                                                  "source_sha256s",
                                                                  "support_count",
                                                                  "gold_support_count",
                                                                  "confidence_millionths",
                                                                  "distribution",
                                                                  "rule_sha256"
                                                              ],
                                                 "properties":  {
                                                                    "rule_id":  {
                                                                                    "type":  "string",
                                                                                    "minLength":  1,
                                                                                    "maxLength":  512,
                                                                                    "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                                },
                                                                    "source_exemplar_ids":  {
                                                                                                "type":  "array",
                                                                                                "maxItems":  4096,
                                                                                                "items":  {
                                                                                                              "type":  "string",
                                                                                                              "minLength":  1,
                                                                                                              "maxLength":  2048
                                                                                                          }
                                                                                            },
                                                                    "source_sha256s":  {
                                                                                           "type":  "array",
                                                                                           "maxItems":  4096,
                                                                                           "items":  {
                                                                                                         "type":  "string",
                                                                                                         "minLength":  1,
                                                                                                         "maxLength":  2048
                                                                                                     }
                                                                                       },
                                                                    "support_count":  {
                                                                                          "type":  "integer",
                                                                                          "minimum":  0,
                                                                                          "maximum":  4294967295
                                                                                      },
                                                                    "gold_support_count":  {
                                                                                               "type":  "integer",
                                                                                               "minimum":  0,
                                                                                               "maximum":  4294967295
                                                                                           },
                                                                    "confidence_millionths":  {
                                                                                                  "type":  "integer",
                                                                                                  "minimum":  0,
                                                                                                  "maximum":  4294967295
                                                                                              },
                                                                    "distribution":  {
                                                                                         "$ref":  "#/$defs/DesignDistributionV1"
                                                                                     },
                                                                    "rule_sha256":  {
                                                                                        "type":  "string",
                                                                                        "pattern":  "^sha256:[0-9a-f]{64}$",
                                                                                        "maxLength":  71
                                                                                    }
                                                                }
                                             }
              }
}

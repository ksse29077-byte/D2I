{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://schemas.d2i.local/design/design-refinement-step-v1.schema.json",
    "title":  "DesignRefinementStepV1",
    "$ref":  "#/$defs/DesignRefinementStepV1",
    "$defs":  {
                  "DesignRepairOperationV1":  {
                                                  "type":  "string",
                                                  "enum":  [
                                                               "switch_layout",
                                                               "split_slide",
                                                               "resize_within_allowed_range",
                                                               "adjust_spacing_within_grammar",
                                                               "reflow_table",
                                                               "change_image_fit",
                                                               "shorten_language",
                                                               "move_to_allowed_slot"
                                                           ]
                                              },
                  "DesignRefinementStepV1":  {
                                                 "type":  "object",
                                                 "additionalProperties":  false,
                                                 "required":  [
                                                                  "sequence",
                                                                  "operation",
                                                                  "target_id",
                                                                  "reason_code"
                                                              ],
                                                 "properties":  {
                                                                    "sequence":  {
                                                                                     "type":  "integer",
                                                                                     "minimum":  0,
                                                                                     "maximum":  4294967295
                                                                                 },
                                                                    "operation":  {
                                                                                      "$ref":  "#/$defs/DesignRepairOperationV1"
                                                                                  },
                                                                    "target_id":  {
                                                                                      "type":  "string",
                                                                                      "minLength":  1,
                                                                                      "maxLength":  512,
                                                                                      "pattern":  "^[A-Za-z0-9._:/-]+$"
                                                                                  },
                                                                    "reason_code":  {
                                                                                        "type":  "string",
                                                                                        "minLength":  1,
                                                                                        "maxLength":  2048
                                                                                    }
                                                                }
                                             }
              }
}

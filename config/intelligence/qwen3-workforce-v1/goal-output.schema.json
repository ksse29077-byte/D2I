{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "objective", "scope", "required_outcomes", "constraints", "success_criteria", "forbidden_outcomes", "risk_estimate", "confirmation_suggestion", "ambiguities", "missing_fields", "questions", "confidence_millionths", "reason_codes", "evidence_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["succeeded", "clarification_required", "escalation_required", "unsupported"]},
    "objective": {"type": ["string", "null"], "maxLength": 256},
    "scope": {"$ref": "#/$defs/texts"},
    "required_outcomes": {"$ref": "#/$defs/texts"},
    "constraints": {"$ref": "#/$defs/texts"},
    "success_criteria": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/criterion"}},
    "forbidden_outcomes": {"$ref": "#/$defs/texts"},
    "risk_estimate": {"type": ["string", "null"], "enum": ["read_only", "reversible", "business_state_change", "high_criticality", null]},
    "confirmation_suggestion": {"type": ["string", "null"], "enum": ["never", "before_risky_action", "before_irreversible_action", "always", null]},
    "ambiguities": {"$ref": "#/$defs/small_texts"},
    "missing_fields": {"$ref": "#/$defs/small_texts"},
    "questions": {"$ref": "#/$defs/small_texts"},
    "confidence_millionths": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "reason_codes": {"$ref": "#/$defs/reasons"},
    "evidence_refs": {"$ref": "#/$defs/ids"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 256},
    "texts": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "small_texts": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_state_id", "expected_value_class", "required"],
      "properties": {
        "target_state_id": {"$ref": "#/$defs/id"},
        "expected_value_class": {"$ref": "#/$defs/id"},
        "required": {"type": "boolean"}
      }
    },
    "reasons": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"enum": ["ambiguous_objective", "authority_expansion", "conflicting_evidence", "conflicting_objective", "credential_requested", "insufficient_evidence", "invalid_output", "irreversible_requested", "missing_scope", "missing_success_criteria", "missing_value", "no_eligible_action", "policy_unknown", "prompt_injection", "provider_unavailable", "resource_limit", "stale_input", "unsupported_locale", "unsupported_operation"]}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "model_inferences", "unknowns", "conflicts", "confidence_millionths", "reason_codes", "evidence_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["succeeded", "clarification_required", "escalation_required", "unsupported"]},
    "model_inferences": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/fact"}},
    "unknowns": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/unknown"}},
    "conflicts": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/conflict"}},
    "confidence_millionths": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "reason_codes": {"$ref": "#/$defs/reasons"},
    "evidence_refs": {"$ref": "#/$defs/ids"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 256},
    "ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "subject", "predicate", "typed_object", "confidence_millionths", "evidence_refs", "contradiction_group_id"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/id"},
        "subject": {"$ref": "#/$defs/id"},
        "predicate": {"$ref": "#/$defs/id"},
        "typed_object": {"type": ["null", "boolean", "integer", "string"]},
        "confidence_millionths": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "evidence_refs": {"$ref": "#/$defs/ids"},
        "contradiction_group_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_id", "requirement_id", "kind", "safe_summary", "evidence_refs"],
      "properties": {
        "unknown_id": {"$ref": "#/$defs/id"},
        "requirement_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["missing", "unavailable", "redacted", "stale", "ambiguous", "conflicting", "unsupported", "authority_unknown", "policy_unknown"]},
        "safe_summary": {"$ref": "#/$defs/text"},
        "evidence_refs": {"$ref": "#/$defs/ids"}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflict_id", "contradiction_group_id", "fact_ids", "safe_summary", "evidence_refs"],
      "properties": {
        "conflict_id": {"$ref": "#/$defs/id"},
        "contradiction_group_id": {"$ref": "#/$defs/id"},
        "fact_ids": {"type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "safe_summary": {"$ref": "#/$defs/text"},
        "evidence_refs": {"$ref": "#/$defs/ids"}
      }
    },
    "reasons": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"enum": ["ambiguous_objective", "authority_expansion", "conflicting_evidence", "conflicting_objective", "credential_requested", "insufficient_evidence", "invalid_output", "irreversible_requested", "missing_scope", "missing_success_criteria", "missing_value", "no_eligible_action", "policy_unknown", "prompt_injection", "provider_unavailable", "resource_limit", "stale_input", "unsupported_locale", "unsupported_operation"]}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "request.schema.json",
  "type": "object",
  "required": ["equipment_id", "symptom"],
  "properties": {
    "equipment_id": {
      "type": "string",
      "minLength": 1
    },
    "symptom": {
      "type": "string",
      "minLength": 1
    },
    "error_code": {
      "type": "string"
    },
    "sensor_snapshot": {
      "type": "object",
      "additionalProperties": true
    },
    "recent_maintenance": {
      "type": "string"
    }
  },
  "additionalProperties": false
}

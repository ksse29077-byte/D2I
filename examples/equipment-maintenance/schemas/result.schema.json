{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result.schema.json",
  "type": "object",
  "required": [
    "normalized_symptoms",
    "candidate_fault_codes",
    "recommended_check_sequence",
    "evidence",
    "confidence",
    "human_review"
  ],
  "properties": {
    "normalized_symptoms": {
      "type": "array",
      "items": { "type": "string" }
    },
    "candidate_fault_codes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_check_sequence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "span"],
        "properties": {
          "source": { "type": "string" },
          "span": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "human_review": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}

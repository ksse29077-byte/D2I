{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/modules/plan-ranker/input-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidates"],
  "properties": {
    "schema_version": { "const": 1 },
    "candidates": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "gate_status": {
      "enum": ["passed", "failed", "unknown"]
    },
    "gate_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "activation",
        "binding",
        "input_schema",
        "output_schema",
        "risk",
        "side_effect",
        "network",
        "credential",
        "capability",
        "quality"
      ],
      "properties": {
        "policy": { "$ref": "#/$defs/gate_status" },
        "activation": { "$ref": "#/$defs/gate_status" },
        "binding": { "$ref": "#/$defs/gate_status" },
        "input_schema": { "$ref": "#/$defs/gate_status" },
        "output_schema": { "$ref": "#/$defs/gate_status" },
        "risk": { "$ref": "#/$defs/gate_status" },
        "side_effect": { "$ref": "#/$defs/gate_status" },
        "network": { "$ref": "#/$defs/gate_status" },
        "credential": { "$ref": "#/$defs/gate_status" },
        "capability": { "$ref": "#/$defs/gate_status" },
        "quality": { "$ref": "#/$defs/gate_status" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_hash",
        "capability_id",
        "capability_version",
        "input_schema_id",
        "input_schema_version",
        "output_schema_id",
        "output_schema_version",
        "normalized_cost_millionths",
        "success_likelihood_millionths",
        "gate_results",
        "evidence_ids"
      ],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/id" },
        "candidate_hash": { "$ref": "#/$defs/hash" },
        "capability_id": { "$ref": "#/$defs/id" },
        "capability_version": { "$ref": "#/$defs/version" },
        "input_schema_id": { "$ref": "#/$defs/id" },
        "input_schema_version": { "type": "integer", "minimum": 1 },
        "output_schema_id": { "$ref": "#/$defs/id" },
        "output_schema_version": { "type": "integer", "minimum": 1 },
        "normalized_cost_millionths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "success_likelihood_millionths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "gate_results": { "$ref": "#/$defs/gate_results" },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2i.local/modules/plan-ranker/output-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ranking_policy_version",
    "outcome",
    "selected_candidate_id",
    "selected_candidate_hash",
    "ranked_candidates",
    "rejected_candidates"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "ranking_policy_version": { "const": 1 },
    "outcome": { "enum": ["ranked", "no_eligible_candidate"] },
    "selected_candidate_id": {
      "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
    },
    "selected_candidate_hash": {
      "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
    },
    "ranked_candidates": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/ranked_candidate" }
    },
    "rejected_candidates": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/rejected_candidate" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "ranked" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "selected_candidate_id": { "$ref": "#/$defs/id" },
          "selected_candidate_hash": { "$ref": "#/$defs/hash" },
          "ranked_candidates": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "no_eligible_candidate" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "selected_candidate_id": { "type": "null" },
          "selected_candidate_hash": { "type": "null" },
          "ranked_candidates": { "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "millionths": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "ranked_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "candidate_id",
        "candidate_hash",
        "normalized_cost_millionths",
        "success_likelihood_millionths"
      ],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 64 },
        "candidate_id": { "$ref": "#/$defs/id" },
        "candidate_hash": { "$ref": "#/$defs/hash" },
        "normalized_cost_millionths": { "$ref": "#/$defs/millionths" },
        "success_likelihood_millionths": { "$ref": "#/$defs/millionths" }
      }
    },
    "gate_rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "status"],
      "properties": {
        "gate": {
          "enum": [
            "policy",
            "activation",
            "binding",
            "input_schema",
            "output_schema",
            "risk",
            "side_effect",
            "network",
            "credential",
            "capability",
            "quality"
          ]
        },
        "status": { "enum": ["failed", "unknown"] }
      }
    },
    "rejected_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "candidate_hash", "reasons"],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/id" },
        "candidate_hash": { "$ref": "#/$defs/hash" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 11,
          "items": { "$ref": "#/$defs/gate_rejection" }
        }
      }
    }
  }
}
